{
  "sdkVersion": "0.0.59",
  "transport": "text/event-stream",
  "standardEventOrder": [
    "RUN_STARTED",
    "STATE_SNAPSHOT",
    "ACTIVITY_SNAPSHOT",
    "CUSTOM",
    "TOOL_CALL_START",
    "TOOL_CALL_ARGS",
    "TOOL_CALL_END",
    "TEXT_MESSAGE_START",
    "TEXT_MESSAGE_CONTENT",
    "TEXT_MESSAGE_END",
    "RUN_FINISHED"
  ],
  "customEvents": {
    "petra.work_unit.status": "1.0.0",
    "petra.review.interrupt": "1.0.0"
  },
  "authority": {
    "interactionStateIsAuthoritative": false,
    "connectionAbortCancelsWorkUnit": false,
    "commandsAreIdempotent": true
  }
}
