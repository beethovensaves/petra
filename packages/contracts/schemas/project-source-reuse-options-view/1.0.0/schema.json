{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-source-reuse-options-view/1.0.0/schema.json",
  "title": "PetraProjectSourceReuseOptionsView",
  "description": "An authenticated, server-composed selector for source copies the current human may reuse in one exact current ProjectDefinition. It exposes the exact existing-source refs required by the reuse command without exposing Actor, grant, target membership identity, storage location, or record timestamps.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "project_id",
    "expected",
    "profile",
    "source_roles",
    "availability",
    "counts",
    "candidates"
  ],
  "properties": {
    "schema_name": { "const": "petra.project-source-reuse-options-view" },
    "schema_version": { "const": "1.0.0" },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "expected": {
      "$ref": "../../project-source-registration-request/1.0.0/schema.json#/$defs/Expected"
    },
    "profile": { "$ref": "#/$defs/Profile" },
    "source_roles": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/SourceRole" }
    },
    "availability": { "$ref": "#/$defs/Availability" },
    "counts": { "$ref": "#/$defs/Counts" },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/Candidate" }
    }
  },
  "$defs": {
    "Profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution", "definition_family", "label", "purpose"],
      "properties": {
        "resolution": {
          "enum": ["registered", "project_authored", "unsupported"]
        },
        "definition_family": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{2,127}$"
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "SourceRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_key", "label", "meaning"],
      "properties": {
        "semantic_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._/-]{1,199}$"
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "meaning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "Availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason", "message"],
      "properties": {
        "state": { "enum": ["available", "empty", "unsupported"] },
        "reason": {
          "enum": [
            "permitted_sources_found",
            "no_permitted_sources",
            "all_permitted_sources_already_linked",
            "source_roles_unavailable",
            "profile_unsupported"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "available" } } },
          "then": {
            "properties": {
              "reason": { "const": "permitted_sources_found" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "empty" } } },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "no_permitted_sources",
                  "all_permitted_sources_already_linked"
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "unsupported" } } },
          "then": {
            "properties": {
              "reason": {
                "enum": ["source_roles_unavailable", "profile_unsupported"]
              }
            }
          }
        }
      ]
    },
    "Counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permitted", "already_linked"],
      "properties": {
        "permitted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "already_linked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "Candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display", "existing_source"],
      "properties": {
        "display": { "$ref": "#/$defs/CandidateDisplay" },
        "existing_source": {
          "$ref": "../../project-source-reuse-request/1.0.0/schema.json#/$defs/ExistingSource"
        }
      }
    },
    "CandidateDisplay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "contributors",
        "version_label",
        "publication_status",
        "origin_project_name",
        "origin_source_role",
        "origin_membership_status",
        "copy_status"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "contributors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 400 }
        },
        "version_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "publication_status": {
          "enum": [
            "preprint",
            "peer_reviewed",
            "accepted",
            "corrected",
            "retracted",
            "unknown"
          ]
        },
        "published_date": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/PublicationDate"
        },
        "origin_project_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "origin_source_role": { "$ref": "#/$defs/SourceRole" },
        "origin_membership_status": { "enum": ["active", "excluded"] },
        "copy_status": { "const": "available_for_reuse" }
      }
    }
  }
}
