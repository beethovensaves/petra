{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/registered-project-profile/1.0.0/schema.json",
  "title": "PetraRegisteredProjectProfile",
  "description": "An immutable registered profile version that may seed a Project-owned ProjectDefinition without becoming that Project's authority ledger.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "profile_id",
    "profile_version",
    "definition_family",
    "status",
    "content",
    "content_hash",
    "registered_at"
  ],
  "properties": {
    "schema_name": { "const": "petra.registered-project-profile" },
    "schema_version": { "const": "1.0.0" },
    "profile_id": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        { "type": "string", "pattern": "^project_template_" }
      ]
    },
    "profile_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "definition_family": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,127}$"
    },
    "status": { "const": "active" },
    "content": { "$ref": "#/$defs/ProfileContent" },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "registered_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "ProfileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "content_hash"],
      "properties": {
        "profile_id": {
          "allOf": [
            { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
            { "type": "string", "pattern": "^project_template_" }
          ]
        },
        "profile_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "RegisteredTaxonomyItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_key", "label", "meaning", "availability"],
      "properties": {
        "semantic_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._/-]{1,199}$"
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "meaning": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "availability": { "enum": ["available", "unavailable"] },
        "contract": {
          "$ref": "../../project-definition/1.0.0/schema.json#/$defs/NamedVersionHash"
        },
        "unavailable_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "TaxonomySection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "items"],
      "properties": {
        "state": {
          "enum": ["available", "partially_available", "unavailable"]
        },
        "items": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/RegisteredTaxonomyItem" }
        },
        "limitation": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "UnavailableOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "label", "reason"],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{2,127}$"
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "Taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_kinds",
        "relationship_meanings",
        "source_roles",
        "validators",
        "work_families",
        "model_roles",
        "review_destinations",
        "terminology",
        "supported_places",
        "unavailable_operations"
      ],
      "properties": {
        "object_kinds": { "$ref": "#/$defs/TaxonomySection" },
        "relationship_meanings": { "$ref": "#/$defs/TaxonomySection" },
        "source_roles": { "$ref": "#/$defs/TaxonomySection" },
        "validators": { "$ref": "#/$defs/TaxonomySection" },
        "work_families": { "$ref": "#/$defs/TaxonomySection" },
        "model_roles": { "$ref": "#/$defs/TaxonomySection" },
        "review_destinations": { "$ref": "#/$defs/TaxonomySection" },
        "terminology": {
          "type": "array",
          "minItems": 3,
          "maxItems": 1000,
          "items": {
            "$ref": "../../project-definition/1.0.0/schema.json#/$defs/Term"
          }
        },
        "supported_places": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "brief",
              "sources",
              "review",
              "graph",
              "work",
              "petra",
              "composition",
              "history",
              "settings",
              "profile_tool"
            ]
          }
        },
        "unavailable_operations": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/UnavailableOperation" }
        }
      }
    },
    "ProfileContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "purpose",
        "enabled_evidence_namespaces",
        "objective_kind",
        "definition",
        "taxonomy"
      ],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "enabled_evidence_namespaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "../../common/1.0.0/schema.json#/$defs/EvidenceNamespace"
          }
        },
        "objective_kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._/-]{1,199}$"
        },
        "definition": {
          "$ref": "../../project-definition/1.0.0/schema.json#/$defs/DefinitionContent"
        },
        "taxonomy": { "$ref": "#/$defs/Taxonomy" }
      }
    }
  }
}
