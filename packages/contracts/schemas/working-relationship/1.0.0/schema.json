{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/working-relationship/1.0.0/schema.json",
  "title": "PetraWorkingRelationship",
  "description": "An additive Project-scoped working revision that binds one exact profile-registered relationship record and its endpoints to the same non-authoritative producer, task, input, basis, provenance, qualification, validation, and supersession boundary as a WorkingCandidate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "working_relationship_id",
    "revision",
    "project_id",
    "project_definition_ref",
    "profile_relationship",
    "endpoints",
    "producer",
    "task_context",
    "input_snapshot",
    "origin",
    "basis",
    "provenance",
    "qualifications",
    "validation",
    "lineage",
    "disposition",
    "authority_boundary",
    "content_hash",
    "created_by",
    "created_at",
    "recorded_at"
  ],
  "properties": {
    "schema_name": { "const": "petra.working-relationship" },
    "schema_version": { "const": "1.0.0" },
    "working_relationship_id": { "$ref": "#/$defs/WorkingRelationshipId" },
    "revision": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
    },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "project_definition_ref": {
      "$ref": "../../working-candidate/1.0.0/schema.json#/$defs/ProjectDefinitionRef"
    },
    "profile_relationship": { "$ref": "#/$defs/ProfileRelationshipBinding" },
    "endpoints": { "$ref": "#/$defs/RelationshipEndpoints" },
    "producer": {
      "$ref": "../../working-candidate/1.0.0/schema.json#/$defs/Producer"
    },
    "task_context": {
      "$ref": "../../working-candidate/1.0.0/schema.json#/$defs/TaskContext"
    },
    "input_snapshot": {
      "$ref": "../../working-candidate/1.0.0/schema.json#/$defs/InputSnapshot"
    },
    "origin": {
      "$ref": "../../working-candidate/1.0.0/schema.json#/$defs/Origin"
    },
    "basis": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "../../working-candidate/1.0.0/schema.json#/$defs/BasisItem"
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "../../working-candidate/1.0.0/schema.json#/$defs/ProvenanceItem"
      }
    },
    "qualifications": {
      "$ref": "../../working-candidate/1.0.0/schema.json#/$defs/Qualifications"
    },
    "validation": {
      "$ref": "../../working-candidate/1.0.0/schema.json#/$defs/Validation"
    },
    "lineage": { "$ref": "#/$defs/RelationshipLineage" },
    "disposition": { "enum": ["available", "withdrawn"] },
    "authority_boundary": {
      "$ref": "../../working-candidate/1.0.0/schema.json#/$defs/AuthorityBoundary"
    },
    "content_hash": {
      "description": "The RFC 8785 SHA-256 identity of this working revision with the content_hash member omitted.",
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "created_by": {
      "$ref": "../../working-candidate/1.0.0/schema.json#/$defs/ActorRef"
    },
    "created_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    },
    "recorded_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "revision": { "const": 1 } },
        "required": ["revision"]
      },
      "then": {
        "properties": { "lineage": { "$ref": "#/$defs/RootLineage" } }
      },
      "else": {
        "properties": {
          "lineage": { "$ref": "#/$defs/SupersessionLineage" }
        }
      }
    }
  ],
  "$defs": {
    "WorkingRelationshipId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        {
          "type": "string",
          "pattern": "^working_relationship_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      ]
    },
    "WorkingRelationshipRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["working_relationship_id", "revision", "content_hash"],
      "properties": {
        "working_relationship_id": {
          "$ref": "#/$defs/WorkingRelationshipId"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "ProfileRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registration_kind", "semantic_key", "contract"],
      "properties": {
        "registration_kind": { "const": "relationship_schema" },
        "semantic_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._/-]{1,199}$"
        },
        "contract": {
          "$ref": "../../working-candidate/1.0.0/schema.json#/$defs/NamedVersionHash"
        }
      }
    },
    "ProfileRelationshipBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registration",
        "predicate",
        "relationship_record_ref",
        "candidate_operation"
      ],
      "properties": {
        "registration": { "$ref": "#/$defs/ProfileRegistration" },
        "predicate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,199}$"
        },
        "relationship_record_ref": {
          "$ref": "../../working-candidate/1.0.0/schema.json#/$defs/ExactTypedRecordRef"
        },
        "candidate_operation": { "enum": ["create", "revise"] },
        "current_authoritative_ref": {
          "$ref": "../../working-candidate/1.0.0/schema.json#/$defs/ExactTypedRecordRef"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "candidate_operation": { "const": "revise" } },
            "required": ["candidate_operation"]
          },
          "then": {
            "properties": {
              "current_authoritative_ref": {
                "$ref": "../../working-candidate/1.0.0/schema.json#/$defs/ExactTypedRecordRef"
              }
            },
            "required": ["current_authoritative_ref"]
          },
          "else": { "properties": { "current_authoritative_ref": false } }
        }
      ]
    },
    "ProfileRecordEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint_kind", "record_ref"],
      "properties": {
        "endpoint_kind": { "const": "profile_record" },
        "record_ref": {
          "$ref": "../../working-candidate/1.0.0/schema.json#/$defs/ExactTypedRecordRef"
        }
      }
    },
    "WorkingCandidateEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint_kind", "candidate_ref"],
      "properties": {
        "endpoint_kind": { "const": "working_candidate" },
        "candidate_ref": {
          "$ref": "../../working-candidate/1.0.0/schema.json#/$defs/WorkingCandidateRef"
        }
      }
    },
    "LiteralEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint_kind", "literal_type", "value_hash"],
      "properties": {
        "endpoint_kind": { "const": "literal" },
        "literal_type": {
          "enum": ["string", "boolean", "integer", "decimal", "timestamp"]
        },
        "value_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "Endpoint": {
      "oneOf": [
        { "$ref": "#/$defs/ProfileRecordEndpoint" },
        { "$ref": "#/$defs/WorkingCandidateEndpoint" },
        { "$ref": "#/$defs/LiteralEndpoint" }
      ]
    },
    "RelationshipEndpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "object"],
      "properties": {
        "subject": { "$ref": "#/$defs/Endpoint" },
        "object": { "$ref": "#/$defs/Endpoint" }
      }
    },
    "RootLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineage_kind"],
      "properties": { "lineage_kind": { "const": "root" } }
    },
    "SupersessionLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineage_kind", "supersedes", "change_kind", "reason"],
      "properties": {
        "lineage_kind": { "const": "supersession" },
        "supersedes": { "$ref": "#/$defs/WorkingRelationshipRef" },
        "change_kind": {
          "enum": [
            "mechanical_correction",
            "basis_revision",
            "material_revision",
            "withdrawal"
          ]
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "RelationshipLineage": {
      "oneOf": [
        { "$ref": "#/$defs/RootLineage" },
        { "$ref": "#/$defs/SupersessionLineage" }
      ]
    }
  }
}
