{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-objective/1.0.0/schema.json",
  "title": "PetraProjectObjective",
  "description": "A versioned Project objective interpreted under one exact ProjectDefinition revision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "objective_id",
    "revision",
    "project_id",
    "project_definition_ref",
    "content",
    "content_hash",
    "created_by",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_name": { "const": "petra.project-objective" },
    "schema_version": { "const": "1.0.0" },
    "objective_id": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        { "type": "string", "pattern": "^objective_" }
      ]
    },
    "revision": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
    },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "project_definition_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_definition_id", "revision", "content_hash"],
      "properties": {
        "project_definition_id": {
          "allOf": [
            { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
            { "type": "string", "pattern": "^project_definition_" }
          ]
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "content": { "$ref": "#/$defs/ObjectiveContent" },
    "content_hash": {
      "description": "The RFC 8785 SHA-256 identity of content.",
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "created_by": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ActorRef"
    },
    "created_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    },
    "updated_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "ObjectiveContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective_kind", "statement", "status", "dependency_refs"],
      "properties": {
        "objective_kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._/-]{1,199}$"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "status": {
          "enum": ["active", "satisfied", "superseded", "abandoned"]
        },
        "parent_ref": { "$ref": "#/$defs/ObjectiveRef" },
        "dependency_refs": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/ObjectiveRef" }
        }
      }
    },
    "ObjectiveRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective_id", "revision", "content_hash"],
      "properties": {
        "objective_id": {
          "allOf": [
            { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
            { "type": "string", "pattern": "^objective_" }
          ]
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    }
  }
}
