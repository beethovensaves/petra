{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-examination-authority-receipt/1.0.0/schema.json",
  "title": "PetraProjectExaminationAuthorityReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "project_id",
    "project_examination_authority_receipt_id",
    "revision",
    "content",
    "content_hash"
  ],
  "properties": {
    "schema_name": {
      "const": "petra.project-examination-authority-receipt"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "project_examination_authority_receipt_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
    },
    "revision": {
      "const": 1
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "idempotency_key",
        "request_hash",
        "graph_content_hash",
        "actor",
        "grant",
        "review",
        "recorded_at",
        "authority_effect",
        "projection_effect"
      ],
      "properties": {
        "command_id": {
          "$ref": "../../command-envelope/1.0.0/schema.json#/$defs/CommandId"
        },
        "idempotency_key": {
          "$ref": "../../command-envelope/1.0.0/schema.json#/$defs/IdempotencyKey"
        },
        "request_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "graph_content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "actor": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ActorRef"
        },
        "grant": {
          "$ref": "../../capability-grant/1.16.0/schema.json"
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "proposed_content_hash",
            "rationale",
            "reviewed_at"
          ],
          "properties": {
            "proposed_content_hash": {
              "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
            },
            "rationale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "reviewed_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "authority_effect": {
          "const": "owner_examination_grant"
        },
        "projection_effect": {
          "const": "none"
        }
      }
    },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    }
  }
}
