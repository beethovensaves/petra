{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-source-processing-receipt/1.0.0/schema.json",
  "title": "PetraProjectSourceProcessingReceipt",
  "description": "The durable idempotent outcome of creating and starting one exact ProjectSource processing WorkUnit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "receipt_id",
    "command_id",
    "idempotency_key",
    "request_hash",
    "project_id",
    "actor",
    "capability_grant_id",
    "expected",
    "work_unit_ref",
    "input_manifest_ref",
    "effect",
    "destination",
    "recovery",
    "recorded_at",
    "record_hash"
  ],
  "properties": {
    "schema_name": { "const": "petra.project-source-processing-receipt" },
    "schema_version": { "const": "1.0.0" },
    "receipt_id": {
      "type": "string",
      "pattern": "^source_processing_receipt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "command_id": {
      "$ref": "../../project-source-processing-request/1.0.0/schema.json#/properties/command_id"
    },
    "idempotency_key": {
      "$ref": "../../project-source-processing-request/1.0.0/schema.json#/properties/idempotency_key"
    },
    "request_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "actor": {
      "$ref": "../../capability-grant/1.0.0/schema.json#/$defs/HumanActorRef"
    },
    "capability_grant_id": {
      "type": "string",
      "pattern": "^capability_grant_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "expected": {
      "$ref": "../../project-source-processing-request/1.0.0/schema.json#/$defs/Expected"
    },
    "work_unit_ref": { "$ref": "#/$defs/WorkUnitRef" },
    "input_manifest_ref": { "$ref": "#/$defs/InputManifestRef" },
    "effect": { "$ref": "#/$defs/Effect" },
    "destination": { "$ref": "#/$defs/Destination" },
    "recovery": { "$ref": "#/$defs/Recovery" },
    "recorded_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    },
    "record_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    }
  },
  "$defs": {
    "WorkUnitRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_unit_id",
        "revision",
        "spec_hash",
        "record_hash",
        "state"
      ],
      "properties": {
        "work_unit_id": {
          "$ref": "../../worker-input-manifest/1.0.0/schema.json#/$defs/WorkUnitId"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "spec_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "state": { "enum": ["requested", "queued", "running"] }
      }
    },
    "InputManifestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_input_manifest_id", "content_hash", "record_hash"],
      "properties": {
        "worker_input_manifest_id": {
          "$ref": "../../worker-input-manifest/1.0.0/schema.json#/$defs/WorkerInputManifestId"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "Effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "summary",
        "bounded_to_exact_source_copy",
        "meaning_authority_unchanged"
      ],
      "properties": {
        "kind": { "const": "source_processing_work_started" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "bounded_to_exact_source_copy": { "const": true },
        "meaning_authority_unchanged": { "const": true }
      }
    },
    "Destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "place_role",
        "project_id",
        "project_source_id",
        "work_unit_id"
      ],
      "properties": {
        "place_role": { "const": "sources" },
        "project_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
        },
        "project_source_id": {
          "type": "string",
          "pattern": "^project_source_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "work_unit_id": {
          "$ref": "../../worker-input-manifest/1.0.0/schema.json#/$defs/WorkUnitId"
        }
      }
    },
    "Recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_path",
        "assessment_path",
        "processing_path",
        "retry_reuses_command_identity",
        "missing_receipt_means_unknown"
      ],
      "properties": {
        "command_path": {
          "type": "string",
          "pattern": "^/api/commands/projects/[^/]+/sources/[^/]+/processing$"
        },
        "assessment_path": {
          "type": "string",
          "pattern": "^/api/queries/projects/[^/]+/sources/[^/]+/processing-recovery$"
        },
        "processing_path": {
          "type": "string",
          "pattern": "^/api/queries/projects/[^/]+/sources/[^/]+/processing$"
        },
        "retry_reuses_command_identity": { "const": true },
        "missing_receipt_means_unknown": { "const": true }
      }
    }
  }
}
