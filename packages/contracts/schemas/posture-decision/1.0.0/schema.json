{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/posture-decision/1.0.0/schema.json",
  "title": "PetraPostureDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "posture_decision_id",
    "revision",
    "project_id",
    "content",
    "content_hash",
    "created_by",
    "created_at"
  ],
  "properties": {
    "schema_name": {
      "const": "petra.posture-decision"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "posture_decision_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
    },
    "revision": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
    },
    "project_id": {
      "type": "string",
      "pattern": "^project_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_ref",
        "primary_posture",
        "profile_ref",
        "policy_ref",
        "determining_finding_keys",
        "material_unknowns",
        "state",
        "obligations",
        "suggested_work",
        "expires_at",
        "human_override_reason"
      ],
      "properties": {
        "assessment_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_name",
            "schema_version",
            "record_id",
            "revision",
            "record_hash"
          ],
          "properties": {
            "schema_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "schema_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            },
            "record_id": {
              "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
            },
            "revision": {
              "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
            },
            "record_hash": {
              "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
            }
          }
        },
        "primary_posture": {
          "type": "string",
          "enum": [
            "explore",
            "clarify",
            "challenge",
            "discriminate",
            "reproduce",
            "consolidate"
          ]
        },
        "profile_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_name",
            "schema_version",
            "record_id",
            "revision",
            "record_hash"
          ],
          "properties": {
            "schema_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "schema_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            },
            "record_id": {
              "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
            },
            "revision": {
              "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
            },
            "record_hash": {
              "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
            }
          }
        },
        "policy_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_name",
            "schema_version",
            "record_id",
            "revision",
            "record_hash"
          ],
          "properties": {
            "schema_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "schema_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            },
            "record_id": {
              "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
            },
            "revision": {
              "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
            },
            "record_hash": {
              "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
            }
          }
        },
        "determining_finding_keys": {
          "type": "array",
          "minItems": 0,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "material_unknowns": {
          "type": "array",
          "minItems": 0,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "state": {
          "type": "string",
          "enum": ["proposed", "active"]
        },
        "obligations": {
          "type": "array",
          "minItems": 0,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "obligation_id",
              "revision",
              "type_key",
              "creating_finding_key",
              "rationale",
              "enforcement",
              "criterion_keys",
              "state",
              "satisfaction_evidence_refs",
              "waiver_ref",
              "work_refs"
            ],
            "properties": {
              "obligation_id": {
                "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
              },
              "revision": {
                "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
              },
              "type_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "creating_finding_key": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "enforcement": {
                "type": "string",
                "enum": [
                  "advisory",
                  "required_for_transition",
                  "required_for_action"
                ]
              },
              "criterion_keys": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "state": {
                "type": "string",
                "enum": [
                  "open",
                  "in_progress",
                  "satisfied",
                  "waived",
                  "not_applicable",
                  "superseded",
                  "expired"
                ]
              },
              "satisfaction_evidence_refs": {
                "type": "array",
                "minItems": 0,
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "schema_name",
                    "schema_version",
                    "record_id",
                    "revision",
                    "record_hash"
                  ],
                  "properties": {
                    "schema_name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "schema_version": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 30
                    },
                    "record_id": {
                      "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
                    },
                    "revision": {
                      "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
                    },
                    "record_hash": {
                      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
                    }
                  }
                }
              },
              "waiver_ref": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "schema_name",
                      "schema_version",
                      "record_id",
                      "revision",
                      "record_hash"
                    ],
                    "properties": {
                      "schema_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "schema_version": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 30
                      },
                      "record_id": {
                        "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
                      },
                      "revision": {
                        "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
                      },
                      "record_hash": {
                        "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "work_refs": {
                "type": "array",
                "minItems": 0,
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "schema_name",
                    "schema_version",
                    "record_id",
                    "revision",
                    "record_hash"
                  ],
                  "properties": {
                    "schema_name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "schema_version": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 30
                    },
                    "record_id": {
                      "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
                    },
                    "revision": {
                      "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
                    },
                    "record_hash": {
                      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
                    }
                  }
                }
              }
            }
          }
        },
        "suggested_work": {
          "type": "array",
          "minItems": 0,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "rationale",
              "creating_finding_key",
              "obligation_id",
              "destination"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "creating_finding_key": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "obligation_id": {
                "oneOf": [
                  {
                    "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "destination": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        },
        "expires_at": {
          "oneOf": [
            {
              "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "human_override_reason": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "created_by": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ActorRef"
    },
    "created_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  }
}
