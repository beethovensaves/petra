{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-history-retained-view/1.0.0/schema.json",
  "title": "PetraProjectHistoryRetainedView",
  "description": "An authorized, cursor-paged traversal of retained Project events in newest-first Project-stream order. Event membership is fixed to one immutable snapshot while recovery is evaluated against current authority at each page read. It is not a second ledger.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "project_id",
    "content",
    "content_hash",
    "read_at"
  ],
  "properties": {
    "schema_name": { "const": "petra.project-history-retained-view" },
    "schema_version": { "const": "1.0.0" },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "content": { "$ref": "#/$defs/RetainedContent" },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "read_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "OpaqueCursor": {
      "type": "string",
      "minLength": 80,
      "maxLength": 1024,
      "pattern": "^phc1\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{43}$"
    },
    "EventRef": {
      "$ref": "../../project-history-view/1.0.0/schema.json#/$defs/EventRef"
    },
    "AuthorityPosition": {
      "$ref": "../../project-history-view/1.0.0/schema.json#/$defs/AuthorityPosition"
    },
    "CollectionQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit"],
      "properties": {
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "cursor": { "$ref": "#/$defs/OpaqueCursor" }
      }
    },
    "RetentionSnapshot": {
      "oneOf": [
        { "$ref": "#/$defs/EmptyRetentionSnapshot" },
        { "$ref": "#/$defs/NonemptyRetentionSnapshot" }
      ]
    },
    "EmptyRetentionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["through_event_position", "through_stream_revision"],
      "properties": {
        "through_event_position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "through_stream_revision": {
          "const": 0
        }
      }
    },
    "NonemptyRetentionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "through_event_position",
        "through_stream_revision",
        "head_event_ref"
      ],
      "properties": {
        "through_event_position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "through_stream_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "head_event_ref": { "$ref": "#/$defs/EventRef" }
      }
    },
    "Page": {
      "oneOf": [
        { "$ref": "#/$defs/ContinuedPage" },
        { "$ref": "#/$defs/CompletePage" }
      ]
    },
    "ContinuedPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "returned_count",
        "snapshot_total_count",
        "has_more",
        "next_cursor"
      ],
      "properties": {
        "returned_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "snapshot_total_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "has_more": { "const": true },
        "next_cursor": { "$ref": "#/$defs/OpaqueCursor" }
      }
    },
    "CompletePage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["returned_count", "snapshot_total_count", "has_more"],
      "properties": {
        "returned_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "snapshot_total_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "has_more": { "const": false }
      }
    },
    "RetainedContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_kind",
        "order_kind",
        "query",
        "changes",
        "page",
        "retention_snapshot",
        "current_authority",
        "recovery_authority",
        "omissions",
        "graph_navigation_history"
      ],
      "properties": {
        "view_kind": { "const": "retained_events" },
        "order_kind": { "const": "project_stream_newest_first" },
        "query": { "$ref": "#/$defs/CollectionQuery" },
        "changes": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "../../project-history-view/1.0.0/schema.json#/$defs/RecentChange"
          }
        },
        "page": { "$ref": "#/$defs/Page" },
        "retention_snapshot": { "$ref": "#/$defs/RetentionSnapshot" },
        "current_authority": { "$ref": "#/$defs/AuthorityPosition" },
        "recovery_authority": { "const": "current_at_page_read" },
        "omissions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "filters_not_supported",
              "dependency_impact_not_composed",
              "generic_reversal_assessment_not_composed",
              "historical_project_definition_not_interpreted",
              "cross_family_total_order_not_asserted"
            ]
          },
          "allOf": [
            {
              "contains": { "const": "filters_not_supported" },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": { "const": "dependency_impact_not_composed" },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "const": "generic_reversal_assessment_not_composed"
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "const": "historical_project_definition_not_interpreted"
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "const": "cross_family_total_order_not_asserted"
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "graph_navigation_history": { "const": "client_local_separate" }
      }
    }
  }
}
