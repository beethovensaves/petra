{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-model-readiness-view/1.0.0/schema.json",
  "title": "PetraProjectModelReadinessView",
  "description": "A Project-scoped view of one server-selected certified model role, live provider status, exact model context, and the only registered interaction command that may consume it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "project_id",
    "project_revision",
    "project_definition_ref",
    "readiness",
    "limitations",
    "read_at"
  ],
  "properties": {
    "schema_name": { "const": "petra.project-model-readiness-view" },
    "schema_version": { "const": "1.0.0" },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "project_revision": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
    },
    "project_definition_ref": { "$ref": "#/$defs/DefinitionRef" },
    "objective_ref": { "$ref": "#/$defs/ObjectiveRef" },
    "readiness": {
      "oneOf": [{ "$ref": "#/$defs/Ready" }, { "$ref": "#/$defs/Unavailable" }]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "read_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "DefinitionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_definition_id",
        "revision",
        "content_hash",
        "record_hash",
        "definition_family"
      ],
      "properties": {
        "project_definition_id": {
          "allOf": [
            { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
            { "type": "string", "pattern": "^project_definition_" }
          ]
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "definition_family": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{2,127}$"
        }
      }
    },
    "ObjectiveRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective_id", "revision", "content_hash", "record_hash"],
      "properties": {
        "objective_id": {
          "allOf": [
            { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
            { "type": "string", "pattern": "^objective_" }
          ]
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "RecordRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "revision", "content_hash"],
      "properties": {
        "record_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "SnapshotRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "snapshot_revision",
        "event_position",
        "content_hash"
      ],
      "properties": {
        "snapshot_id": {
          "allOf": [
            { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
            { "type": "string", "pattern": "^snapshot_" }
          ]
        },
        "snapshot_revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "event_position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "CertificationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_certification_id", "revision", "content_hash"],
      "properties": {
        "role_certification_id": {
          "allOf": [
            { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
            { "type": "string", "pattern": "^role_certification_" }
          ]
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "SelectedRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "semantic_key",
        "label",
        "meaning",
        "certification_ref",
        "deployment",
        "authority_effect"
      ],
      "properties": {
        "state": { "const": "selected" },
        "semantic_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._/-]{1,199}$"
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "meaning": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "certification_ref": { "$ref": "#/$defs/CertificationRef" },
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_deployment_id",
            "provider_kind",
            "provider_model",
            "execution_location"
          ],
          "properties": {
            "model_deployment_id": {
              "allOf": [
                { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
                { "type": "string", "pattern": "^model_deployment_" }
              ]
            },
            "provider_kind": { "const": "codex_app_server" },
            "provider_model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "execution_location": { "const": "remote" }
          }
        },
        "authority_effect": { "const": "none" }
      }
    },
    "UnavailableRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason", "message"],
      "properties": {
        "state": { "const": "unavailable" },
        "reason": {
          "enum": [
            "profile_unsupported",
            "role_not_registered",
            "runtime_not_configured",
            "role_binding_mismatch"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "ReadyProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "provider_kind",
        "auth_state",
        "auth_mode",
        "model",
        "message"
      ],
      "properties": {
        "state": { "const": "ready" },
        "provider_kind": { "const": "codex_app_server" },
        "auth_state": { "const": "authenticated" },
        "auth_mode": { "const": "chatgpt" },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "UnavailableProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "provider_kind", "message"],
      "properties": {
        "state": {
          "enum": [
            "unavailable",
            "login_required",
            "model_unavailable",
            "configuration_drift"
          ]
        },
        "provider_kind": { "const": "codex_app_server" },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "ContextBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "project_revision",
        "project_definition_ref",
        "objective_ref",
        "snapshot_ref",
        "context_packet_ref",
        "evidence_packet_ref",
        "role_certification_ref"
      ],
      "properties": {
        "project_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
        },
        "project_revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "project_definition_ref": { "$ref": "#/$defs/DefinitionRef" },
        "objective_ref": { "$ref": "#/$defs/ObjectiveRef" },
        "snapshot_ref": { "$ref": "#/$defs/SnapshotRef" },
        "context_packet_ref": { "$ref": "#/$defs/RecordRef" },
        "evidence_packet_ref": { "$ref": "#/$defs/RecordRef" },
        "role_certification_ref": { "$ref": "#/$defs/CertificationRef" }
      }
    },
    "BoundContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "binding"],
      "properties": {
        "state": { "const": "bound" },
        "binding": { "$ref": "#/$defs/ContextBinding" }
      }
    },
    "UnavailableContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason", "message"],
      "properties": {
        "state": { "const": "unavailable" },
        "reason": {
          "enum": [
            "objective_unavailable",
            "project_context_not_compiled",
            "project_context_stale",
            "profile_context_unsupported"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "ReadyCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "method",
        "endpoint",
        "workflow",
        "prompt_policy",
        "registered_prompt",
        "request_context",
        "delivery",
        "authority_effect"
      ],
      "properties": {
        "state": { "const": "ready" },
        "method": { "const": "POST" },
        "endpoint": { "const": "/api/interactions/run" },
        "workflow": { "const": "grounded_synthesis" },
        "prompt_policy": { "const": "exact_registered_prompt" },
        "registered_prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "request_context": { "$ref": "#/$defs/ContextBinding" },
        "delivery": { "const": "streaming_and_replay" },
        "authority_effect": { "const": "none" }
      }
    },
    "UnavailableCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason", "message"],
      "properties": {
        "state": { "const": "unavailable" },
        "reason": {
          "enum": [
            "role_unavailable",
            "provider_unavailable",
            "context_unavailable"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "Ready": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "role", "provider", "context", "command"],
      "properties": {
        "state": { "const": "ready" },
        "role": { "$ref": "#/$defs/SelectedRole" },
        "provider": { "$ref": "#/$defs/ReadyProvider" },
        "context": { "$ref": "#/$defs/BoundContext" },
        "command": { "$ref": "#/$defs/ReadyCommand" }
      }
    },
    "Unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason", "role", "provider", "context", "command"],
      "properties": {
        "state": { "const": "unavailable" },
        "reason": {
          "enum": [
            "role_unavailable",
            "provider_unavailable",
            "context_unavailable"
          ]
        },
        "role": {
          "oneOf": [
            { "$ref": "#/$defs/SelectedRole" },
            { "$ref": "#/$defs/UnavailableRole" }
          ]
        },
        "provider": {
          "oneOf": [
            { "$ref": "#/$defs/ReadyProvider" },
            { "$ref": "#/$defs/UnavailableProvider" }
          ]
        },
        "context": {
          "oneOf": [
            { "$ref": "#/$defs/BoundContext" },
            { "$ref": "#/$defs/UnavailableContext" }
          ]
        },
        "command": { "$ref": "#/$defs/UnavailableCommand" }
      }
    }
  }
}
