{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-history-recovery-assessment-view/1.0.0/schema.json",
  "title": "PetraProjectHistoryRecoveryAssessmentView",
  "description": "A snapshot-consistent, read-only assessment of whether one exact applied scientific-authority ChangeSet can proceed to a separately requested compensation preview, or has been blocked or already compensated. It does not compose or execute compensation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "project_id",
    "event_id",
    "content",
    "content_hash",
    "read_at"
  ],
  "properties": {
    "schema_name": {
      "const": "petra.project-history-recovery-assessment-view"
    },
    "schema_version": { "const": "1.0.0" },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "event_id": {
      "$ref": "../../domain-event/1.0.0/schema.json#/$defs/EventId"
    },
    "content": { "$ref": "#/$defs/RecoveryAssessmentContent" },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "read_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "ChangeSetAuthorityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_set_id",
        "revision",
        "schema_version",
        "content_hash",
        "record_hash",
        "current_state"
      ],
      "properties": {
        "change_set_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ChangeSetId"
        },
        "revision": { "const": 1 },
        "schema_version": { "enum": ["1.0.0", "1.1.0"] },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "current_state": {
          "enum": [
            "submitted",
            "approved",
            "rejected",
            "applied",
            "conflicted",
            "reverted"
          ]
        }
      }
    },
    "ApprovalAuthorityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "revision",
        "change_set_id",
        "change_set_revision",
        "change_set_content_hash",
        "decision",
        "record_hash"
      ],
      "properties": {
        "approval_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ApprovalId"
        },
        "revision": { "const": 1 },
        "change_set_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ChangeSetId"
        },
        "change_set_revision": { "const": 1 },
        "change_set_content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "decision": { "const": "approved" },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "EvidenceAuthorityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_key",
        "object_id",
        "revision",
        "schema_name",
        "schema_version",
        "record_hash",
        "authority_zone",
        "review_state",
        "admission_kind"
      ],
      "properties": {
        "semantic_key": {
          "enum": ["scientific.claim", "scientific.assertion"]
        },
        "object_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "schema_name": { "enum": ["petra.claim", "petra.assertion"] },
        "schema_version": { "const": "1.0.0" },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "authority_zone": { "enum": ["quarantine", "trusted"] },
        "review_state": {
          "enum": [
            "unreviewed",
            "machine_checked",
            "human_accepted",
            "human_rejected",
            "disputed"
          ]
        },
        "admission_kind": { "enum": ["proposal", "promotion", "reversal"] },
        "promotion_change_set_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ChangeSetId"
        }
      }
    },
    "GrantAuthorityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_grant_id",
        "revision",
        "content_hash",
        "record_hash"
      ],
      "properties": {
        "capability_grant_id": {
          "type": "string",
          "pattern": "^capability_grant_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "revision": { "const": 1 },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "GrantedCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_name", "state", "grant_ref"],
      "properties": {
        "command_name": {
          "enum": ["SubmitChangeSet", "RecordApproval", "ApplyChangeSet"]
        },
        "state": { "const": "granted" },
        "grant_ref": { "$ref": "#/$defs/GrantAuthorityRef" }
      }
    },
    "DeniedCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_name", "state", "reason"],
      "properties": {
        "command_name": {
          "enum": ["SubmitChangeSet", "RecordApproval", "ApplyChangeSet"]
        },
        "state": { "const": "denied" },
        "reason": {
          "enum": [
            "principal_not_configured",
            "actor_not_registered",
            "active_grant_not_found",
            "active_grant_ambiguous"
          ]
        }
      }
    },
    "CommandAuthorityCheck": {
      "oneOf": [
        { "$ref": "#/$defs/GrantedCommand" },
        { "$ref": "#/$defs/DeniedCommand" }
      ]
    },
    "CommandAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_source",
        "principal_state",
        "required_commands",
        "execution_recheck"
      ],
      "properties": {
        "principal_source": { "const": "server_authenticated_single_user" },
        "principal_state": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "actor"],
              "properties": {
                "state": { "const": "configured" },
                "actor": {
                  "$ref": "../../common/1.0.0/schema.json#/$defs/ActorRef"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "reason"],
              "properties": {
                "state": { "const": "unavailable" },
                "reason": {
                  "enum": ["principal_not_configured", "actor_not_registered"]
                }
              }
            }
          ]
        },
        "required_commands": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/CommandAuthorityCheck" },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "command_name": { "const": "SubmitChangeSet" }
                },
                "required": ["command_name"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": { "command_name": { "const": "RecordApproval" } },
                "required": ["command_name"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": { "command_name": { "const": "ApplyChangeSet" } },
                "required": ["command_name"]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "execution_recheck": { "const": "required_at_each_command" }
      }
    },
    "RecoverySubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_event_role",
        "promotion_change_set",
        "applied_approval",
        "current_targets"
      ],
      "properties": {
        "selected_event_role": { "enum": ["promotion", "compensation"] },
        "promotion_change_set": { "$ref": "#/$defs/ChangeSetAuthorityRef" },
        "applied_approval": { "$ref": "#/$defs/ApprovalAuthorityRef" },
        "current_targets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/EvidenceAuthorityRef" },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "semantic_key": { "const": "scientific.claim" },
                  "schema_name": { "const": "petra.claim" }
                },
                "required": ["semantic_key", "schema_name"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "semantic_key": { "const": "scientific.assertion" },
                  "schema_name": { "const": "petra.assertion" }
                },
                "required": ["semantic_key", "schema_name"]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        }
      }
    },
    "AssessmentBlocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": {
        "code": {
          "enum": [
            "selected_change_set_is_compensation",
            "change_set_not_applied",
            "change_set_operation_set_invalid",
            "target_revision_changed",
            "target_authority_changed",
            "target_pair_mismatch",
            "impact_target_set_mismatch",
            "command_authority_missing",
            "command_authority_ambiguous"
          ]
        },
        "detail": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "EligibleAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "scope", "reason", "blockers"],
      "properties": {
        "state": { "const": "eligible_for_preview" },
        "scope": { "const": "single_change_set_compensation" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "blockers": { "type": "array", "maxItems": 0 }
      }
    },
    "BlockedAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "scope", "reason", "blockers"],
      "properties": {
        "state": { "const": "blocked" },
        "scope": { "const": "single_change_set_compensation" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "blockers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/AssessmentBlocker" }
        }
      }
    },
    "AlreadyCompensatedAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "scope",
        "reason",
        "blockers",
        "compensation_change_set",
        "compensation_approval",
        "compensation_event_ref"
      ],
      "properties": {
        "state": { "const": "already_compensated" },
        "scope": { "const": "single_change_set_compensation" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "blockers": { "type": "array", "maxItems": 0 },
        "compensation_change_set": { "$ref": "#/$defs/ChangeSetAuthorityRef" },
        "compensation_approval": { "$ref": "#/$defs/ApprovalAuthorityRef" },
        "compensation_event_ref": {
          "$ref": "../../project-history-view/1.0.0/schema.json#/$defs/EventRef"
        }
      }
    },
    "Assessment": {
      "oneOf": [
        { "$ref": "#/$defs/EligibleAssessment" },
        { "$ref": "#/$defs/BlockedAssessment" },
        { "$ref": "#/$defs/AlreadyCompensatedAssessment" }
      ]
    },
    "CausalImpactBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_event_id",
        "direct_dependency_summary",
        "semantic_dependency_summary",
        "dependent_effect",
        "unknowns"
      ],
      "properties": {
        "source_event_id": {
          "$ref": "../../domain-event/1.0.0/schema.json#/$defs/EventId"
        },
        "direct_dependency_summary": {
          "$ref": "../../project-history-impact-view/1.0.0/schema.json#/$defs/ImpactSummary"
        },
        "semantic_dependency_summary": {
          "$ref": "../../project-history-impact-view/1.2.0/schema.json#/$defs/SemanticSummary"
        },
        "dependent_effect": { "const": "not_inferred_from_reference" },
        "unknowns": {
          "const": [
            "unregistered_profile_specific_dependencies_may_exist",
            "transitive_dependents_may_exist",
            "external_system_dependents_are_not_observable"
          ]
        }
      }
    },
    "DecisionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reversibility",
        "compensation_preview",
        "compensation_execution",
        "multi_step_compensation"
      ],
      "properties": {
        "reversibility": { "const": "assessed_for_exact_change_set" },
        "compensation_preview": { "const": "not_composed" },
        "compensation_execution": { "const": "not_performed" },
        "multi_step_compensation": { "const": "not_assessed" }
      }
    },
    "RecoveryAssessmentContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_kind",
        "authorization_scope",
        "selected_event",
        "recovery_subject",
        "command_authority",
        "causal_impact_basis",
        "assessment",
        "decision_boundary",
        "authority",
        "omissions",
        "graph_navigation_history"
      ],
      "properties": {
        "view_kind": { "const": "change_set_recovery_assessment" },
        "authorization_scope": { "const": "authenticated_project" },
        "selected_event": {
          "$ref": "../../project-history-view/1.0.0/schema.json#/$defs/RecentChange"
        },
        "recovery_subject": { "$ref": "#/$defs/RecoverySubject" },
        "command_authority": { "$ref": "#/$defs/CommandAuthority" },
        "causal_impact_basis": { "$ref": "#/$defs/CausalImpactBasis" },
        "assessment": { "$ref": "#/$defs/Assessment" },
        "decision_boundary": { "$ref": "#/$defs/DecisionBoundary" },
        "authority": {
          "$ref": "../../project-history-impact-view/1.0.0/schema.json#/$defs/AuthorityPosition"
        },
        "omissions": {
          "const": [
            "compensation_preview_not_composed",
            "compensation_execution_not_performed",
            "generic_undo_not_implemented",
            "multi_step_compensation_not_assessed",
            "historical_project_definition_not_interpreted",
            "dependent_effect_not_inferred_from_reference",
            "cross_family_total_order_not_asserted"
          ]
        },
        "graph_navigation_history": { "const": "client_local_separate" }
      }
    }
  }
}
