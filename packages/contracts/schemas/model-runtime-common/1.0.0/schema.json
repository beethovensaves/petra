{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/model-runtime-common/1.0.0/schema.json",
  "title": "PetraModelRuntimeCommon",
  "description": "Shared provider-neutral definitions for versioned Petra model-role execution records.",
  "$defs": {
    "DeploymentSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_deployment_id",
        "provider_id",
        "provider_kind",
        "provider_model",
        "observed_revision",
        "replayability",
        "execution_location",
        "structured_output",
        "max_context_tokens"
      ],
      "properties": {
        "model_deployment_id": { "$ref": "#/$defs/ModelDeploymentId" },
        "provider_id": { "$ref": "#/$defs/ProviderId" },
        "provider_kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,99}$"
        },
        "provider_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "observed_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "replayability": { "enum": ["exact", "best_effort", "unavailable"] },
        "execution_location": { "enum": ["local", "remote"] },
        "structured_output": { "type": "boolean" },
        "max_context_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "DeploymentObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_deployment_id",
        "provider_id",
        "provider_kind",
        "provider_model",
        "observed_revision",
        "replayability",
        "endpoint_fingerprint"
      ],
      "properties": {
        "model_deployment_id": { "$ref": "#/$defs/ModelDeploymentId" },
        "provider_id": { "$ref": "#/$defs/ProviderId" },
        "provider_kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,99}$"
        },
        "provider_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "observed_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "replayability": { "enum": ["exact", "best_effort", "unavailable"] },
        "endpoint_fingerprint": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "PromptProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "content_hash"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "ContractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_name", "schema_version", "schema_hash"],
      "properties": {
        "schema_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,99}$"
        },
        "schema_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "schema_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "ContextPacketRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_packet_id", "content_hash"],
      "properties": {
        "context_packet_id": {
          "allOf": [
            { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
            { "type": "string", "pattern": "^context_packet_" }
          ]
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "EvidencePacketRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_packet_id", "content_hash"],
      "properties": {
        "evidence_packet_id": {
          "allOf": [
            { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
            { "type": "string", "pattern": "^evidence_packet_" }
          ]
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "Parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature", "max_output_tokens", "content_hash"],
      "properties": {
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "Message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": { "enum": ["system", "user"] },
        "content": { "type": "string", "minLength": 1, "maxLength": 1000000 }
      }
    },
    "ValidatorResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validator_name", "validator_version", "outcome", "code"],
      "properties": {
        "validator_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "validator_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "outcome": { "enum": ["pass", "warning", "fail"] },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "Timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queue_ms", "total_ms", "validation_ms"],
      "properties": {
        "queue_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 },
        "first_token_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "total_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 },
        "validation_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        }
      }
    },
    "Usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accounting", "input_tokens", "output_tokens"],
      "properties": {
        "accounting": {
          "enum": ["provider_reported", "estimated", "unavailable"]
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "Cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency", "accounting", "pricing_source"],
      "properties": {
        "amount": { "$ref": "#/$defs/DecimalAmount" },
        "currency": { "const": "USD" },
        "accounting": {
          "enum": ["provider_reported", "computed", "unavailable"]
        },
        "pricing_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "Failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "retryable": { "type": "boolean" }
      }
    },
    "CertificationScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "language", "modality", "document_class"],
      "properties": {
        "domain": { "type": "string", "minLength": 1, "maxLength": 500 },
        "language": { "type": "string", "minLength": 1, "maxLength": 100 },
        "modality": { "const": "text" },
        "document_class": { "enum": ["peer_reviewed", "preprint", "scholarly"] }
      }
    },
    "Evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite",
        "dataset_snapshot_hash",
        "prompt_profile",
        "cases_total",
        "cases_passed",
        "metrics",
        "observed_errors"
      ],
      "properties": {
        "suite": { "$ref": "#/$defs/VersionedComponent" },
        "dataset_snapshot_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "prompt_profile": { "$ref": "#/$defs/PromptProfile" },
        "cases_total": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "cases_passed": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/Metric" }
        },
        "observed_errors": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/ObservedError" }
        }
      }
    },
    "VersionedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "Metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "unit", "direction"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "value": { "type": "number" },
        "unit": { "enum": ["count", "ratio", "milliseconds", "usd"] },
        "direction": {
          "enum": ["higher_is_better", "lower_is_better", "descriptive"]
        }
      }
    },
    "ObservedError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "count"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
        "count": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "Decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "valid_from", "invalidation_conditions"],
      "properties": {
        "status": { "enum": ["active", "failed", "invalidated", "expired"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "valid_from": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        },
        "expires_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        },
        "invalidation_conditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "RoutingDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "excluded", "fallback_chain"],
      "properties": {
        "eligible": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/EligibleRoute" }
        },
        "excluded": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/ExcludedRoute" }
        },
        "selected": { "$ref": "#/$defs/SelectedRoute" },
        "fallback_chain": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/ModelDeploymentId" }
        }
      }
    },
    "EligibleRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_deployment_id",
        "role_certification_id",
        "expected_validated_cost_usd",
        "expected_latency_ms"
      ],
      "properties": {
        "model_deployment_id": { "$ref": "#/$defs/ModelDeploymentId" },
        "role_certification_id": { "$ref": "#/$defs/RoleCertificationId" },
        "expected_validated_cost_usd": { "$ref": "#/$defs/DecimalAmount" },
        "expected_latency_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        }
      }
    },
    "ExcludedRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_deployment_id", "code", "reason"],
      "properties": {
        "model_deployment_id": { "$ref": "#/$defs/ModelDeploymentId" },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "SelectedRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_deployment_id", "role_certification_id", "reason"],
      "properties": {
        "model_deployment_id": { "$ref": "#/$defs/ModelDeploymentId" },
        "role_certification_id": { "$ref": "#/$defs/RoleCertificationId" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "Budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "max_input_tokens",
        "max_output_tokens",
        "max_latency_ms",
        "max_cost_usd"
      ],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 20 },
        "max_input_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_latency_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "max_cost_usd": { "$ref": "#/$defs/DecimalAmount" }
      }
    },
    "ModelDeploymentId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        { "type": "string", "pattern": "^model_deployment_" }
      ]
    },
    "ProviderId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        { "type": "string", "pattern": "^provider_" }
      ]
    },
    "RoleCertificationId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        { "type": "string", "pattern": "^role_certification_" }
      ]
    },
    "DecimalAmount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,12})?$"
    }
  }
}
