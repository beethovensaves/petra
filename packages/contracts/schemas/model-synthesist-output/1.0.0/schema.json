{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/model-synthesist-output/1.0.0/schema.json",
  "title": "PetraModelSynthesistOutput",
  "description": "A provider-neutral bounded scientific response whose material statements declare epistemic origin and exact EvidencePacket references; it contains no authority state or mutation commands.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "statements", "coverage"],
  "properties": {
    "schema_name": { "const": "petra.model-synthesist-output" },
    "schema_version": { "const": "1.0.0" },
    "statements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/Statement" }
    },
    "coverage": { "$ref": "#/$defs/CoverageDisclosure" }
  },
  "$defs": {
    "Statement": {
      "oneOf": [
        { "$ref": "#/$defs/SourceReportStatement" },
        { "$ref": "#/$defs/PetraSynthesisStatement" },
        { "$ref": "#/$defs/UnresolvedInferenceStatement" }
      ]
    },
    "SourceReportStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement_key",
        "origin",
        "text",
        "evidence_refs",
        "limitations"
      ],
      "properties": {
        "statement_key": { "$ref": "#/$defs/StatementKey" },
        "origin": { "const": "source_report" },
        "text": { "$ref": "#/$defs/StatementText" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/EvidenceRef" }
        },
        "limitations": { "$ref": "#/$defs/Limitations" }
      }
    },
    "PetraSynthesisStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement_key",
        "origin",
        "text",
        "evidence_refs",
        "limitations"
      ],
      "properties": {
        "statement_key": { "$ref": "#/$defs/StatementKey" },
        "origin": { "const": "petra_synthesis" },
        "text": { "$ref": "#/$defs/StatementText" },
        "evidence_refs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/EvidenceRef" }
        },
        "limitations": { "$ref": "#/$defs/Limitations" }
      }
    },
    "UnresolvedInferenceStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement_key",
        "origin",
        "text",
        "evidence_refs",
        "limitations",
        "resolution_requirement"
      ],
      "properties": {
        "statement_key": { "$ref": "#/$defs/StatementKey" },
        "origin": { "const": "unresolved_inference" },
        "text": { "$ref": "#/$defs/StatementText" },
        "evidence_refs": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/EvidenceRef" }
        },
        "limitations": { "$ref": "#/$defs/Limitations" },
        "resolution_requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "EvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_selection_order",
        "object_kind",
        "object_id",
        "object_revision",
        "object_hash",
        "source_span_selection_orders"
      ],
      "properties": {
        "context_selection_order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "object_kind": { "enum": ["claim", "assertion"] },
        "object_id": {
          "allOf": [
            { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
            { "type": "string", "pattern": "^(claim|assertion)_" }
          ]
        },
        "object_revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "object_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "source_span_selection_orders": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "CoverageDisclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "statement",
        "material_omissions_acknowledged",
        "abstract_only_sources_used",
        "contrary_evidence_status",
        "qualifying_evidence_status"
      ],
      "properties": {
        "state": { "enum": ["complete_for_context", "bounded", "partial"] },
        "statement": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "material_omissions_acknowledged": { "type": "boolean" },
        "abstract_only_sources_used": { "type": "boolean" },
        "contrary_evidence_status": {
          "enum": ["included", "checked_none_in_context", "not_checked"]
        },
        "qualifying_evidence_status": {
          "enum": ["included", "checked_none_in_context", "not_checked"]
        }
      }
    },
    "StatementKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,99}$"
    },
    "StatementText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "Limitations": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
    }
  }
}
