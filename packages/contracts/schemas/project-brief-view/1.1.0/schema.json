{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-brief-view/1.1.0/schema.json",
  "title": "PetraProjectBriefView",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "project_id",
    "content",
    "content_hash",
    "read_at",
    "snapshot_hash"
  ],
  "properties": {
    "schema_name": {
      "const": "petra.project-brief-view"
    },
    "schema_version": {
      "const": "1.1.0"
    },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shell",
        "definition",
        "objective",
        "orientation",
        "section_order",
        "attention",
        "reviews",
        "work",
        "next_steps",
        "recent_decisions",
        "comparison",
        "profile_payload",
        "coverage",
        "inquiry_links",
        "profile_registration"
      ],
      "properties": {
        "shell": {
          "$ref": "../../project-shell-view/1.1.0/schema.json"
        },
        "definition": {
          "$ref": "../../project-definition/1.0.0/schema.json"
        },
        "objective": {
          "$ref": "../../project-objective/1.0.0/schema.json"
        },
        "orientation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["statement", "basis"],
          "properties": {
            "statement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "basis": {
              "const": "exact_current_objective"
            }
          }
        },
        "section_order": {
          "const": [
            "current_focus",
            "attention",
            "comparison",
            "current_state",
            "work",
            "next_steps",
            "recent_decisions"
          ]
        },
        "attention": {
          "type": "array",
          "maxItems": 41,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item_id",
              "owner",
              "owner_content_hash",
              "consequence_class",
              "reason",
              "resolution",
              "deferral",
              "acknowledgment"
            ],
            "properties": {
              "item_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "owner": {
                "enum": ["shell", "review", "work"]
              },
              "owner_content_hash": {
                "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
              },
              "consequence_class": {
                "enum": [
                  "integrity",
                  "review_decision",
                  "work_interruption",
                  "projection_lag"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "resolution": {
                "const": "inspect_canonical_owner"
              },
              "deferral": {
                "const": "preserves_underlying_condition"
              },
              "acknowledgment": {
                "const": "client_local"
              }
            }
          }
        },
        "reviews": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "oneOf": [
              {
                "$ref": "../../project-review-view/1.0.0/schema.json"
              },
              {
                "$ref": "../../project-review-view/1.1.0/schema.json"
              },
              {
                "$ref": "../../project-review-view/1.2.0/schema.json"
              }
            ]
          }
        },
        "work": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "../../project-work-view/1.0.0/schema.json"
          }
        },
        "next_steps": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "../../suggested-action-view/1.0.0/schema.json"
          }
        },
        "recent_decisions": {
          "$ref": "../../project-history-view/1.0.0/schema.json"
        },
        "comparison": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "reason"],
              "properties": {
                "state": {
                  "const": "current_only"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "baseline",
                "through",
                "changes",
                "limitation"
              ],
              "properties": {
                "state": {
                  "const": "recent_history_interval"
                },
                "baseline": {
                  "$ref": "../../project-history-view/1.0.0/schema.json#/$defs/EventRef"
                },
                "through": {
                  "$ref": "../../project-history-view/1.0.0/schema.json#/$defs/AuthorityPosition"
                },
                "changes": {
                  "type": "array",
                  "maxItems": 10,
                  "items": {
                    "$ref": "../../project-history-view/1.0.0/schema.json#/$defs/RecentChange"
                  }
                },
                "limitation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "profile_payload": {
          "$ref": "../../research-brief-payload/1.1.0/schema.json"
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "limitations"],
          "properties": {
            "state": {
              "const": "partial"
            },
            "limitations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        },
        "inquiry_links": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "../../project-inquiry-link/1.0.0/schema.json"
          }
        },
        "profile_registration": {
          "$ref": "../../project-definition/1.0.0/schema.json#/$defs/Registration"
        }
      },
      "title": "ProjectBriefContent"
    },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "read_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    },
    "snapshot_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    }
  }
}
