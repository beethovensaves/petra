{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-profile-command-recovery-view/1.0.0/schema.json",
  "title": "PetraProjectProfileCommandRecoveryView",
  "description": "A read-only reconciliation of one exact Project create or reset request against the immutable Project-profile command receipt. It may offer exact idempotent redelivery through the existing command owner but never executes recovery or creates a second ledger.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "assessment_id",
    "content",
    "content_hash",
    "read_at"
  ],
  "properties": {
    "schema_name": {
      "const": "petra.project-profile-command-recovery-view"
    },
    "schema_version": { "const": "1.0.0" },
    "assessment_id": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        {
          "type": "string",
          "pattern": "^project_profile_recovery_"
        }
      ]
    },
    "content": { "$ref": "#/$defs/RecoveryContent" },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "read_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "ExpectedProject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "revision"],
      "properties": {
        "project_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        }
      }
    },
    "Subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "command_id",
        "idempotency_key",
        "request_hash"
      ],
      "properties": {
        "operation": { "enum": ["create", "reset"] },
        "command_id": {
          "allOf": [
            { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
            { "type": "string", "pattern": "^command_" }
          ]
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "request_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "expected_project": { "$ref": "#/$defs/ExpectedProject" }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "reset" } } },
          "then": {
            "properties": { "expected_project": {} },
            "required": ["expected_project"]
          },
          "else": {
            "not": {
              "properties": { "expected_project": {} },
              "required": ["expected_project"]
            }
          }
        }
      ]
    },
    "EffectConfirmed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "meaning", "receipt"],
      "properties": {
        "state": { "const": "effect_confirmed" },
        "meaning": {
          "const": "The exact Project-profile command receipt is retained. Repeating the same request returns this receipt without another effect."
        },
        "receipt": {
          "$ref": "../../project-profile-command-receipt/1.0.0/schema.json"
        }
      }
    },
    "OutcomeUnknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason", "meaning"],
      "properties": {
        "state": { "const": "outcome_unknown" },
        "reason": { "const": "receipt_not_observed_at_cutoff" },
        "meaning": {
          "const": "No exact receipt was visible at the observation cutoff. Absence does not prove that no effect occurred after the cutoff."
        }
      }
    },
    "UnavailableToVerify": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason", "meaning"],
      "properties": {
        "state": { "const": "unavailable_to_verify" },
        "reason": {
          "enum": [
            "command_identity_conflict",
            "command_not_owned_by_authenticated_actor"
          ]
        },
        "meaning": {
          "const": "The command or idempotency identity cannot be reconciled to this exact authenticated request. Petra will not expose another request or retry with conflicting identity."
        }
      }
    },
    "PreservedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "identity", "durability", "state"],
      "properties": {
        "item": {
          "enum": [
            "exact_request",
            "command_receipt",
            "project",
            "project_definition",
            "objective",
            "prior_project"
          ]
        },
        "identity": { "type": "string", "minLength": 1, "maxLength": 512 },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "durability": { "enum": ["client_session", "postgresql"] },
        "state": {
          "enum": ["client_copy_required", "retained", "archived"]
        }
      }
    },
    "Destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["place_role"],
      "properties": {
        "place_role": { "enum": ["projects", "brief"] },
        "project_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "place_role": { "const": "brief" } } },
          "then": {
            "properties": { "project_id": {} },
            "required": ["project_id"]
          },
          "else": {
            "not": {
              "properties": { "project_id": {} },
              "required": ["project_id"]
            }
          }
        }
      ]
    },
    "RecoveryAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "eligibility",
        "owner",
        "method",
        "path",
        "input_behavior",
        "identity_behavior",
        "authority_effect",
        "history_effect",
        "reason",
        "success_destination",
        "failure_destination",
        "execution_recheck"
      ],
      "properties": {
        "operation": {
          "enum": ["retry_exact_command", "open_resulting_project"]
        },
        "eligibility": { "const": "eligible" },
        "owner": {
          "enum": ["project_profile_command", "browser_navigation"]
        },
        "method": { "enum": ["GET", "POST"] },
        "path": {
          "type": "string",
          "pattern": "^/",
          "minLength": 1,
          "maxLength": 1000
        },
        "input_behavior": { "enum": ["reuse_exact_request", "none"] },
        "identity_behavior": {
          "enum": ["reuse_command_and_idempotency", "no_command"]
        },
        "authority_effect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "history_effect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "success_destination": { "$ref": "#/$defs/Destination" },
        "failure_destination": { "$ref": "#/$defs/Destination" },
        "execution_recheck": { "const": true }
      }
    },
    "ExactReturn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "destination", "reason"],
      "properties": {
        "state": { "const": "exact" },
        "destination": { "$ref": "#/$defs/Destination" },
        "reason": {
          "const": "The retained receipt supplies the resulting Project Brief destination."
        }
      }
    },
    "SafeReturn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "destination", "reason"],
      "properties": {
        "state": { "const": "safe_fallback" },
        "destination": { "$ref": "#/$defs/Destination" },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "RecoveryContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "effect",
        "preservation",
        "eligible_actions",
        "return",
        "observation_cutoff",
        "limitations"
      ],
      "properties": {
        "subject": { "$ref": "#/$defs/Subject" },
        "effect": {
          "oneOf": [
            { "$ref": "#/$defs/EffectConfirmed" },
            { "$ref": "#/$defs/OutcomeUnknown" },
            { "$ref": "#/$defs/UnavailableToVerify" }
          ]
        },
        "preservation": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/PreservedItem" }
        },
        "eligible_actions": {
          "type": "array",
          "maxItems": 1,
          "items": { "$ref": "#/$defs/RecoveryAction" }
        },
        "return": {
          "oneOf": [
            { "$ref": "#/$defs/ExactReturn" },
            { "$ref": "#/$defs/SafeReturn" }
          ]
        },
        "observation_cutoff": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    }
  }
}
