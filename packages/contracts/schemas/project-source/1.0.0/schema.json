{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-source/1.0.0/schema.json",
  "title": "PetraProjectSource",
  "description": "The M1 scholarly specialization: an immutable revision binding one Project to an exact scientific WorkVersion and copy under one ProjectDefinition source role.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "project_source_id",
    "revision",
    "project_id",
    "content",
    "content_hash",
    "added_by",
    "added_at"
  ],
  "properties": {
    "schema_name": { "const": "petra.project-source" },
    "schema_version": { "const": "1.0.0" },
    "project_source_id": {
      "type": "string",
      "pattern": "^project_source_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "revision": { "$ref": "../../common/1.0.0/schema.json#/$defs/Revision" },
    "project_id": { "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId" },
    "content": { "$ref": "#/$defs/ProjectSourceContent" },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "added_by": { "$ref": "../../common/1.0.0/schema.json#/$defs/ActorRef" },
    "added_at": { "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp" }
  },
  "$defs": {
    "DefinitionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_definition_id", "revision", "content_hash"],
      "properties": {
        "project_definition_id": {
          "type": "string",
          "pattern": "^project_definition_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "WorkRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_id", "revision", "record_hash"],
      "properties": {
        "work_id": { "$ref": "../../common/1.0.0/schema.json#/$defs/WorkId" },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "WorkVersionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_version_id", "revision", "record_hash"],
      "properties": {
        "work_version_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/WorkVersionId"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "AuthorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author_id", "revision", "record_hash"],
      "properties": {
        "author_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/AuthorId"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "ArtifactManifestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_manifest_id", "revision", "record_hash"],
      "properties": {
        "artifact_manifest_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ArtifactManifestId"
        },
        "revision": { "const": 1 },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "ProjectSourceContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_kind",
        "project_definition_ref",
        "source_role",
        "work_ref",
        "work_version_ref",
        "author_refs",
        "artifact_manifest_ref",
        "status"
      ],
      "properties": {
        "binding_kind": { "const": "scientific_work_version" },
        "project_definition_ref": { "$ref": "#/$defs/DefinitionRef" },
        "source_role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._/-]{1,199}$"
        },
        "work_ref": { "$ref": "#/$defs/WorkRef" },
        "work_version_ref": { "$ref": "#/$defs/WorkVersionRef" },
        "author_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/AuthorRef" }
        },
        "artifact_manifest_ref": { "$ref": "#/$defs/ArtifactManifestRef" },
        "status": { "enum": ["active", "excluded"] }
      }
    }
  }
}
