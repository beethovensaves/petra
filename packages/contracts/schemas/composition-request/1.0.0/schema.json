{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/composition-request/1.0.0/schema.json",
  "title": "PetraCompositionRequest",
  "description": "An immutable request for one snapshot-bound research artifact. It records the intended use and control limits without authorizing prose or scientific claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "composition_request_id",
    "revision",
    "project_id",
    "snapshot_ref",
    "content",
    "content_hash",
    "requested_by",
    "requested_at"
  ],
  "properties": {
    "schema_name": { "const": "petra.composition-request" },
    "schema_version": { "const": "1.0.0" },
    "composition_request_id": { "$ref": "#/$defs/CompositionRequestId" },
    "revision": { "const": 1 },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "snapshot_ref": {
      "$ref": "../../context-packet/1.0.0/schema.json#/$defs/SnapshotRef"
    },
    "content": { "$ref": "#/$defs/CompositionRequestContent" },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "requested_by": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ActorRef"
    },
    "requested_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "CompositionRequestId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        {
          "type": "string",
          "pattern": "^composition_request_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      ]
    },
    "VersionedControlRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "revision", "content_hash"],
      "properties": {
        "record_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "NamedVersionHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "content_hash"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 512 },
        "version": { "type": "string", "minLength": 1, "maxLength": 200 },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "FelicityContractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "content_hash"],
      "properties": {
        "name": { "const": "petra.felicity" },
        "version": { "type": "string", "minLength": 1, "maxLength": 200 },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "RequestedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "description",
        "audience",
        "language",
        "semantic_format",
        "permitted_scientific_forces"
      ],
      "properties": {
        "artifact_kind": {
          "enum": [
            "passage",
            "outline",
            "table",
            "methods_description",
            "experiment_report",
            "literature_synthesis",
            "bibliography",
            "other"
          ]
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "audience": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "semantic_format": {
          "enum": ["plain_text", "markdown", "structured_json"]
        },
        "permitted_scientific_forces": {
          "description": "An unordered permission set, not a numeric or ordinal confidence scale.",
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "enum": [
              "direct_report",
              "descriptive",
              "association",
              "comparison",
              "qualification",
              "causal",
              "mechanistic",
              "methodological",
              "none"
            ]
          }
        },
        "target_code_points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        }
      }
    },
    "CitationPreferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "export_formats"],
      "properties": {
        "style": {
          "type": "object",
          "additionalProperties": false,
          "required": ["style_kind", "style_name", "style_version"],
          "properties": {
            "style_kind": { "const": "csl" },
            "style_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "style_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "export_formats": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["inline", "markdown", "latex", "bibtex"] }
        }
      }
    },
    "EvidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_namespaces", "inference_policy", "desired_depth"],
      "properties": {
        "allowed_namespaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "../../common/1.0.0/schema.json#/$defs/EvidenceNamespace"
          }
        },
        "inference_policy": {
          "enum": [
            "source_reports_only",
            "bounded_synthesis_allowed",
            "researcher_material_allowed"
          ]
        },
        "desired_depth": { "enum": ["concise", "standard", "deep"] }
      }
    },
    "ControlContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_profile",
        "language_contract",
        "capability_grant_id",
        "privacy_profile_ref",
        "budget_profile_ref",
        "approval_mode"
      ],
      "properties": {
        "output_profile": { "$ref": "#/$defs/NamedVersionHash" },
        "language_contract": { "$ref": "#/$defs/FelicityContractRef" },
        "capability_grant_id": {
          "$ref": "../../command-envelope/1.0.0/schema.json#/$defs/CapabilityGrantId"
        },
        "privacy_profile_ref": { "$ref": "#/$defs/VersionedControlRef" },
        "budget_profile_ref": { "$ref": "#/$defs/VersionedControlRef" },
        "approval_mode": {
          "enum": ["automatic_with_validation", "review_before_draft"]
        }
      }
    },
    "CompositionRequestContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "subject_refs",
        "requested_output",
        "citation_preferences",
        "evidence_policy",
        "control_context",
        "authority_boundary"
      ],
      "properties": {
        "objective": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "subject_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "../../context-packet/1.0.0/schema.json#/$defs/VersionedObjectRef"
          }
        },
        "requested_output": { "$ref": "#/$defs/RequestedOutput" },
        "citation_preferences": { "$ref": "#/$defs/CitationPreferences" },
        "evidence_policy": { "$ref": "#/$defs/EvidencePolicy" },
        "control_context": { "$ref": "#/$defs/ControlContext" },
        "authority_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_is_scientific_authority",
            "request_authorizes_publication"
          ],
          "properties": {
            "request_is_scientific_authority": { "const": false },
            "request_authorizes_publication": { "const": false }
          }
        }
      }
    }
  }
}
