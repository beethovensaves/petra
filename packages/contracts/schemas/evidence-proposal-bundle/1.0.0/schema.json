{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/evidence-proposal-bundle/1.0.0/schema.json",
  "title": "PetraEvidenceProposalBundle",
  "description": "One immutable extraction result containing quarantine-only Claim and Assertion pair proposals. Candidate and validator declarations remain untrusted until the TypeScript admission boundary resolves their exact sources.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "evidence_proposal_bundle_id",
    "revision",
    "content",
    "content_hash",
    "created_by",
    "created_at"
  ],
  "properties": {
    "schema_name": { "const": "petra.evidence-proposal-bundle" },
    "schema_version": { "const": "1.0.0" },
    "evidence_proposal_bundle_id": {
      "$ref": "#/$defs/EvidenceProposalBundleId"
    },
    "revision": { "const": 1 },
    "content": { "$ref": "#/$defs/BundleContent" },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "created_by": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ActorRef"
    },
    "created_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "EvidenceProposalBundleId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        {
          "type": "string",
          "pattern": "^evidence_proposal_bundle_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      ]
    },
    "BundleContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "source",
        "extraction",
        "candidates",
        "diagnostics"
      ],
      "properties": {
        "project_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
        },
        "source": { "$ref": "#/$defs/SourceIdentity" },
        "extraction": { "$ref": "#/$defs/ExtractionIdentity" },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/Candidate" }
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/Diagnostic" }
        }
      }
    },
    "SourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_parse_bundle_id",
        "parsed_document_id",
        "source_artifact_id",
        "source_artifact_content_hash",
        "work_version_id",
        "source_scope"
      ],
      "properties": {
        "document_parse_bundle_id": {
          "$ref": "../../document-parse-bundle/1.0.0/schema.json#/$defs/DocumentParseBundleId"
        },
        "parsed_document_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ParsedDocumentId"
        },
        "source_artifact_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ArtifactId"
        },
        "source_artifact_content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "work_version_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/WorkVersionId"
        },
        "source_scope": { "enum": ["full_text", "abstract_only"] }
      }
    },
    "ExtractionIdentity": {
      "oneOf": [
        { "$ref": "#/$defs/DeterministicExtraction" },
        { "$ref": "#/$defs/ModelExtraction" }
      ]
    },
    "DeterministicExtraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extraction_kind",
        "extraction_run_id",
        "extractor",
        "recipe_hash",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "extraction_kind": { "const": "deterministic_mapping" },
        "extraction_run_id": { "$ref": "#/$defs/ExtractionRunId" },
        "extractor": {
          "$ref": "../../parsed-document/1.0.0/schema.json#/$defs/VersionedComponent"
        },
        "recipe_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "started_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        },
        "completed_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        }
      }
    },
    "ModelExtraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extraction_kind",
        "extraction_run_id",
        "extractor",
        "recipe_hash",
        "model_request_id",
        "model_call_id",
        "model_deployment",
        "prompt_profile",
        "prompt_hash",
        "parameters_hash",
        "context_packet_ref",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "extraction_kind": { "const": "model_extraction" },
        "extraction_run_id": { "$ref": "#/$defs/ExtractionRunId" },
        "extractor": {
          "$ref": "../../parsed-document/1.0.0/schema.json#/$defs/VersionedComponent"
        },
        "recipe_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "model_request_id": {
          "allOf": [
            { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
            { "type": "string", "pattern": "^model_request_" }
          ]
        },
        "model_call_id": {
          "allOf": [
            { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
            { "type": "string", "pattern": "^model_call_" }
          ]
        },
        "model_deployment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "prompt_profile": {
          "$ref": "../../parsed-document/1.0.0/schema.json#/$defs/VersionedComponent"
        },
        "prompt_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "parameters_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "context_packet_ref": {
          "$ref": "#/$defs/ContextPacketRef"
        },
        "started_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        },
        "completed_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        }
      }
    },
    "ExtractionRunId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        { "type": "string", "pattern": "^extraction_run_" }
      ]
    },
    "ContextPacketRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_packet_id", "content_hash"],
      "properties": {
        "context_packet_id": {
          "$ref": "../../context-packet/1.0.0/schema.json#/$defs/ContextPacketId"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "Candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "proposal_role",
        "source_quote",
        "claim",
        "assertion",
        "warnings"
      ],
      "properties": {
        "candidate_id": { "$ref": "#/$defs/CandidateId" },
        "proposal_role": {
          "enum": [
            "primary",
            "qualification",
            "limitation",
            "method",
            "result",
            "negative_control",
            "other"
          ]
        },
        "source_quote": { "$ref": "#/$defs/SourceQuote" },
        "claim": { "$ref": "../../claim/1.0.0/schema.json" },
        "assertion": { "$ref": "../../assertion/1.0.0/schema.json" },
        "warnings": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/Diagnostic" }
        }
      }
    },
    "CandidateId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        { "type": "string", "pattern": "^evidence_candidate_" }
      ]
    },
    "SourceQuote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_text", "selected_text_hash", "source_span_ids"],
      "properties": {
        "exact_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        },
        "selected_text_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "source_span_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "../../common/1.0.0/schema.json#/$defs/SourceSpanId"
          }
        }
      }
    },
    "Diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
        },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "candidate_id": { "$ref": "#/$defs/CandidateId" }
      }
    }
  }
}
