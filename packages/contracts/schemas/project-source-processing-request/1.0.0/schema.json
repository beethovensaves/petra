{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-source-processing-request/1.0.0/schema.json",
  "title": "PetraProjectSourceProcessingRequest",
  "description": "A reviewed request to create and start one bounded processing WorkUnit from an exact current ProjectSource. Actor, grant, Work identity, worker configuration, limits, and timestamps are server-owned.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "command_id",
    "idempotency_key",
    "expected"
  ],
  "properties": {
    "schema_name": { "const": "petra.project-source-processing-request" },
    "schema_version": { "const": "1.0.0" },
    "command_id": {
      "$ref": "../../project-source-registration-request/1.0.0/schema.json#/properties/command_id"
    },
    "idempotency_key": {
      "$ref": "../../project-source-registration-request/1.0.0/schema.json#/properties/idempotency_key"
    },
    "expected": { "$ref": "#/$defs/Expected" }
  },
  "$defs": {
    "ProjectSourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_source_id",
        "revision",
        "content_hash",
        "record_hash",
        "status"
      ],
      "properties": {
        "project_source_id": {
          "type": "string",
          "pattern": "^project_source_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "status": { "const": "active" }
      }
    },
    "ProcessingFamilyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_key", "contract"],
      "properties": {
        "semantic_key": { "const": "petra.source-processing" },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "content_hash"],
          "properties": {
            "name": { "const": "petra.document.parse" },
            "version": { "const": "1.0.0" },
            "content_hash": {
              "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
            }
          }
        }
      }
    },
    "Expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_ref",
        "project_definition_ref",
        "project_source_ref",
        "source_role",
        "processing_family_ref"
      ],
      "properties": {
        "project_ref": {
          "$ref": "../../project-source-registration-request/1.0.0/schema.json#/$defs/ProjectRef"
        },
        "project_definition_ref": {
          "$ref": "../../project-source-registration-request/1.0.0/schema.json#/$defs/DefinitionRef"
        },
        "project_source_ref": { "$ref": "#/$defs/ProjectSourceRef" },
        "source_role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._/-]{1,199}$"
        },
        "processing_family_ref": {
          "$ref": "#/$defs/ProcessingFamilyRef"
        }
      }
    }
  }
}
