{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/model-extractor-output/1.0.0/schema.json",
  "title": "PetraModelExtractorOutput",
  "description": "A provider-neutral structured extractor response. It contains proposed scientific fields and source selections, never authority state or Petra object identities.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "candidates", "diagnostics"],
  "properties": {
    "schema_name": { "const": "petra.model-extractor-output" },
    "schema_version": { "const": "1.0.0" },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/Candidate" }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/Diagnostic" }
    }
  },
  "$defs": {
    "Candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_key",
        "proposal_role",
        "source_quote",
        "canonical_text",
        "claim_kind",
        "scope",
        "detail_level",
        "source_stance",
        "attribution",
        "modality",
        "negated",
        "warnings"
      ],
      "properties": {
        "candidate_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,99}$"
        },
        "proposal_role": {
          "enum": [
            "primary",
            "qualification",
            "limitation",
            "method",
            "result",
            "negative_control",
            "other"
          ]
        },
        "source_quote": { "$ref": "#/$defs/SourceQuote" },
        "canonical_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "claim_kind": {
          "enum": [
            "descriptive",
            "comparative",
            "causal",
            "mechanistic",
            "methodological",
            "theoretical",
            "measurement"
          ]
        },
        "scope": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ScientificScope"
        },
        "detail_level": { "enum": ["broad", "detailed"] },
        "source_stance": {
          "enum": ["states", "hypothesizes", "reports", "qualifies", "rejects"]
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "modality": {
          "enum": ["asserted", "hedged", "conditional", "speculative"]
        },
        "negated": { "type": "boolean" },
        "uncertainty": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "extraction_confidence": {
          "description": "An extractor-specific observation, not a probability that the scientific proposition is true and not an authority threshold.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "warnings": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/Diagnostic" }
        }
      }
    },
    "SourceQuote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_text", "source_span_ids"],
      "properties": {
        "exact_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        },
        "source_span_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "../../common/1.0.0/schema.json#/$defs/SourceSpanId"
          }
        }
      }
    },
    "Diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "candidate_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,99}$"
        }
      }
    }
  }
}
