{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/command-envelope/1.3.0/schema.json",
  "title": "PetraCommandEnvelopeV130",
  "description": "The adapter-neutral command envelope extended with governed ProjectSource replacement creation and retraction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "command_id",
    "idempotency_key",
    "project_id",
    "actor",
    "capability_grant_id",
    "correlation_id",
    "submitted_at",
    "command"
  ],
  "properties": {
    "schema_name": { "const": "petra.command-envelope" },
    "schema_version": { "const": "1.3.0" },
    "command_id": {
      "$ref": "../../command-envelope/1.0.0/schema.json#/$defs/CommandId"
    },
    "idempotency_key": {
      "$ref": "../../command-envelope/1.0.0/schema.json#/$defs/IdempotencyKey"
    },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "actor": { "$ref": "../../common/1.0.0/schema.json#/$defs/ActorRef" },
    "capability_grant_id": {
      "$ref": "../../command-envelope/1.0.0/schema.json#/$defs/CapabilityGrantId"
    },
    "correlation_id": {
      "$ref": "../../command-envelope/1.0.0/schema.json#/$defs/TraceId"
    },
    "causation_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
    },
    "submitted_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    },
    "command": { "$ref": "#/$defs/Command" }
  },
  "$defs": {
    "Command": {
      "oneOf": [
        { "$ref": "../../command-envelope/1.2.0/schema.json#/$defs/Command" },
        { "$ref": "#/$defs/CreateProjectSourceReplacement" },
        { "$ref": "#/$defs/RetractProjectSourceReplacement" }
      ]
    },
    "CreateProjectSourceReplacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_name",
        "replacement_kind",
        "replaced_source_ref",
        "replacement_source_ref",
        "exclusion_receipt_ref",
        "rationale"
      ],
      "properties": {
        "command_name": { "const": "CreateProjectSourceReplacement" },
        "replacement_kind": {
          "$ref": "../../project-source-replacement/1.0.0/schema.json#/$defs/ReplacementContent/properties/replacement_kind"
        },
        "replaced_source_ref": {
          "$ref": "../../project-source-replacement/1.0.0/schema.json#/$defs/ExcludedSourceRef"
        },
        "replacement_source_ref": {
          "$ref": "../../project-source-replacement/1.0.0/schema.json#/$defs/ActiveSourceRef"
        },
        "exclusion_receipt_ref": {
          "$ref": "../../project-source-replacement/1.0.0/schema.json#/$defs/ExclusionReceiptRef"
        },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "ExactReplacementRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_source_replacement_id",
        "revision",
        "content_hash",
        "record_hash",
        "state"
      ],
      "properties": {
        "project_source_replacement_id": {
          "type": "string",
          "pattern": "^project_source_replacement_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "revision": { "const": 1 },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "state": { "enum": ["active", "retracted"] }
      }
    },
    "RetractProjectSourceReplacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_name", "expected_replacement_ref", "reason"],
      "properties": {
        "command_name": { "const": "RetractProjectSourceReplacement" },
        "expected_replacement_ref": {
          "allOf": [
            { "$ref": "#/$defs/ExactReplacementRef" },
            {
              "type": "object",
              "properties": { "state": { "const": "active" } }
            }
          ]
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    }
  }
}
