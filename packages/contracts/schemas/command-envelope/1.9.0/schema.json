{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/command-envelope/1.9.0/schema.json",
  "title": "PetraCommandEnvelopeV190",
  "description": "The adapter-neutral command envelope extended with explicit separation of one exact member from a fresh open multi-member ReviewSession. Separation changes only canonical Review membership and preserves candidate, relationship, basis, validation, ChangeSet, Approval, event, projection, and authority records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "command_id",
    "idempotency_key",
    "project_id",
    "actor",
    "capability_grant_id",
    "correlation_id",
    "submitted_at",
    "command"
  ],
  "properties": {
    "schema_name": { "const": "petra.command-envelope" },
    "schema_version": { "const": "1.9.0" },
    "command_id": {
      "$ref": "../../command-envelope/1.0.0/schema.json#/$defs/CommandId"
    },
    "idempotency_key": {
      "$ref": "../../command-envelope/1.0.0/schema.json#/$defs/IdempotencyKey"
    },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "actor": { "$ref": "../../common/1.0.0/schema.json#/$defs/ActorRef" },
    "capability_grant_id": {
      "$ref": "../../command-envelope/1.0.0/schema.json#/$defs/CapabilityGrantId"
    },
    "correlation_id": {
      "$ref": "../../command-envelope/1.0.0/schema.json#/$defs/TraceId"
    },
    "causation_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
    },
    "submitted_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    },
    "command": { "$ref": "#/$defs/Command" }
  },
  "$defs": {
    "Command": {
      "oneOf": [
        { "$ref": "../../command-envelope/1.8.0/schema.json#/$defs/Command" },
        { "$ref": "#/$defs/SeparateReviewSessionMember" }
      ]
    },
    "SeparateReviewSessionMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_name",
        "expected_review_session_ref",
        "review_member_id"
      ],
      "properties": {
        "command_name": { "const": "SeparateReviewSessionMember" },
        "expected_review_session_ref": {
          "$ref": "../../command-envelope/1.5.0/schema.json#/$defs/ExactReviewSessionRef"
        },
        "review_member_id": {
          "type": "string",
          "pattern": "^review_member_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      }
    }
  }
}
