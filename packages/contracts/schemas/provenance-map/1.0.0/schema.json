{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/provenance-map/1.0.0/schema.json",
  "title": "PetraProvenanceMap",
  "description": "An immutable exhaustive mapping from one DraftArtifact revision's named spans to evidence, Petra inference, researcher origin, structural language, or explicit unsupported state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "provenance_map_id",
    "revision",
    "project_id",
    "draft_ref",
    "evidence_packet_ref",
    "content",
    "content_hash",
    "compiled_by",
    "compiled_at"
  ],
  "properties": {
    "schema_name": { "const": "petra.provenance-map" },
    "schema_version": { "const": "1.0.0" },
    "provenance_map_id": {
      "$ref": "../../draft-artifact/1.0.0/schema.json#/$defs/ProvenanceMapId"
    },
    "revision": { "const": 1 },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "draft_ref": {
      "$ref": "../../draft-span/1.0.0/schema.json#/$defs/DraftRef"
    },
    "evidence_packet_ref": {
      "$ref": "../../draft-artifact/1.0.0/schema.json#/$defs/EvidencePacketRef"
    },
    "content": { "$ref": "#/$defs/ProvenanceContent" },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "compiled_by": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ActorRef"
    },
    "compiled_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "ProvenanceContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "mappings"],
      "properties": {
        "state": { "enum": ["current", "stale"] },
        "mappings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/SpanMapping" }
        }
      }
    },
    "SpanMapping": {
      "oneOf": [
        { "$ref": "#/$defs/CurrentMapping" },
        { "$ref": "#/$defs/StaleMapping" }
      ]
    },
    "CurrentMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draft_span_id",
        "draft_span_revision",
        "mapping_state",
        "bases"
      ],
      "properties": {
        "draft_span_id": {
          "$ref": "../../draft-artifact/1.0.0/schema.json#/$defs/DraftSpanId"
        },
        "draft_span_revision": { "const": 1 },
        "mapping_state": { "const": "current" },
        "bases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/ProvenanceBasis" }
        }
      }
    },
    "StaleMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draft_span_id",
        "draft_span_revision",
        "mapping_state",
        "bases",
        "invalidated_by"
      ],
      "properties": {
        "draft_span_id": {
          "$ref": "../../draft-artifact/1.0.0/schema.json#/$defs/DraftSpanId"
        },
        "draft_span_revision": { "const": 1 },
        "mapping_state": { "const": "stale" },
        "bases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/ProvenanceBasis" }
        },
        "invalidated_by": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
          }
        }
      }
    },
    "ProvenanceBasis": {
      "oneOf": [
        { "$ref": "#/$defs/EvidenceBasis" },
        { "$ref": "#/$defs/PetraInferenceBasis" },
        { "$ref": "#/$defs/ResearcherBasis" },
        { "$ref": "#/$defs/StructuralBasis" },
        { "$ref": "#/$defs/UnsupportedBasis" }
      ]
    },
    "EvidenceBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis_kind",
        "evidence_selection_order",
        "object_ref",
        "relation"
      ],
      "properties": {
        "basis_kind": { "const": "evidence" },
        "evidence_selection_order": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "object_ref": {
          "$ref": "../../context-packet/1.0.0/schema.json#/$defs/VersionedObjectRef"
        },
        "relation": { "$ref": "#/$defs/ProvenanceRelation" }
      }
    },
    "PetraInferenceBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis_kind",
        "inference_kind",
        "evidence_selection_orders",
        "model_request_id",
        "relation",
        "rationale"
      ],
      "properties": {
        "basis_kind": { "const": "petra_inference" },
        "inference_kind": {
          "enum": [
            "synthesis",
            "comparison",
            "interpretation",
            "recommendation"
          ]
        },
        "evidence_selection_orders": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
          }
        },
        "model_request_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
        },
        "relation": { "$ref": "#/$defs/ProvenanceRelation" },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 8000 }
      }
    },
    "ResearcherBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis_kind", "researcher_id", "statement_kind", "relation"],
      "properties": {
        "basis_kind": { "const": "researcher" },
        "researcher_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ActorId"
        },
        "statement_kind": { "enum": ["supplied_statement", "judgment"] },
        "relation": { "$ref": "#/$defs/ProvenanceRelation" }
      }
    },
    "StructuralBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis_kind", "function", "relation"],
      "properties": {
        "basis_kind": { "const": "structural" },
        "function": {
          "enum": ["heading", "connective", "transition", "organization"]
        },
        "relation": { "const": "structural" }
      }
    },
    "UnsupportedBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis_kind", "relation", "reason"],
      "properties": {
        "basis_kind": { "const": "unsupported" },
        "relation": { "const": "unsupported" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "ProvenanceRelation": {
      "enum": [
        "direct_report",
        "support",
        "qualification",
        "comparison",
        "interpretation",
        "synthesis",
        "structural",
        "unsupported"
      ]
    }
  }
}
