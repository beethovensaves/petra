{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/focused-graph-details-view/1.0.0/schema.json",
  "title": "PetraFocusedGraphDetailsView",
  "description": "A read-only exact Details result for one selected member or path in a previously resolved focused graph. It composes the existing semantic-location and ProjectSource owners without granting graph selection, layout, navigation, or mutation authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "project_id",
    "content",
    "content_hash",
    "read_at"
  ],
  "properties": {
    "schema_name": { "const": "petra.focused-graph-details-view" },
    "schema_version": { "const": "1.0.0" },
    "project_id": { "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId" },
    "content": { "$ref": "#/$defs/DetailsContent" },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "read_at": { "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp" }
  },
  "$defs": {
    "StableKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:/-]{1,999}$"
    },
    "GraphBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_name",
        "schema_version",
        "content_hash",
        "task",
        "profile",
        "requested_snapshot",
        "represented_snapshot",
        "semantic_layer",
        "temporal_position",
        "projection_position",
        "scope",
        "return_destination"
      ],
      "properties": {
        "schema_name": { "const": "petra.focused-graph-view" },
        "schema_version": { "enum": ["1.0.0", "1.1.0"] },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "task": {
          "$ref": "../../focused-graph-view/1.0.0/schema.json#/$defs/Task"
        },
        "profile": {
          "$ref": "../../focused-graph-view/1.0.0/schema.json#/$defs/Profile"
        },
        "requested_snapshot": {
          "$ref": "../../focused-graph-view/1.0.0/schema.json#/$defs/ProjectSnapshotRef"
        },
        "represented_snapshot": {
          "$ref": "../../focused-graph-view/1.0.0/schema.json#/$defs/ProjectSnapshotRef"
        },
        "semantic_layer": { "enum": ["current", "working", "historical"] },
        "temporal_position": {
          "oneOf": [
            {
              "$ref": "../../focused-graph-view/1.0.0/schema.json#/$defs/CurrentTemporalPosition"
            },
            {
              "$ref": "../../focused-graph-view/1.0.0/schema.json#/$defs/HistoricalTemporalPosition"
            }
          ]
        },
        "projection_position": {
          "$ref": "../../focused-graph-view/1.0.0/schema.json#/$defs/ProjectionPosition"
        },
        "scope": {
          "$ref": "../../focused-graph-view/1.0.0/schema.json#/$defs/Scope"
        },
        "return_destination": {
          "$ref": "../../focused-graph-view/1.0.0/schema.json#/$defs/SemanticDestination"
        }
      }
    },
    "Selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_kind", "selected_keys"],
      "properties": {
        "selection_kind": { "enum": ["node", "relationship", "path"] },
        "selected_keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/StableKey" }
        }
      }
    },
    "SourceInspectionAvailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "owner",
        "source_span_ref",
        "project_source_id",
        "binding_revision",
        "binding_content_hash",
        "source_view_content_hash",
        "source_view"
      ],
      "properties": {
        "state": { "const": "available" },
        "owner": { "const": "project_source_view" },
        "source_span_ref": {
          "$ref": "../../focused-graph-view/1.0.0/schema.json#/$defs/ExactRef"
        },
        "project_source_id": {
          "type": "string",
          "pattern": "^project_source_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "binding_revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "binding_content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "source_view_content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "source_view": {
          "$ref": "../../project-source-view/1.0.0/schema.json#/$defs/SourceViewContent"
        }
      }
    },
    "SourceInspectionUnavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "owner", "source_span_ref", "reason"],
      "properties": {
        "state": { "const": "unavailable" },
        "owner": { "const": "project_source_view" },
        "source_span_ref": {
          "$ref": "../../focused-graph-view/1.0.0/schema.json#/$defs/ExactRef"
        },
        "project_source_id": {
          "type": "string",
          "pattern": "^project_source_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "SourceInspection": {
      "oneOf": [
        { "$ref": "#/$defs/SourceInspectionAvailable" },
        { "$ref": "#/$defs/SourceInspectionUnavailable" }
      ]
    },
    "NodeDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_kind",
        "member_key",
        "member",
        "semantic_location",
        "source_inspections"
      ],
      "properties": {
        "member_kind": { "const": "node" },
        "member_key": { "$ref": "#/$defs/StableKey" },
        "member": {
          "$ref": "../../focused-graph-view/1.0.0/schema.json#/$defs/Node"
        },
        "semantic_location": {
          "$ref": "../../project-object-location-view/1.0.0/schema.json#/$defs/LocationContent"
        },
        "source_inspections": {
          "type": "array",
          "maxItems": 96,
          "items": { "$ref": "#/$defs/SourceInspection" }
        }
      }
    },
    "RelationshipDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_kind",
        "member_key",
        "member",
        "semantic_location",
        "source_inspections"
      ],
      "properties": {
        "member_kind": { "const": "relationship" },
        "member_key": { "$ref": "#/$defs/StableKey" },
        "member": {
          "$ref": "../../focused-graph-view/1.0.0/schema.json#/$defs/Relationship"
        },
        "semantic_location": {
          "$ref": "../../project-object-location-view/1.0.0/schema.json#/$defs/LocationContent"
        },
        "source_inspections": {
          "type": "array",
          "maxItems": 96,
          "items": { "$ref": "#/$defs/SourceInspection" }
        }
      }
    },
    "DetailsContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "details_request_id",
        "graph",
        "selection",
        "nodes",
        "relationships",
        "paths",
        "limitations",
        "authority_boundary"
      ],
      "properties": {
        "details_request_id": {
          "type": "string",
          "pattern": "^focused_graph_details_request_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "graph": { "$ref": "#/$defs/GraphBinding" },
        "selection": { "$ref": "#/$defs/Selection" },
        "nodes": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/NodeDetails" }
        },
        "relationships": {
          "type": "array",
          "maxItems": 99,
          "items": { "$ref": "#/$defs/RelationshipDetails" }
        },
        "paths": {
          "type": "array",
          "maxItems": 99,
          "items": {
            "$ref": "../../focused-graph-view/1.0.0/schema.json#/$defs/Path"
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
        },
        "authority_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "postgresql_authoritative",
            "neo4j_projection_only",
            "selection_is_presentation_state",
            "details_are_read_only",
            "source_owner",
            "semantic_location_owner",
            "graph_specific_registry_added"
          ],
          "properties": {
            "postgresql_authoritative": { "const": true },
            "neo4j_projection_only": { "const": true },
            "selection_is_presentation_state": { "const": true },
            "details_are_read_only": { "const": true },
            "source_owner": { "const": "project_source_view" },
            "semantic_location_owner": {
              "const": "project_object_location_view"
            },
            "graph_specific_registry_added": { "const": false }
          }
        }
      }
    }
  }
}
