{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/parsed-document/1.0.0/schema.json",
  "title": "PetraParsedDocument",
  "description": "One immutable Petra-normalized interpretation produced by an exact parser run over one source Artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "parsed_document_id",
    "revision",
    "source_artifact_id",
    "source_artifact_content_hash",
    "parser_output_artifact_id",
    "work_version_id",
    "parser_run_id",
    "source_format",
    "adapter",
    "normalization_version",
    "parser_provenance",
    "quality_state",
    "pages",
    "block_ids",
    "diagnostics",
    "created_by",
    "created_at"
  ],
  "properties": {
    "schema_name": {
      "const": "petra.parsed-document"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "parsed_document_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ParsedDocumentId"
    },
    "revision": {
      "const": 1,
      "description": "A changed source, parser, configuration, adapter, or normalization creates a new ParsedDocument."
    },
    "source_artifact_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ArtifactId"
    },
    "source_artifact_content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "parser_output_artifact_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ArtifactId"
    },
    "work_version_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/WorkVersionId"
    },
    "parser_run_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ParserRunId"
    },
    "source_format": {
      "enum": [
        "pdf",
        "html",
        "xml",
        "json",
        "plain_text",
        "code",
        "image",
        "other"
      ]
    },
    "document_language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
      "maxLength": 100
    },
    "adapter": {
      "$ref": "#/$defs/VersionedComponent"
    },
    "normalization_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "parser_provenance": {
      "$ref": "#/$defs/ParserProvenance"
    },
    "quality_state": {
      "enum": ["complete", "partial", "needs_ocr", "failed"]
    },
    "pages": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/Page"
      }
    },
    "block_ids": {
      "type": "array",
      "maxItems": 1000000,
      "uniqueItems": true,
      "items": {
        "$ref": "../../common/1.0.0/schema.json#/$defs/StructuralBlockId"
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/Diagnostic"
      }
    },
    "created_by": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ActorRef"
    },
    "created_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "VersionedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "ParserProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parser",
        "configuration_hash",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "parser": {
          "$ref": "#/$defs/VersionedComponent"
        },
        "configuration_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "component_models": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/VersionedComponent"
          }
        },
        "started_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        },
        "completed_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        }
      }
    },
    "Page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_number",
        "width",
        "height",
        "unit",
        "coordinate_origin",
        "text_layer_state",
        "parse_state"
      ],
      "properties": {
        "page_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "page_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": ["pt", "px", "mm"]
        },
        "coordinate_origin": {
          "enum": ["top_left", "bottom_left"]
        },
        "text_layer_state": {
          "enum": ["present", "absent", "unusable", "unknown"]
        },
        "parse_state": {
          "enum": ["complete", "partial", "needs_ocr", "failed"]
        },
        "quality_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "Diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
        },
        "severity": {
          "enum": ["info", "warning", "error"]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "page_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
