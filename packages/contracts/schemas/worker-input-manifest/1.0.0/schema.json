{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/worker-input-manifest/1.0.0/schema.json",
  "title": "PetraWorkerInputManifest",
  "description": "An immutable, content-bound instruction manifest for one bounded WorkUnit. It may be reused for an authorized retry and carries references, limits, and output slots but no database authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "worker_input_manifest_id",
    "revision",
    "work_unit_id",
    "project_id",
    "content",
    "content_hash",
    "issued_by",
    "issued_at"
  ],
  "properties": {
    "schema_name": {
      "const": "petra.worker-input-manifest"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "worker_input_manifest_id": {
      "$ref": "#/$defs/WorkerInputManifestId"
    },
    "revision": {
      "const": 1,
      "description": "A changed task, input, worker, permission, or limit creates a new manifest."
    },
    "work_unit_id": {
      "$ref": "#/$defs/WorkUnitId"
    },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "content": {
      "$ref": "#/$defs/InputContent"
    },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "issued_by": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ActorRef"
    },
    "issued_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "WorkerInputManifestId": {
      "allOf": [
        {
          "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
        },
        {
          "type": "string",
          "pattern": "^worker_input_manifest_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      ]
    },
    "WorkUnitId": {
      "allOf": [
        {
          "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
        },
        {
          "type": "string",
          "pattern": "^work_unit_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      ]
    },
    "Attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "InputContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task",
        "worker",
        "inputs",
        "expected_outputs",
        "resource_limits",
        "network_policy",
        "partial_result_policy"
      ],
      "properties": {
        "task": {
          "$ref": "#/$defs/TaskDescriptor"
        },
        "worker": {
          "$ref": "#/$defs/WorkerDescriptor"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/InputBinding"
          }
        },
        "expected_outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ExpectedOutput"
          }
        },
        "resource_limits": {
          "$ref": "#/$defs/ResourceLimits"
        },
        "network_policy": {
          "$ref": "#/$defs/NetworkPolicy"
        },
        "partial_result_policy": {
          "enum": ["discard", "retain_declared", "retain_diagnostics"]
        }
      }
    },
    "TaskDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_family", "task_name", "task_version"],
      "properties": {
        "task_family": {
          "enum": [
            "ingestion",
            "document_processing",
            "scientific_extraction",
            "retrieval",
            "reasoning",
            "scientific_computation",
            "experiment_execution",
            "projection",
            "maintenance"
          ]
        },
        "task_name": {
          "$ref": "#/$defs/NamespacedName"
        },
        "task_version": {
          "$ref": "#/$defs/Version"
        }
      }
    },
    "WorkerDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor_kind",
        "worker_name",
        "worker_version",
        "runtime_name",
        "runtime_version",
        "entrypoint"
      ],
      "properties": {
        "executor_kind": {
          "enum": ["python_worker", "typescript_worker", "sandbox"]
        },
        "worker_name": {
          "$ref": "#/$defs/NamespacedName"
        },
        "worker_version": {
          "$ref": "#/$defs/Version"
        },
        "runtime_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,99}$"
        },
        "runtime_version": {
          "$ref": "#/$defs/Version"
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,499}$"
        }
      }
    },
    "NamespacedName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$"
    },
    "Version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,99}$"
    },
    "ContractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_name", "schema_version", "schema_hash"],
      "properties": {
        "schema_name": {
          "type": "string",
          "pattern": "^petra\\.[a-z][a-z0-9.-]{1,199}$"
        },
        "schema_version": {
          "$ref": "#/$defs/Version"
        },
        "schema_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "InputBinding": {
      "oneOf": [
        {
          "$ref": "#/$defs/ArtifactInputBinding"
        },
        {
          "$ref": "#/$defs/RecordInputBinding"
        }
      ]
    },
    "ArtifactInputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_kind",
        "name",
        "artifact_id",
        "content_hash",
        "byte_size"
      ],
      "properties": {
        "binding_kind": {
          "const": "artifact"
        },
        "name": {
          "$ref": "#/$defs/SlotName"
        },
        "artifact_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ArtifactId"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "byte_size": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ByteSize"
        }
      }
    },
    "RecordInputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_kind",
        "name",
        "record_id",
        "record_revision",
        "snapshot_hash"
      ],
      "properties": {
        "binding_kind": {
          "const": "record"
        },
        "name": {
          "$ref": "#/$defs/SlotName"
        },
        "record_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
        },
        "record_revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "snapshot_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "ExpectedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_name",
        "output_role",
        "required",
        "media_type",
        "max_bytes"
      ],
      "properties": {
        "output_name": {
          "$ref": "#/$defs/SlotName"
        },
        "output_role": {
          "enum": [
            "result",
            "proposal",
            "diagnostic",
            "log",
            "metrics",
            "checkpoint"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "media_type": {
          "$ref": "#/$defs/MediaType"
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "contract": {
          "$ref": "#/$defs/ContractRef"
        }
      }
    },
    "SlotName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z][a-z0-9_]{0,99}$"
    },
    "MediaType": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"
    },
    "ResourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_wall_time_ms",
        "max_output_bytes",
        "max_attempts",
        "max_parallelism"
      ],
      "properties": {
        "max_wall_time_ms": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "max_output_bytes": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_parallelism": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_cpu_time_ms": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "max_memory_bytes": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "max_storage_bytes": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "max_network_bytes": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "max_gpu_time_ms": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "max_input_tokens": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "max_output_tokens": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "monetary_limit": {
          "$ref": "#/$defs/MonetaryLimit"
        }
      }
    },
    "PositiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "MonetaryLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "max_microunits"],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "max_microunits": {
          "$ref": "#/$defs/PositiveSafeInteger"
        }
      }
    },
    "NetworkPolicy": {
      "oneOf": [
        {
          "$ref": "#/$defs/BlockedNetwork"
        },
        {
          "$ref": "#/$defs/AllowlistedNetwork"
        }
      ]
    },
    "BlockedNetwork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_mode"],
      "properties": {
        "network_mode": {
          "const": "blocked"
        }
      }
    },
    "AllowlistedNetwork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_mode", "destinations"],
      "properties": {
        "network_mode": {
          "const": "allowlist"
        },
        "destinations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2000
          }
        }
      }
    }
  }
}
