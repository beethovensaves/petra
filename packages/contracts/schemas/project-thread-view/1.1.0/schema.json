{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-thread-view/1.1.0/schema.json",
  "title": "PetraProjectThreadViewV11",
  "description": "A read-only, snapshot-consistent Project thread collection or exact thread detail composed from durable product-thread authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "project_id",
    "content",
    "content_hash",
    "read_at"
  ],
  "properties": {
    "schema_name": {
      "const": "petra.project-thread-view"
    },
    "schema_version": {
      "const": "1.1.0"
    },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "content": {
      "oneOf": [
        {
          "$ref": "#/$defs/CollectionContent"
        },
        {
          "$ref": "#/$defs/DetailContent"
        }
      ]
    },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "read_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "DefinitionRef": {
      "$ref": "../../project-thread/1.0.0/schema.json#/$defs/DefinitionRef"
    },
    "ThreadRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_thread_id",
        "revision",
        "content_hash",
        "record_hash"
      ],
      "properties": {
        "project_thread_id": {
          "$ref": "../../project-thread/1.0.0/schema.json#/$defs/ProjectThreadId"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "AuthorityPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isolation", "event_position", "stream_revision"],
      "properties": {
        "isolation": {
          "const": "repeatable_read"
        },
        "event_position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stream_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "Unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": {
          "const": "unavailable"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "LatestTurn": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "project_turn_id",
            "sequence",
            "snapshot_ref",
            "force",
            "recorded_at"
          ],
          "properties": {
            "state": {
              "const": "available"
            },
            "project_turn_id": {
              "$ref": "../../project-thread/1.0.0/schema.json#/$defs/ProjectTurnId"
            },
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "snapshot_ref": {
              "$ref": "../../context-packet/1.0.0/schema.json#/$defs/SnapshotRef"
            },
            "force": {
              "enum": ["explanation_only", "work_update", "proposal"]
            },
            "recorded_at": {
              "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
            }
          }
        },
        {
          "$ref": "#/$defs/Unavailable"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "project_turn_id",
            "sequence",
            "force",
            "recorded_at",
            "basis"
          ],
          "properties": {
            "state": {
              "const": "available"
            },
            "project_turn_id": {
              "$ref": "../../project-thread/1.0.0/schema.json#/$defs/ProjectTurnId"
            },
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "force": {
              "enum": ["explanation_only", "work_update", "proposal"]
            },
            "recorded_at": {
              "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
            },
            "basis": {
              "$ref": "../../copilot-context/1.0.0/schema.json#/properties/basis"
            }
          }
        }
      ]
    },
    "ThreadSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thread_ref",
        "project_definition_ref",
        "title",
        "task",
        "lifecycle",
        "origin",
        "turn_count",
        "latest_turn",
        "retention",
        "updated_at"
      ],
      "properties": {
        "thread_ref": {
          "$ref": "#/$defs/ThreadRef"
        },
        "project_definition_ref": {
          "$ref": "#/$defs/DefinitionRef"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "lifecycle": {
          "enum": ["open", "archived"]
        },
        "origin": {
          "$ref": "../../project-thread/1.0.0/schema.json#/$defs/ThreadOrigin"
        },
        "turn_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "latest_turn": {
          "$ref": "#/$defs/LatestTurn"
        },
        "retention": {
          "$ref": "../../project-thread/1.0.0/schema.json#/$defs/Retention"
        },
        "updated_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        }
      }
    },
    "OperationCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "state", "reason"],
      "properties": {
        "operation": {
          "enum": ["create", "append_turn", "branch", "archive", "reopen"]
        },
        "state": {
          "const": "unavailable"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "CollectionQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit"],
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "type": "string",
          "pattern": "^offset:[0-9]{1,9}$"
        },
        "lifecycle": {
          "enum": ["open", "archived"]
        }
      }
    },
    "Page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["returned_count", "total_count", "has_more"],
      "properties": {
        "returned_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "total_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": "string",
          "pattern": "^offset:[0-9]{1,9}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "has_more": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "next_cursor": {
                "type": "string",
                "pattern": "^offset:[0-9]{1,9}$"
              }
            },
            "required": ["next_cursor"]
          },
          "else": {
            "properties": {
              "next_cursor": false
            }
          }
        }
      ]
    },
    "CollectionContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_kind",
        "project_definition_ref",
        "query",
        "threads",
        "page",
        "operations",
        "authority"
      ],
      "properties": {
        "view_kind": {
          "const": "collection"
        },
        "project_definition_ref": {
          "$ref": "#/$defs/DefinitionRef"
        },
        "query": {
          "$ref": "#/$defs/CollectionQuery"
        },
        "threads": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/ThreadSummary"
          }
        },
        "page": {
          "$ref": "#/$defs/Page"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/OperationCapability"
          }
        },
        "authority": {
          "$ref": "#/$defs/AuthorityPosition"
        }
      }
    },
    "Representation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason", "artifact_ref"],
      "properties": {
        "state": {
          "const": "metadata_only"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "artifact_ref": {
          "$ref": "../../project-thread/1.0.0/schema.json#/$defs/ExactArtifactRef"
        }
      }
    },
    "HashOnlyRepresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason", "input_hash"],
      "properties": {
        "state": {
          "const": "hash_only"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "input_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "RetainedRepresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason", "artifact_ref"],
      "properties": {
        "state": {
          "const": "metadata_only"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "artifact_ref": {
          "$ref": "../../project-thread/1.0.0/schema.json#/$defs/ExactArtifactRef"
        }
      }
    },
    "TurnView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn",
        "input_representation",
        "response_representation",
        "work_destination"
      ],
      "properties": {
        "turn": {
          "$ref": "../../project-thread/1.1.0/schema.json#/$defs/Turn"
        },
        "input_representation": {
          "oneOf": [
            {
              "$ref": "#/$defs/HashOnlyRepresentation"
            },
            {
              "$ref": "#/$defs/RetainedRepresentation"
            }
          ]
        },
        "response_representation": {
          "$ref": "#/$defs/Representation"
        },
        "work_destination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "work_unit_ref"],
          "properties": {
            "role": {
              "const": "work"
            },
            "work_unit_ref": {
              "$ref": "../../interaction-run/1.0.0/schema.json#/$defs/WorkUnitRef"
            }
          }
        }
      }
    },
    "DetailContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view_kind", "summary", "turns", "operations", "authority"],
      "properties": {
        "view_kind": {
          "const": "detail"
        },
        "summary": {
          "$ref": "#/$defs/ThreadSummary"
        },
        "turns": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/TurnView"
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/OperationCapability"
          }
        },
        "authority": {
          "$ref": "#/$defs/AuthorityPosition"
        }
      }
    }
  }
}
