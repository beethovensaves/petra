{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-objective-command-receipt/1.0.0/schema.json",
  "title": "PetraProjectObjectiveCommandReceipt",
  "description": "The immutable outcome of one authorized reviewed Objective framing or revision command.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "receipt_id",
    "command_id",
    "idempotency_key",
    "request_hash",
    "operation",
    "project_id",
    "actor",
    "capability_grant_id",
    "project_definition_ref",
    "prior_focus",
    "objective_ref",
    "review",
    "effect",
    "destination",
    "recovery",
    "recorded_at",
    "record_hash"
  ],
  "properties": {
    "schema_name": { "const": "petra.project-objective-command-receipt" },
    "schema_version": { "const": "1.0.0" },
    "receipt_id": {
      "type": "string",
      "pattern": "^project_objective_receipt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "command_id": {
      "$ref": "../../project-objective-command-request/1.0.0/schema.json#/properties/command_id"
    },
    "idempotency_key": {
      "$ref": "../../project-objective-command-request/1.0.0/schema.json#/properties/idempotency_key"
    },
    "request_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "operation": { "enum": ["frame", "revise"] },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "actor": { "$ref": "#/$defs/HumanActorRef" },
    "capability_grant_id": {
      "type": "string",
      "pattern": "^capability_grant_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "project_definition_ref": {
      "$ref": "../../project-objective-command-request/1.0.0/schema.json#/$defs/DefinitionRef"
    },
    "prior_focus": {
      "oneOf": [
        {
          "$ref": "../../project-objective-command-request/1.0.0/schema.json#/$defs/NoFocus"
        },
        {
          "$ref": "../../project-objective-command-request/1.0.0/schema.json#/$defs/Focused"
        }
      ]
    },
    "objective_ref": {
      "$ref": "../../project-objective-command-request/1.0.0/schema.json#/$defs/ObjectiveRef"
    },
    "review": { "$ref": "#/$defs/ReviewOutcome" },
    "effect": { "$ref": "#/$defs/Effect" },
    "destination": { "$ref": "#/$defs/BriefDestination" },
    "recovery": { "$ref": "#/$defs/Recovery" },
    "recorded_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    },
    "record_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    }
  },
  "$defs": {
    "HumanActorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "actor_kind"],
      "properties": {
        "actor_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ActorId"
        },
        "actor_kind": { "const": "human" }
      }
    },
    "ReviewOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "rough_statement",
        "proposed_statement",
        "reviewed_by",
        "reviewed_at"
      ],
      "properties": {
        "decision": { "const": "applied" },
        "rough_statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "proposed_statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "reviewed_by": { "$ref": "#/$defs/HumanActorRef" },
        "reviewed_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        }
      }
    },
    "Effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "summary", "current_focus_updated"],
      "properties": {
        "kind": { "enum": ["objective_framed", "objective_revised"] },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "current_focus_updated": { "const": true }
      }
    },
    "BriefDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["place_role", "project_id", "objective_ref"],
      "properties": {
        "place_role": { "const": "brief" },
        "project_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
        },
        "objective_ref": {
          "$ref": "../../project-objective-command-request/1.0.0/schema.json#/$defs/ObjectiveRef"
        }
      }
    },
    "Recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_path",
        "assessment_path",
        "retry_reuses_command_identity",
        "missing_receipt_means_unknown"
      ],
      "properties": {
        "command_path": {
          "type": "string",
          "pattern": "^/api/commands/projects/[^/]+/objective$"
        },
        "assessment_path": {
          "type": "string",
          "pattern": "^/api/queries/projects/[^/]+/objective-command-recovery$"
        },
        "retry_reuses_command_identity": { "const": true },
        "missing_receipt_means_unknown": { "const": true }
      }
    }
  }
}
