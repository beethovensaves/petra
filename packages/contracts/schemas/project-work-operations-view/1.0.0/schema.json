{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-work-operations-view/1.0.0/schema.json",
  "title": "PetraProjectWorkOperationsView",
  "description": "A snapshot-consistent assessment of exact Work input, plan, delivery, controls, recovery, and result destinations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "project_id",
    "work_unit_ref",
    "execution_state",
    "plan",
    "required_inputs",
    "delivery",
    "controls",
    "results",
    "read_at",
    "content_hash"
  ],
  "properties": {
    "schema_name": { "const": "petra.project-work-operations-view" },
    "schema_version": { "const": "1.0.0" },
    "project_id": { "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId" },
    "work_unit_ref": {
      "$ref": "../../project-work-operation-request/1.0.0/schema.json#/$defs/WorkUnitRef"
    },
    "execution_state": {
      "enum": [
        "requested",
        "queued",
        "running",
        "checkpointed",
        "completed",
        "cancelled"
      ]
    },
    "plan": { "$ref": "#/$defs/Plan" },
    "required_inputs": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/RequiredInput" }
    },
    "delivery": { "$ref": "#/$defs/Delivery" },
    "resume_binding": { "$ref": "#/$defs/ResumeBinding" },
    "controls": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/Control" }
    },
    "results": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/Result" }
    },
    "read_at": { "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp" },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    }
  },
  "$defs": {
    "ResumeBinding": {
      "description": "The exact server-owned identity a client must copy into a checkpoint-resume request. It is present only while Resume is available through a trusted registered transition.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "expected_work_unit_ref",
        "expected_checkpoint"
      ],
      "properties": {
        "project_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
        },
        "expected_work_unit_ref": {
          "$ref": "../../project-work-operation-request/1.0.0/schema.json#/$defs/WorkUnitRef"
        },
        "expected_checkpoint": {
          "$ref": "../../work-unit/1.0.0/schema.json#/$defs/CheckpointRef"
        }
      }
    },
    "Plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "selected_priority", "effect_boundary"],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "selected_priority": {
          "enum": ["user_blocking", "user_visible", "normal", "opportunistic"]
        },
        "latest_instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "effect_boundary": { "const": "next_queue_or_successor_schedule" }
      }
    },
    "RequiredInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_request_ref",
        "kind",
        "question",
        "response_options",
        "state",
        "consequence"
      ],
      "properties": {
        "input_request_ref": {
          "$ref": "../../project-work-operation-request/1.0.0/schema.json#/$defs/InputRequestRef"
        },
        "kind": {
          "enum": [
            "clarification",
            "capability",
            "budget",
            "validation_judgment"
          ]
        },
        "question": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "response_options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 400 }
        },
        "state": { "enum": ["pending", "answered", "superseded"] },
        "answer": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "consequence": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "Delivery": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reason"],
          "properties": {
            "state": { "const": "unavailable" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 4000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "interaction_run_id",
            "protocol_thread_id",
            "protocol_run_id",
            "reconnect_path",
            "replay_path"
          ],
          "properties": {
            "state": { "const": "durable" },
            "interaction_run_id": {
              "type": "string",
              "pattern": "^interaction_run_"
            },
            "protocol_thread_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "protocol_run_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "reconnect_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "replay_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        }
      ]
    },
    "Control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "state", "reason"],
      "properties": {
        "operation": {
          "enum": [
            "start",
            "answer_input",
            "steer",
            "prioritize",
            "detach",
            "reconnect",
            "replay",
            "cancel",
            "retry",
            "resume",
            "start_again"
          ]
        },
        "state": {
          "enum": ["available", "unavailable", "client_owned", "query_only"]
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "command_path": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_kind", "record_ref", "destination"],
      "properties": {
        "result_kind": {
          "enum": ["grounded_response", "worker_output_manifest"]
        },
        "record_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "semantic_key",
            "record_id",
            "revision",
            "content_hash",
            "record_hash"
          ],
          "properties": {
            "semantic_key": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200
            },
            "record_id": {
              "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
            },
            "revision": {
              "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
            },
            "content_hash": {
              "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
            },
            "record_hash": {
              "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
            }
          }
        },
        "destination": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "place_role", "target_ref"],
              "properties": {
                "state": { "const": "available" },
                "place_role": {
                  "enum": ["work", "petra", "review", "sources", "composition"]
                },
                "target_ref": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["semantic_key", "object_id", "revision"],
                  "properties": {
                    "semantic_key": {
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 200
                    },
                    "object_id": {
                      "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
                    },
                    "revision": {
                      "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "reason"],
              "properties": {
                "state": { "const": "unavailable" },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              }
            }
          ]
        }
      }
    }
  }
}
