{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/context-packet/1.0.0/schema.json",
  "title": "PetraContextPacket",
  "description": "An immutable, bounded manifest of the exact scientific records authorized as context for one objective, snapshot, and recipe revision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "context_packet_id",
    "revision",
    "project_id",
    "snapshot_ref",
    "recipe_ref",
    "content",
    "content_hash",
    "compiled_by",
    "compiled_at"
  ],
  "properties": {
    "schema_name": { "const": "petra.context-packet" },
    "schema_version": { "const": "1.0.0" },
    "context_packet_id": { "$ref": "#/$defs/ContextPacketId" },
    "revision": { "const": 1 },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "snapshot_ref": { "$ref": "#/$defs/SnapshotRef" },
    "recipe_ref": { "$ref": "#/$defs/ContextRecipeRef" },
    "content": { "$ref": "#/$defs/ContextPacketContent" },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "compiled_by": { "$ref": "#/$defs/ServiceActorRef" },
    "compiled_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "ContextPacketId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        {
          "type": "string",
          "pattern": "^context_packet_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      ]
    },
    "EvidencePacketId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        {
          "type": "string",
          "pattern": "^evidence_packet_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      ]
    },
    "SnapshotRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "snapshot_revision",
        "event_position",
        "content_hash"
      ],
      "properties": {
        "snapshot_id": {
          "allOf": [
            { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
            {
              "type": "string",
              "pattern": "^snapshot_[0-9A-HJKMNP-TV-Z]{26}$"
            }
          ]
        },
        "snapshot_revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "event_position": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "ContextRecipeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_recipe_id", "revision", "content_hash"],
      "properties": {
        "context_recipe_id": {
          "allOf": [
            { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
            {
              "type": "string",
              "pattern": "^context_recipe_[0-9A-HJKMNP-TV-Z]{26}$"
            }
          ]
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "ContextPacketContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "included_objects",
        "omissions",
        "coverage",
        "budget",
        "dependencies"
      ],
      "properties": {
        "objective": { "$ref": "#/$defs/Objective" },
        "included_objects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/ContextInclusion" }
        },
        "omissions": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/Omission" }
        },
        "coverage": { "$ref": "#/$defs/Coverage" },
        "budget": { "$ref": "#/$defs/PacketBudget" },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Dependency" }
        }
      }
    },
    "Objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective_kind", "statement", "target_refs"],
      "properties": {
        "objective_kind": {
          "enum": [
            "answer",
            "inspect",
            "compare",
            "review",
            "compose",
            "experiment",
            "other"
          ]
        },
        "statement": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "target_refs": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/VersionedObjectRef" }
        }
      }
    },
    "ContextInclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_order",
        "object_ref",
        "evidence_roles",
        "authority",
        "source_access",
        "source_span_refs",
        "selection",
        "estimated_tokens"
      ],
      "properties": {
        "selection_order": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "object_ref": { "$ref": "#/$defs/VersionedObjectRef" },
        "evidence_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "relevant",
              "supporting",
              "contrary",
              "qualifying",
              "conflicting",
              "source_location",
              "workflow_state"
            ]
          }
        },
        "authority": { "$ref": "#/$defs/SelectionAuthority" },
        "source_access": {
          "enum": [
            "metadata_only",
            "abstract_only",
            "full_text_structured",
            "full_text_analyzed",
            "not_applicable"
          ]
        },
        "source_span_refs": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "../../common/1.0.0/schema.json#/$defs/SourceSpanId"
          }
        },
        "selection": { "$ref": "#/$defs/SelectionTrace" },
        "estimated_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "VersionedObjectRef": {
      "oneOf": [
        { "$ref": "#/$defs/ClaimRef" },
        { "$ref": "#/$defs/AssertionRef" },
        { "$ref": "#/$defs/SourceSpanRef" },
        { "$ref": "#/$defs/WorkVersionRef" }
      ]
    },
    "ClaimRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_kind",
        "object_id",
        "object_revision",
        "object_hash"
      ],
      "properties": {
        "object_kind": { "const": "claim" },
        "object_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ClaimId"
        },
        "object_revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "object_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "AssertionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_kind",
        "object_id",
        "object_revision",
        "object_hash"
      ],
      "properties": {
        "object_kind": { "const": "assertion" },
        "object_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/AssertionId"
        },
        "object_revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "object_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "SourceSpanRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_kind",
        "object_id",
        "object_revision",
        "object_hash"
      ],
      "properties": {
        "object_kind": { "const": "source_span" },
        "object_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/SourceSpanId"
        },
        "object_revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "object_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "WorkVersionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_kind",
        "object_id",
        "object_revision",
        "object_hash"
      ],
      "properties": {
        "object_kind": { "const": "work_version" },
        "object_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/WorkVersionId"
        },
        "object_revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "object_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "SelectionAuthority": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["zone", "review_state"],
          "properties": {
            "zone": { "const": "quarantine" },
            "review_state": {
              "enum": [
                "unreviewed",
                "machine_checked",
                "human_rejected",
                "disputed"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["zone", "review_state"],
          "properties": {
            "zone": { "const": "trusted" },
            "review_state": {
              "enum": ["machine_checked", "human_accepted", "disputed"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["zone", "review_state"],
          "properties": {
            "zone": { "const": "personal" },
            "review_state": {
              "enum": ["unreviewed", "human_accepted", "disputed"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["zone", "review_state"],
          "properties": {
            "zone": { "const": "source_record" },
            "review_state": { "const": "not_applicable" }
          }
        }
      ]
    },
    "SelectionTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "rank", "reason"],
      "properties": {
        "route": {
          "enum": [
            "deterministic_graph",
            "lexical",
            "dense",
            "hybrid",
            "graph_expansion",
            "cached",
            "explicit_user_selection"
          ]
        },
        "rank": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "score": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "Omission": {
      "oneOf": [
        { "$ref": "#/$defs/KnownObjectOmission" },
        { "$ref": "#/$defs/SearchBoundaryOmission" }
      ]
    },
    "KnownObjectOmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "omission_kind",
        "object_ref",
        "reason",
        "material",
        "detail"
      ],
      "properties": {
        "omission_kind": { "const": "known_object" },
        "object_ref": { "$ref": "#/$defs/VersionedObjectRef" },
        "reason": { "$ref": "#/$defs/OmissionReason" },
        "material": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "SearchBoundaryOmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["omission_kind", "boundary", "reason", "material", "detail"],
      "properties": {
        "omission_kind": { "const": "search_boundary" },
        "boundary": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "reason": { "$ref": "#/$defs/OmissionReason" },
        "material": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "OmissionReason": {
      "enum": [
        "budget",
        "policy",
        "rights",
        "visibility",
        "truncation",
        "unavailable",
        "not_retrieved"
      ]
    },
    "Coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "statement", "contrary_evidence_checked"],
      "properties": {
        "state": {
          "enum": ["complete_for_recipe", "bounded", "partial", "unknown"]
        },
        "statement": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "contrary_evidence_checked": { "type": "boolean" }
      }
    },
    "PacketBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_input_tokens",
        "max_objects",
        "max_source_spans",
        "estimated_input_tokens",
        "included_object_count",
        "included_source_span_count",
        "truncated"
      ],
      "properties": {
        "max_input_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_objects": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_source_spans": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "estimated_input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "included_object_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "included_source_span_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "truncated": { "type": "boolean" }
      }
    },
    "Dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency_kind", "name", "version", "content_hash"],
      "properties": {
        "dependency_kind": {
          "enum": [
            "record",
            "artifact",
            "schema",
            "projection",
            "ranking",
            "policy"
          ]
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 512 },
        "version": { "type": "string", "minLength": 1, "maxLength": 200 },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "ServiceActorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "actor_kind"],
      "properties": {
        "actor_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ActorId"
        },
        "actor_kind": { "const": "service" }
      }
    }
  }
}
