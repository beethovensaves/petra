{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/domain-event/1.3.0/schema.json",
  "title": "PetraDomainEventV130",
  "description": "An immutable Project-stream fact extended with governed ProjectSource replacement creation and retraction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "event_id",
    "event_position",
    "stream_type",
    "stream_id",
    "stream_revision",
    "project_id",
    "actor",
    "occurred_at",
    "recorded_at",
    "correlation_id",
    "causation_id",
    "command_id",
    "idempotency_key",
    "capability_grant_id",
    "event"
  ],
  "properties": {
    "schema_name": { "const": "petra.domain-event" },
    "schema_version": { "const": "1.3.0" },
    "event_id": {
      "$ref": "../../domain-event/1.0.0/schema.json#/$defs/EventId"
    },
    "event_position": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
    },
    "stream_type": { "const": "project" },
    "stream_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "stream_revision": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
    },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "actor": { "$ref": "../../common/1.0.0/schema.json#/$defs/ActorRef" },
    "occurred_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    },
    "recorded_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    },
    "correlation_id": {
      "$ref": "../../command-envelope/1.0.0/schema.json#/$defs/TraceId"
    },
    "causation_id": {
      "$ref": "../../command-envelope/1.0.0/schema.json#/$defs/CommandId"
    },
    "command_id": {
      "$ref": "../../command-envelope/1.0.0/schema.json#/$defs/CommandId"
    },
    "idempotency_key": {
      "$ref": "../../command-envelope/1.0.0/schema.json#/$defs/IdempotencyKey"
    },
    "capability_grant_id": {
      "$ref": "../../command-envelope/1.0.0/schema.json#/$defs/CapabilityGrantId"
    },
    "event": { "$ref": "#/$defs/Event" }
  },
  "$defs": {
    "Event": {
      "oneOf": [
        { "$ref": "../../domain-event/1.2.0/schema.json#/$defs/Event" },
        { "$ref": "#/$defs/ProjectSourceReplacementCreated" },
        { "$ref": "#/$defs/ProjectSourceReplacementRetracted" }
      ]
    },
    "ProjectSourceReplacementCreated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_type", "payload"],
      "properties": {
        "event_type": { "const": "project_source.replacement_created" },
        "payload": {
          "$ref": "../../project-source-replacement/1.0.0/schema.json"
        }
      }
    },
    "ReplacementRetractionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replacement", "retraction"],
      "properties": {
        "replacement": {
          "$ref": "../../project-source-replacement/1.0.0/schema.json"
        },
        "retraction": {
          "$ref": "../../project-source-replacement-retraction/1.0.0/schema.json"
        }
      }
    },
    "ProjectSourceReplacementRetracted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_type", "payload"],
      "properties": {
        "event_type": { "const": "project_source.replacement_retracted" },
        "payload": { "$ref": "#/$defs/ReplacementRetractionPayload" }
      }
    }
  }
}
