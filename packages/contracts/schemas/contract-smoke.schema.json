{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/contract-smoke/1.0.0",
  "title": "PetraContractSmoke",
  "description": "A minimal cross-runtime record used to certify Petra's canonical contract path.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "message", "schema_version", "sequence"],
  "properties": {
    "kind": {
      "const": "petra.contract-smoke"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
