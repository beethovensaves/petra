{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-effective-controls-view/1.0.0/schema.json",
  "title": "PetraProjectEffectiveControlsView",
  "description": "A read-only composition of the controls that are actually effective for one exact Project and ProjectDefinition snapshot, including explicit unsupported policy families.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "project_id",
    "content",
    "content_hash",
    "read_at"
  ],
  "properties": {
    "schema_name": { "const": "petra.project-effective-controls-view" },
    "schema_version": { "const": "1.0.0" },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "content": { "$ref": "#/$defs/EffectiveControlsContent" },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "read_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "ExactRecordRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "revision", "record_hash"],
      "properties": {
        "record_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "ProjectDefinitionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_definition_id",
        "revision",
        "content_hash",
        "record_hash"
      ],
      "properties": {
        "project_definition_id": {
          "allOf": [
            { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
            { "type": "string", "pattern": "^project_definition_" }
          ]
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "AuthoritySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isolation", "event_position", "stream_revision"],
      "properties": {
        "isolation": { "const": "repeatable_read" },
        "event_position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stream_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "ControlScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_kind", "project_id"],
      "properties": {
        "scope_kind": { "const": "project" },
        "project_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
        }
      }
    },
    "Freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "observed_at"],
      "properties": {
        "state": { "enum": ["current", "stale", "unknown"] },
        "observed_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        },
        "limitation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "UnavailableOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": { "const": "unsupported" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "AvailableOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "command_name",
        "schema_name",
        "schema_version",
        "expected_revision"
      ],
      "properties": {
        "state": { "const": "available" },
        "command_name": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]{1,99}$",
          "not": { "const": "SetProjectSetting" }
        },
        "schema_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,127}$"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "expected_revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        }
      }
    },
    "OperationAvailability": {
      "oneOf": [
        { "$ref": "#/$defs/UnavailableOperation" },
        { "$ref": "#/$defs/AvailableOperation" }
      ]
    },
    "HistoryAvailability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "record_ref", "limitation"],
          "properties": {
            "state": { "const": "retained" },
            "record_ref": { "$ref": "#/$defs/ExactRecordRef" },
            "limitation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "limitation"],
          "properties": {
            "state": { "const": "unavailable" },
            "limitation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        }
      ]
    },
    "ControlOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_kind", "record_ref"],
      "properties": {
        "owner_kind": {
          "enum": [
            "project",
            "capability_authority",
            "routing_policy",
            "budget_profile",
            "review_policy"
          ]
        },
        "record_ref": { "$ref": "#/$defs/ExactRecordRef" }
      }
    },
    "MaterialValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "meaning",
        "state",
        "value",
        "origin",
        "operation"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._/-]{1,199}$"
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 240 },
        "meaning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "state": {
          "enum": [
            "effective",
            "inherited",
            "expired",
            "observed_only",
            "unavailable",
            "unknown",
            "unsupported",
            "conflicting"
          ]
        },
        "value": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 4000 },
            { "type": "boolean" },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 240 }
            }
          ]
        },
        "origin": { "$ref": "#/$defs/ControlOrigin" },
        "effective_from": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        },
        "expires_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        },
        "limitation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "operation": { "$ref": "#/$defs/OperationAvailability" }
      }
    },
    "ControlSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "label",
        "summary",
        "owner_kind",
        "scope",
        "freshness",
        "values",
        "history",
        "operation"
      ],
      "properties": {
        "state": {
          "enum": [
            "effective",
            "inherited",
            "expired",
            "observed_only",
            "unavailable",
            "unknown",
            "unsupported",
            "conflicting"
          ]
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 240 },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "owner_kind": {
          "enum": [
            "project",
            "capability_authority",
            "routing_policy",
            "budget_profile",
            "review_policy"
          ]
        },
        "scope": { "$ref": "#/$defs/ControlScope" },
        "freshness": { "$ref": "#/$defs/Freshness" },
        "values": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/MaterialValue" }
        },
        "history": { "$ref": "#/$defs/HistoryAvailability" },
        "operation": { "$ref": "#/$defs/OperationAvailability" }
      }
    },
    "ControlSections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "privacy",
        "capability",
        "model_routing",
        "work_budget",
        "review_policy"
      ],
      "properties": {
        "privacy": { "$ref": "#/$defs/ControlSection" },
        "capability": { "$ref": "#/$defs/ControlSection" },
        "model_routing": { "$ref": "#/$defs/ControlSection" },
        "work_budget": { "$ref": "#/$defs/ControlSection" },
        "review_policy": { "$ref": "#/$defs/ControlSection" }
      }
    },
    "EffectiveControlsContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_ref",
        "project_definition_ref",
        "authority",
        "sections"
      ],
      "properties": {
        "project_ref": { "$ref": "#/$defs/ExactRecordRef" },
        "project_definition_ref": {
          "$ref": "#/$defs/ProjectDefinitionRef"
        },
        "authority": { "$ref": "#/$defs/AuthoritySnapshot" },
        "sections": { "$ref": "#/$defs/ControlSections" }
      }
    }
  }
}
