{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/model-call/1.1.0/schema.json",
  "title": "PetraSynthesistModelCall",
  "description": "One physical bounded synthesist invocation with exact packet input, provider observation, structured output, validation, timing, usage, and cost; it stores no credentials or hidden reasoning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "model_call_id",
    "revision",
    "content",
    "content_hash",
    "started_at",
    "completed_at"
  ],
  "properties": {
    "schema_name": { "const": "petra.model-call" },
    "schema_version": { "const": "1.1.0" },
    "model_call_id": { "$ref": "#/$defs/ModelCallId" },
    "revision": { "const": 1 },
    "content": { "$ref": "#/$defs/CallContent" },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "started_at": { "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp" },
    "completed_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "CallContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_request_id",
        "attempt",
        "attempt_kind",
        "deployment",
        "prompt_profile",
        "parameters_hash",
        "output_contract",
        "input",
        "outcome",
        "validation",
        "timing",
        "usage",
        "cost"
      ],
      "properties": {
        "model_request_id": { "$ref": "#/$defs/ModelRequestId" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 20 },
        "attempt_kind": {
          "enum": ["initial", "retry", "schema_repair", "fallback"]
        },
        "deployment": {
          "$ref": "../../model-runtime-common/1.0.0/schema.json#/$defs/DeploymentObservation"
        },
        "prompt_profile": {
          "$ref": "../../model-runtime-common/1.0.0/schema.json#/$defs/PromptProfile"
        },
        "parameters_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "output_contract": { "$ref": "#/$defs/OutputContract" },
        "input": { "$ref": "#/$defs/ExactInput" },
        "provider_request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "outcome": {
          "enum": [
            "success",
            "validation_failed",
            "provider_error",
            "refusal",
            "timeout"
          ]
        },
        "raw_output": {},
        "output": { "$ref": "../../model-synthesist-output/1.0.0/schema.json" },
        "failure": {
          "$ref": "../../model-runtime-common/1.0.0/schema.json#/$defs/Failure"
        },
        "validation": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "../../model-runtime-common/1.0.0/schema.json#/$defs/ValidatorResult"
          }
        },
        "timing": {
          "$ref": "../../model-runtime-common/1.0.0/schema.json#/$defs/Timing"
        },
        "usage": {
          "$ref": "../../model-runtime-common/1.0.0/schema.json#/$defs/Usage"
        },
        "cost": {
          "$ref": "../../model-runtime-common/1.0.0/schema.json#/$defs/Cost"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "outcome": { "const": "success" } },
            "required": ["outcome"]
          },
          "then": {
            "properties": { "output": {}, "failure": false },
            "required": ["output"]
          },
          "else": {
            "properties": { "failure": {}, "output": false },
            "required": ["failure"]
          }
        }
      ]
    },
    "OutputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_name", "schema_version", "schema_hash"],
      "properties": {
        "schema_name": { "const": "model-synthesist-output" },
        "schema_version": { "const": "1.0.0" },
        "schema_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "ExactInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_packet_ref",
        "evidence_packet_ref",
        "messages",
        "context_selections",
        "content_hash"
      ],
      "properties": {
        "context_packet_ref": {
          "$ref": "../../model-runtime-common/1.0.0/schema.json#/$defs/ContextPacketRef"
        },
        "evidence_packet_ref": {
          "$ref": "../../model-runtime-common/1.0.0/schema.json#/$defs/EvidencePacketRef"
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "../../model-runtime-common/1.0.0/schema.json#/$defs/Message"
          }
        },
        "context_selections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/ContextSelection" }
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "ContextSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_selection_order",
        "object_ref",
        "rendered_content",
        "source_span_selection_orders"
      ],
      "properties": {
        "context_selection_order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "object_ref": {
          "$ref": "../../model-request/1.1.0/schema.json#/$defs/ContextObjectRef"
        },
        "rendered_content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        },
        "source_span_selection_orders": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "ModelRequestId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        { "type": "string", "pattern": "^model_request_" }
      ]
    },
    "ModelCallId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        { "type": "string", "pattern": "^model_call_" }
      ]
    }
  }
}
