{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/model-call/1.0.0/schema.json",
  "title": "PetraModelCall",
  "description": "One physical model invocation with exact bounded input, observed deployment identity, structured output, validation, timing, token use, and cost. It contains no credentials or hidden reasoning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "model_call_id",
    "revision",
    "content",
    "content_hash",
    "started_at",
    "completed_at"
  ],
  "properties": {
    "schema_name": { "const": "petra.model-call" },
    "schema_version": { "const": "1.0.0" },
    "model_call_id": { "$ref": "#/$defs/ModelCallId" },
    "revision": { "const": 1 },
    "content": { "$ref": "#/$defs/CallContent" },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "started_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    },
    "completed_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "CallContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_request_id",
        "attempt",
        "attempt_kind",
        "deployment",
        "prompt_profile",
        "parameters_hash",
        "output_contract",
        "input",
        "outcome",
        "validation",
        "timing",
        "usage",
        "cost"
      ],
      "properties": {
        "model_request_id": { "$ref": "#/$defs/ModelRequestId" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 20 },
        "attempt_kind": {
          "enum": ["initial", "retry", "schema_repair", "fallback"]
        },
        "deployment": { "$ref": "#/$defs/DeploymentObservation" },
        "prompt_profile": { "$ref": "#/$defs/PromptProfile" },
        "parameters_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "output_contract": { "$ref": "#/$defs/ContractRef" },
        "input": { "$ref": "#/$defs/ExactInput" },
        "provider_request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "outcome": {
          "enum": [
            "success",
            "validation_failed",
            "provider_error",
            "refusal",
            "timeout"
          ]
        },
        "raw_output": {
          "description": "The exact provider response payload when one was returned. Petra validates and copies a conforming extractor result into output; invalid payloads remain inspectable only here."
        },
        "output": {
          "$ref": "../../model-extractor-output/1.0.0/schema.json"
        },
        "failure": { "$ref": "#/$defs/Failure" },
        "validation": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/ValidatorResult" }
        },
        "timing": { "$ref": "#/$defs/Timing" },
        "usage": { "$ref": "#/$defs/Usage" },
        "cost": { "$ref": "#/$defs/Cost" }
      }
    },
    "DeploymentObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_deployment_id",
        "provider_id",
        "provider_kind",
        "provider_model",
        "observed_revision",
        "replayability",
        "endpoint_fingerprint"
      ],
      "properties": {
        "model_deployment_id": { "$ref": "#/$defs/ModelDeploymentId" },
        "provider_id": { "$ref": "#/$defs/ProviderId" },
        "provider_kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,99}$"
        },
        "provider_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "observed_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "replayability": { "enum": ["exact", "best_effort", "unavailable"] },
        "endpoint_fingerprint": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "PromptProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "content_hash"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "ContractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_name", "schema_version", "schema_hash"],
      "properties": {
        "schema_name": { "const": "model-extractor-output" },
        "schema_version": { "const": "1.0.0" },
        "schema_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "ExactInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_packet_ref",
        "source_artifact_ref",
        "messages",
        "source_selections",
        "content_hash"
      ],
      "properties": {
        "context_packet_ref": { "$ref": "#/$defs/ContextPacketRef" },
        "source_artifact_ref": { "$ref": "#/$defs/ArtifactRef" },
        "messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/Message" }
        },
        "source_selections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/SourceSelection" }
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "ContextPacketRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_packet_id", "content_hash"],
      "properties": {
        "context_packet_id": {
          "allOf": [
            { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
            { "type": "string", "pattern": "^context_packet_" }
          ]
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "content_hash"],
      "properties": {
        "artifact_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ArtifactId"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "Message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": { "enum": ["system", "user"] },
        "content": { "type": "string", "minLength": 1, "maxLength": 1000000 }
      }
    },
    "SourceSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_span_id",
        "exact_text",
        "structural_path",
        "page_numbers"
      ],
      "properties": {
        "source_span_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/SourceSpanId"
        },
        "exact_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        },
        "structural_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "page_numbers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 1000000 }
        }
      }
    },
    "Failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "retryable": { "type": "boolean" }
      }
    },
    "ValidatorResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validator_name", "validator_version", "outcome", "code"],
      "properties": {
        "validator_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "validator_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "outcome": { "enum": ["pass", "warning", "fail"] },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "Timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queue_ms", "total_ms", "validation_ms"],
      "properties": {
        "queue_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 },
        "first_token_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "total_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 },
        "validation_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        }
      }
    },
    "Usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accounting", "input_tokens", "output_tokens"],
      "properties": {
        "accounting": {
          "enum": ["provider_reported", "estimated", "unavailable"]
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "Cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency", "accounting", "pricing_source"],
      "properties": {
        "amount": { "$ref": "#/$defs/DecimalAmount" },
        "currency": { "const": "USD" },
        "accounting": {
          "enum": ["provider_reported", "computed", "unavailable"]
        },
        "pricing_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "ModelRequestId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        { "type": "string", "pattern": "^model_request_" }
      ]
    },
    "ModelCallId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        { "type": "string", "pattern": "^model_call_" }
      ]
    },
    "ModelDeploymentId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        { "type": "string", "pattern": "^model_deployment_" }
      ]
    },
    "ProviderId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        { "type": "string", "pattern": "^provider_" }
      ]
    },
    "DecimalAmount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,12})?$"
    }
  }
}
