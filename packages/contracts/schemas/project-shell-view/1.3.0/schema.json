{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-shell-view/1.3.0/schema.json",
  "title": "PetraProjectShellViewV13",
  "description": "A read-only, snapshot-consistent Project shell composition with bounded canonical Work attention, exact Work destinations, and the retained Project resume context.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "project_id",
    "content",
    "content_hash",
    "read_at"
  ],
  "properties": {
    "schema_name": { "const": "petra.project-shell-view" },
    "schema_version": { "const": "1.3.0" },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "content": { "$ref": "#/$defs/ShellContent" },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "read_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "AvailableAttentionWork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "coverage",
        "tasks",
        "returned_count",
        "total_count"
      ],
      "properties": {
        "state": { "const": "available" },
        "coverage": { "enum": ["complete", "partial"] },
        "tasks": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "../../project-work-view/1.1.0/schema.json#/$defs/TaskSummary"
          }
        },
        "returned_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "total_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limitation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "coverage": { "const": "partial" } },
            "required": ["coverage"]
          },
          "then": {
            "properties": { "limitation": {} },
            "required": ["limitation"]
          },
          "else": { "properties": { "limitation": false } }
        }
      ]
    },
    "UnavailableAttentionWork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": { "const": "unavailable" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "AttentionWork": {
      "oneOf": [
        { "$ref": "#/$defs/AvailableAttentionWork" },
        { "$ref": "#/$defs/UnavailableAttentionWork" }
      ]
    },
    "ShellContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "definition",
        "authority",
        "projection",
        "attention",
        "attention_work",
        "place_summaries",
        "resume"
      ],
      "properties": {
        "project": {
          "$ref": "../1.0.0/schema.json#/$defs/ProjectSummary"
        },
        "definition": {
          "$ref": "../1.0.0/schema.json#/$defs/DefinitionSummary"
        },
        "current_objective": {
          "$ref": "../1.0.0/schema.json#/$defs/ObjectiveSummary"
        },
        "authority": {
          "$ref": "../1.0.0/schema.json#/$defs/AuthorityPosition"
        },
        "projection": {
          "$ref": "../1.0.0/schema.json#/$defs/ProjectionSummary"
        },
        "attention": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "../1.0.0/schema.json#/$defs/AttentionItem"
          }
        },
        "attention_work": { "$ref": "#/$defs/AttentionWork" },
        "place_summaries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "$ref": "../1.1.0/schema.json#/$defs/PlaceSummary" }
        },
        "selection": {
          "$ref": "../../project-object-location-view/1.0.0/schema.json#/$defs/LocationContent"
        },
        "resume": { "$ref": "../1.2.0/schema.json#/$defs/ResumeContext" }
      }
    }
  }
}
