{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/copilot-output/1.0.0/schema.json",
  "title": "PetraCopilotOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "authority",
    "blocks",
    "focus_keys"
  ],
  "properties": {
    "schema_name": {
      "const": "petra.copilot-output"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "authority": {
      "const": "advisory_only"
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "text",
          "citations"
        ],
        "properties": {
          "kind": {
            "enum": [
              "source_report",
              "inference",
              "advice",
              "question"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "citations": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "source_report"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "citations": {
                  "minItems": 1,
                  "type": "array"
                }
              }
            }
          }
        ]
      }
    },
    "focus_keys": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  }
}
