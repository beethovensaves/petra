{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-source-registration-receipt/1.0.0/schema.json",
  "title": "PetraProjectSourceRegistrationReceipt",
  "description": "The immutable ancestry and exact Project membership outcome of one authorized new-source registration command.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "receipt_id",
    "command_id",
    "idempotency_key",
    "request_hash",
    "project_id",
    "actor",
    "capability_grant_id",
    "project_ref",
    "project_definition_ref",
    "source_identity",
    "material",
    "membership",
    "project_source_ref",
    "effect",
    "destination",
    "recovery",
    "recorded_at",
    "record_hash"
  ],
  "properties": {
    "schema_name": {
      "const": "petra.project-source-registration-receipt"
    },
    "schema_version": { "const": "1.0.0" },
    "receipt_id": {
      "type": "string",
      "pattern": "^source_registration_receipt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "command_id": {
      "$ref": "../../project-source-registration-request/1.0.0/schema.json#/properties/command_id"
    },
    "idempotency_key": {
      "$ref": "../../project-source-registration-request/1.0.0/schema.json#/properties/idempotency_key"
    },
    "request_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "actor": { "$ref": "#/$defs/HumanActorRef" },
    "capability_grant_id": {
      "type": "string",
      "pattern": "^capability_grant_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "project_ref": {
      "$ref": "../../project-source-registration-request/1.0.0/schema.json#/$defs/ProjectRef"
    },
    "project_definition_ref": {
      "$ref": "../../project-source-registration-request/1.0.0/schema.json#/$defs/DefinitionRef"
    },
    "source_identity": { "$ref": "#/$defs/SourceIdentity" },
    "material": { "$ref": "#/$defs/Material" },
    "membership": { "$ref": "#/$defs/Membership" },
    "project_source_ref": { "$ref": "#/$defs/ProjectSourceRef" },
    "effect": { "$ref": "#/$defs/Effect" },
    "destination": { "$ref": "#/$defs/SourceDestination" },
    "recovery": { "$ref": "#/$defs/Recovery" },
    "recorded_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    },
    "record_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    }
  },
  "$defs": {
    "HumanActorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "actor_kind"],
      "properties": {
        "actor_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ActorId"
        },
        "actor_kind": { "const": "human" }
      }
    },
    "ExactRecordRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "revision", "record_hash"],
      "properties": {
        "record_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "revision",
        "content_hash",
        "record_hash",
        "byte_size",
        "media_type"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ArtifactId"
        },
        "revision": { "const": 1 },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "byte_size": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ByteSize"
        },
        "media_type": { "type": "string", "minLength": 3, "maxLength": 300 }
      }
    },
    "SourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_ref", "work_version_ref", "author_refs"],
      "properties": {
        "work_ref": { "$ref": "#/$defs/ExactRecordRef" },
        "work_version_ref": { "$ref": "#/$defs/ExactRecordRef" },
        "author_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/ExactRecordRef" }
        }
      }
    },
    "Material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_ref",
        "artifact_manifest_ref",
        "rights_decision_ref",
        "storage",
        "origin"
      ],
      "properties": {
        "artifact_ref": { "$ref": "#/$defs/ArtifactRef" },
        "artifact_manifest_ref": { "$ref": "#/$defs/ExactRecordRef" },
        "rights_decision_ref": { "$ref": "#/$defs/ExactRecordRef" },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["store_name", "object_key", "availability"],
          "properties": {
            "store_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "object_key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "availability": { "const": "available" }
          }
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["origin_kind", "original_filename", "source_location"],
          "properties": {
            "origin_kind": { "const": "user_supplied" },
            "original_filename": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "source_location": {
              "type": "string",
              "format": "uri",
              "maxLength": 4000
            }
          }
        }
      }
    },
    "Membership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "source_role", "reviewed_by", "reviewed_at"],
      "properties": {
        "decision": { "const": "registered_and_linked" },
        "source_role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._/-]{1,199}$"
        },
        "reviewed_by": { "$ref": "#/$defs/HumanActorRef" },
        "reviewed_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        }
      }
    },
    "ProjectSourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_source_id",
        "revision",
        "content_hash",
        "record_hash",
        "status"
      ],
      "properties": {
        "project_source_id": {
          "type": "string",
          "pattern": "^project_source_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "revision": { "const": 1 },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "status": { "const": "active" }
      }
    },
    "Effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "summary", "meaning_authority_unchanged"],
      "properties": {
        "kind": { "const": "source_registered_and_linked" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "meaning_authority_unchanged": { "const": true }
      }
    },
    "SourceDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["place_role", "project_id", "project_source_id"],
      "properties": {
        "place_role": { "const": "sources" },
        "project_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
        },
        "project_source_id": {
          "type": "string",
          "pattern": "^project_source_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      }
    },
    "Recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_path",
        "assessment_path",
        "retry_reuses_command_identity",
        "missing_receipt_means_unknown"
      ],
      "properties": {
        "command_path": {
          "type": "string",
          "pattern": "^/api/commands/projects/[^/]+/sources/register$"
        },
        "assessment_path": {
          "type": "string",
          "pattern": "^/api/queries/projects/[^/]+/source-registration-recovery$"
        },
        "retry_reuses_command_identity": { "const": true },
        "missing_receipt_means_unknown": { "const": true }
      }
    }
  }
}
