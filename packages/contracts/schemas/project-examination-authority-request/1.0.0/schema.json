{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-examination-authority-request/1.0.0/schema.json",
  "title": "PetraProjectExaminationAuthorityRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "project_id",
    "command_id",
    "idempotency_key",
    "graph_content_hash",
    "operation",
    "review"
  ],
  "properties": {
    "schema_name": {
      "const": "petra.project-examination-authority-request"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "command_id": {
      "$ref": "../../command-envelope/1.0.0/schema.json#/$defs/CommandId"
    },
    "idempotency_key": {
      "$ref": "../../command-envelope/1.0.0/schema.json#/$defs/IdempotencyKey"
    },
    "graph_content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "operation": {
      "const": "authorize_own_examination"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposed_content_hash",
        "rationale",
        "reviewed_at"
      ],
      "properties": {
        "proposed_content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
