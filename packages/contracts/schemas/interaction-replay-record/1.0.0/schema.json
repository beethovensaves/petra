{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/interaction-replay-record/1.0.0/schema.json",
  "title": "PetraInteractionReplayRecord",
  "description": "An immutable receipt for one initial or resumed delivery of interaction events to a connection. It records presentation replay only and cannot reapply commands or cancel durable work.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "interaction_replay_record_id",
    "revision",
    "project_id",
    "interaction_run_ref",
    "content",
    "content_hash",
    "recorded_by",
    "recorded_at"
  ],
  "properties": {
    "schema_name": { "const": "petra.interaction-replay-record" },
    "schema_version": { "const": "1.0.0" },
    "interaction_replay_record_id": {
      "$ref": "#/$defs/InteractionReplayRecordId"
    },
    "revision": { "const": 1 },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "interaction_run_ref": { "$ref": "#/$defs/InteractionRunRef" },
    "content": { "$ref": "#/$defs/ReplayContent" },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "recorded_by": { "$ref": "#/$defs/ServiceActorRef" },
    "recorded_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "InteractionReplayRecordId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        {
          "type": "string",
          "pattern": "^interaction_replay_record_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      ]
    },
    "InteractionRunId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        {
          "type": "string",
          "pattern": "^interaction_run_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      ]
    },
    "InteractionEventRecordId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        {
          "type": "string",
          "pattern": "^interaction_event_record_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      ]
    },
    "InteractionRunRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interaction_run_id", "revision", "content_hash"],
      "properties": {
        "interaction_run_id": { "$ref": "#/$defs/InteractionRunId" },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "ServiceActorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "actor_kind"],
      "properties": {
        "actor_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ActorId"
        },
        "actor_kind": { "const": "service" }
      }
    },
    "ReplayContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection_id",
        "attempt",
        "request",
        "started_at",
        "completed_at",
        "delivered_event_refs",
        "outcome",
        "work_unit_observation",
        "authority_boundary"
      ],
      "properties": {
        "connection_id": { "$ref": "#/$defs/ConnectionId" },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["delivery_kind", "after_sequence"],
          "properties": {
            "delivery_kind": { "enum": ["initial", "resume", "replay"] },
            "after_sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "started_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        },
        "completed_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        },
        "delivered_event_refs": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/EventRecordRef" }
        },
        "outcome": { "$ref": "#/$defs/DeliveryOutcome" },
        "work_unit_observation": { "$ref": "#/$defs/WorkUnitObservation" },
        "authority_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority_reapplied",
            "commands_reexecuted",
            "durable_work_cancelled"
          ],
          "properties": {
            "authority_reapplied": { "const": false },
            "commands_reexecuted": { "const": false },
            "durable_work_cancelled": { "const": false }
          }
        }
      }
    },
    "ConnectionId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        {
          "type": "string",
          "pattern": "^interaction_connection_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      ]
    },
    "EventRecordRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interaction_event_record_id", "sequence", "content_hash"],
      "properties": {
        "interaction_event_record_id": {
          "$ref": "#/$defs/InteractionEventRecordId"
        },
        "sequence": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "DeliveryOutcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome_kind"],
          "properties": { "outcome_kind": { "const": "completed" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome_kind", "last_delivered_sequence"],
          "properties": {
            "outcome_kind": { "const": "connection_aborted" },
            "last_delivered_sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome_kind", "last_delivered_sequence", "error"],
          "properties": {
            "outcome_kind": { "const": "write_error" },
            "last_delivered_sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[A-Z][A-Z0-9_]{0,199}$"
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            }
          }
        }
      ]
    },
    "WorkUnitObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_unit_id", "revision", "status"],
      "properties": {
        "work_unit_id": {
          "$ref": "../../worker-input-manifest/1.0.0/schema.json#/$defs/WorkUnitId"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "status": {
          "enum": [
            "requested",
            "queued",
            "running",
            "checkpointed",
            "succeeded",
            "failed",
            "cancelled"
          ]
        }
      }
    }
  }
}
