{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-object-location-view/1.0.0/schema.json",
  "title": "PetraProjectObjectLocationView",
  "description": "A read-only, Project-scoped semantic destination result. It returns registered place roles and exact identity, never client routes or layout instructions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "project_id",
    "content",
    "content_hash",
    "read_at"
  ],
  "properties": {
    "schema_name": { "const": "petra.project-object-location-view" },
    "schema_version": { "const": "1.0.0" },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "content": { "$ref": "#/$defs/LocationContent" },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "read_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "SemanticKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._/-]{1,199}$"
    },
    "PlaceRole": {
      "enum": [
        "brief",
        "sources",
        "review",
        "graph",
        "work",
        "petra",
        "composition",
        "history",
        "settings",
        "profile_tool"
      ]
    },
    "RequestedObjectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_key", "object_id"],
      "properties": {
        "semantic_key": { "$ref": "#/$defs/SemanticKey" },
        "object_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        }
      }
    },
    "ExactObjectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_key", "object_id", "revision", "record_hash"],
      "properties": {
        "semantic_key": { "$ref": "#/$defs/SemanticKey" },
        "object_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "LocationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_ref", "task_intent"],
      "properties": {
        "object_ref": { "$ref": "#/$defs/RequestedObjectRef" },
        "task_intent": {
          "enum": [
            "orient",
            "inspect",
            "trace",
            "review",
            "continue_work",
            "view_history"
          ]
        }
      }
    },
    "DefinitionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_definition_id",
        "revision",
        "content_hash",
        "definition_family"
      ],
      "properties": {
        "project_definition_id": {
          "type": "string",
          "pattern": "^project_definition_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "definition_family": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{2,127}$"
        }
      }
    },
    "ObjectDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_key",
        "generic_family",
        "label",
        "summary",
        "lifecycle_state"
      ],
      "properties": {
        "semantic_key": { "$ref": "#/$defs/SemanticKey" },
        "generic_family": {
          "$ref": "../../project-definition/1.0.0/schema.json#/$defs/Term/properties/generic_family"
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 240 },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "lifecycle_state": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        }
      }
    },
    "ResolvedLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "requested_ref",
        "resolved_ref",
        "current_ref",
        "descriptor",
        "replacement_chain"
      ],
      "properties": {
        "state": { "enum": ["current", "historical", "superseded"] },
        "requested_ref": { "$ref": "#/$defs/RequestedObjectRef" },
        "resolved_ref": { "$ref": "#/$defs/ExactObjectRef" },
        "current_ref": { "$ref": "#/$defs/ExactObjectRef" },
        "descriptor": { "$ref": "#/$defs/ObjectDescriptor" },
        "parent_ref": { "$ref": "#/$defs/ExactObjectRef" },
        "replacement_chain": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/ExactObjectRef" }
        }
      }
    },
    "UnavailableLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "requested_ref", "failure"],
      "properties": {
        "state": { "enum": ["missing", "unauthorized", "unsupported"] },
        "requested_ref": { "$ref": "#/$defs/RequestedObjectRef" },
        "failure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        }
      }
    },
    "Destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "purpose"],
      "properties": {
        "role": { "$ref": "#/$defs/PlaceRole" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 500 },
        "target_ref": { "$ref": "#/$defs/ExactObjectRef" },
        "profile_tool_key": { "$ref": "#/$defs/SemanticKey" }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "const": "profile_tool" } } },
          "then": {
            "required": ["profile_tool_key"],
            "properties": { "profile_tool_key": {} }
          },
          "else": { "properties": { "profile_tool_key": false } }
        }
      ]
    },
    "LocationContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["details_allowed", "petra_allowed"],
      "properties": {
        "details_allowed": { "type": "boolean" },
        "petra_allowed": { "type": "boolean" }
      }
    },
    "LocationContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "definition_ref",
        "resolution",
        "primary_destination",
        "alternate_destinations",
        "context",
        "authority",
        "projection"
      ],
      "properties": {
        "request": { "$ref": "#/$defs/LocationRequest" },
        "definition_ref": { "$ref": "#/$defs/DefinitionRef" },
        "resolution": {
          "oneOf": [
            { "$ref": "#/$defs/ResolvedLocation" },
            { "$ref": "#/$defs/UnavailableLocation" }
          ]
        },
        "primary_destination": { "$ref": "#/$defs/Destination" },
        "alternate_destinations": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/Destination" }
        },
        "fallback_destination": { "$ref": "#/$defs/Destination" },
        "context": { "$ref": "#/$defs/LocationContext" },
        "authority": {
          "$ref": "../../project-shell-view/1.0.0/schema.json#/$defs/AuthorityPosition"
        },
        "projection": {
          "$ref": "../../project-shell-view/1.0.0/schema.json#/$defs/ProjectionSummary"
        }
      }
    }
  }
}
