{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/felicity-revision-record/1.0.0/schema.json",
  "title": "PetraFelicityRevisionRecord",
  "description": "An immutable receipt proving that one bounded Felicity transformation became a new DraftArtifact revision without changing scientific force, epistemic origin, provenance bases, or citation scope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "felicity_revision_record_id",
    "revision",
    "project_id",
    "command_id",
    "previous_draft_ref",
    "revised_draft_ref",
    "provenance_map_ref",
    "citation_bundle_ref",
    "language_contract",
    "content",
    "content_hash",
    "recorded_by",
    "recorded_at"
  ],
  "properties": {
    "schema_name": { "const": "petra.felicity-revision-record" },
    "schema_version": { "const": "1.0.0" },
    "felicity_revision_record_id": {
      "$ref": "#/$defs/FelicityRevisionRecordId"
    },
    "revision": { "const": 1 },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "command_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
    },
    "previous_draft_ref": {
      "$ref": "../../draft-span/1.0.0/schema.json#/$defs/DraftRef"
    },
    "revised_draft_ref": {
      "$ref": "../../draft-span/1.0.0/schema.json#/$defs/DraftRef"
    },
    "provenance_map_ref": {
      "$ref": "../../draft-support-assessment/1.0.0/schema.json#/$defs/ProvenanceMapRef"
    },
    "citation_bundle_ref": {
      "$ref": "../../draft-support-assessment/1.0.0/schema.json#/$defs/CitationBundleRef"
    },
    "language_contract": {
      "$ref": "../../draft-artifact/1.0.0/schema.json#/$defs/NamedVersionHash"
    },
    "content": { "$ref": "#/$defs/RevisionContent" },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "recorded_by": { "$ref": "#/$defs/ServiceActorRef" },
    "recorded_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "FelicityRevisionRecordId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        {
          "type": "string",
          "pattern": "^felicity_revision_record_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      ]
    },
    "ServiceActorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "actor_kind"],
      "properties": {
        "actor_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ActorId"
        },
        "actor_kind": { "const": "service" }
      }
    },
    "RevisionContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "transformations",
        "validator_results",
        "preservation",
        "authority_boundary"
      ],
      "properties": {
        "state": { "const": "passed" },
        "transformations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/SpanTransformation" }
        },
        "validator_results": {
          "type": "array",
          "minItems": 5,
          "maxItems": 1000,
          "items": {
            "$ref": "../../draft-support-assessment/1.0.0/schema.json#/$defs/ValidatorResult"
          }
        },
        "preservation": { "$ref": "#/$defs/PreservationBoundary" },
        "authority_boundary": { "$ref": "#/$defs/AuthorityBoundary" }
      }
    },
    "SpanTransformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "previous_draft_span_id",
        "previous_exact_text_hash",
        "revised_draft_span_id",
        "revised_exact_text_hash",
        "transformation_kind",
        "basis_snapshot_hash",
        "previous_citation_ids",
        "revised_citation_ids"
      ],
      "properties": {
        "position": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "previous_draft_span_id": {
          "$ref": "../../draft-artifact/1.0.0/schema.json#/$defs/DraftSpanId"
        },
        "previous_exact_text_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "revised_draft_span_id": {
          "$ref": "../../draft-artifact/1.0.0/schema.json#/$defs/DraftSpanId"
        },
        "revised_exact_text_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "transformation_kind": {
          "enum": [
            "unchanged",
            "filler_reduction",
            "whitespace_normalization",
            "filler_and_whitespace"
          ]
        },
        "basis_snapshot_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "previous_citation_ids": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "$ref": "../../draft-artifact/1.0.0/schema.json#/$defs/CitationId"
          }
        },
        "revised_citation_ids": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "$ref": "../../draft-artifact/1.0.0/schema.json#/$defs/CitationId"
          }
        }
      }
    },
    "PreservationBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scientific_force_preserved",
        "epistemic_origin_preserved",
        "provenance_bases_preserved",
        "citation_scope_preserved"
      ],
      "properties": {
        "scientific_force_preserved": { "const": true },
        "epistemic_origin_preserved": { "const": true },
        "provenance_bases_preserved": { "const": true },
        "citation_scope_preserved": { "const": true }
      }
    },
    "AuthorityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_is_scientific_evidence",
        "content_changes_require_new_draft_revision"
      ],
      "properties": {
        "record_is_scientific_evidence": { "const": false },
        "content_changes_require_new_draft_revision": { "const": true }
      }
    }
  }
}
