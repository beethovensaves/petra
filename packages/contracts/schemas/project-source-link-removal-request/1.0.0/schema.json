{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-source-link-removal-request/1.0.0/schema.json",
  "title": "PetraProjectSourceLinkRemovalRequest",
  "description": "An exact reviewed request to stop ordinary new Project use of one active ProjectSource. Actor, capability grant, authority time, global source identity, immutable revisions, and local-copy retention remain server-owned.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "command_id",
    "idempotency_key",
    "expected",
    "reason"
  ],
  "properties": {
    "schema_name": { "const": "petra.project-source-link-removal-request" },
    "schema_version": { "const": "1.0.0" },
    "command_id": {
      "$ref": "../../project-source-registration-request/1.0.0/schema.json#/properties/command_id"
    },
    "idempotency_key": {
      "$ref": "../../project-source-registration-request/1.0.0/schema.json#/properties/idempotency_key"
    },
    "expected": { "$ref": "#/$defs/Expected" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 4000 }
  },
  "$defs": {
    "ActiveSourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_source_id",
        "revision",
        "content_hash",
        "record_hash",
        "status"
      ],
      "properties": {
        "project_source_id": {
          "type": "string",
          "pattern": "^project_source_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "status": { "const": "active" }
      }
    },
    "Expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_ref",
        "project_definition_ref",
        "current_source_ref"
      ],
      "properties": {
        "project_ref": {
          "$ref": "../../project-source-registration-request/1.0.0/schema.json#/$defs/ProjectRef"
        },
        "project_definition_ref": {
          "$ref": "../../project-source-registration-request/1.0.0/schema.json#/$defs/DefinitionRef"
        },
        "current_source_ref": { "$ref": "#/$defs/ActiveSourceRef" }
      }
    }
  }
}
