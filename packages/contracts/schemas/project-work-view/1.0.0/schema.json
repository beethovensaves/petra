{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-work-view/1.0.0/schema.json",
  "title": "PetraProjectWorkView",
  "description": "A read-only, snapshot-consistent Project Work collection or exact WorkUnit detail composed from existing operational authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "project_id",
    "content",
    "content_hash",
    "read_at"
  ],
  "properties": {
    "schema_name": { "const": "petra.project-work-view" },
    "schema_version": { "const": "1.0.0" },
    "project_id": { "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId" },
    "content": {
      "oneOf": [
        { "$ref": "#/$defs/CollectionContent" },
        { "$ref": "#/$defs/DetailContent" }
      ]
    },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "read_at": { "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp" }
  },
  "$defs": {
    "DefinitionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_definition_id",
        "revision",
        "content_hash",
        "definition_family"
      ],
      "properties": {
        "project_definition_id": {
          "type": "string",
          "pattern": "^project_definition_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "definition_family": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{2,127}$"
        }
      }
    },
    "WorkUnitRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_unit_id", "revision", "spec_hash", "record_hash"],
      "properties": {
        "work_unit_id": {
          "$ref": "../../worker-input-manifest/1.0.0/schema.json#/$defs/WorkUnitId"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "spec_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "ContentRecordRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "revision", "content_hash", "record_hash"],
      "properties": {
        "record_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "AuthorityPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isolation", "event_position", "stream_revision"],
      "properties": {
        "isolation": { "const": "repeatable_read" },
        "event_position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stream_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "WorkflowSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_name",
        "workflow_version",
        "task_family",
        "task_name",
        "task_version"
      ],
      "properties": {
        "workflow_name": {
          "$ref": "../../worker-input-manifest/1.0.0/schema.json#/$defs/NamespacedName"
        },
        "workflow_version": {
          "$ref": "../../worker-input-manifest/1.0.0/schema.json#/$defs/Version"
        },
        "task_family": {
          "$ref": "../../worker-input-manifest/1.0.0/schema.json#/$defs/TaskDescriptor/properties/task_family"
        },
        "task_name": {
          "$ref": "../../worker-input-manifest/1.0.0/schema.json#/$defs/NamespacedName"
        },
        "task_version": {
          "$ref": "../../worker-input-manifest/1.0.0/schema.json#/$defs/Version"
        }
      }
    },
    "ExecutionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "attempt", "requested_at", "updated_at"],
      "properties": {
        "state": {
          "enum": [
            "requested",
            "queued",
            "running",
            "checkpointed",
            "completed",
            "cancelled"
          ]
        },
        "terminal_outcome": {
          "enum": [
            "succeeded",
            "worker_failed",
            "validation_failed",
            "resource_exhausted",
            "timed_out",
            "cancelled"
          ]
        },
        "attempt": { "type": "integer", "minimum": 0, "maximum": 100 },
        "requested_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        },
        "queued_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        },
        "started_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        },
        "finished_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        },
        "failure": {
          "$ref": "../../work-unit/1.0.0/schema.json#/$defs/Failure"
        }
      }
    },
    "AttentionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason_code", "reason"],
      "properties": {
        "state": { "enum": ["needs_attention", "active", "settled"] },
        "reason_code": {
          "enum": [
            "requested",
            "queued",
            "running",
            "retryable_failure",
            "terminal_failure",
            "completed",
            "cancelled"
          ]
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "ElapsedSummary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "milliseconds", "basis"],
          "properties": {
            "state": { "const": "measured" },
            "milliseconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "basis": {
              "enum": ["start_to_observation", "start_to_terminal"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reason"],
          "properties": {
            "state": { "const": "unavailable" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        }
      ]
    },
    "TaskSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_unit_ref",
        "task_label",
        "objective",
        "work_mode",
        "priority",
        "workflow",
        "execution",
        "attention",
        "elapsed",
        "resource_coverage",
        "reported_output_count",
        "stage_plan",
        "destination"
      ],
      "properties": {
        "work_unit_ref": { "$ref": "#/$defs/WorkUnitRef" },
        "task_label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "objective": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "work_mode": {
          "enum": ["interactive", "foreground", "background", "batch"]
        },
        "priority": {
          "enum": ["user_blocking", "user_visible", "normal", "opportunistic"]
        },
        "workflow": { "$ref": "#/$defs/WorkflowSummary" },
        "execution": { "$ref": "#/$defs/ExecutionSummary" },
        "attention": { "$ref": "#/$defs/AttentionSummary" },
        "elapsed": { "$ref": "#/$defs/ElapsedSummary" },
        "resource_coverage": { "enum": ["limits_only", "measured"] },
        "reported_output_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "stage_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reason"],
          "properties": {
            "state": { "const": "unavailable" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        },
        "destination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "target_ref"],
          "properties": {
            "role": { "const": "work" },
            "target_ref": { "$ref": "#/$defs/WorkUnitRef" }
          }
        }
      }
    },
    "CollectionQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit"],
      "properties": {
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "cursor": { "type": "string", "pattern": "^offset:[0-9]{1,9}$" },
        "state": {
          "enum": [
            "requested",
            "queued",
            "running",
            "checkpointed",
            "completed",
            "cancelled"
          ]
        }
      }
    },
    "Page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["returned_count", "total_count", "has_more"],
      "properties": {
        "returned_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "total_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "has_more": { "type": "boolean" },
        "next_cursor": { "type": "string", "pattern": "^offset:[0-9]{1,9}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "has_more": { "const": true } } },
          "then": {
            "properties": {
              "next_cursor": {
                "type": "string",
                "pattern": "^offset:[0-9]{1,9}$"
              }
            },
            "required": ["next_cursor"]
          },
          "else": { "properties": { "next_cursor": false } }
        }
      ]
    },
    "CollectionContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_kind",
        "project_definition_ref",
        "query",
        "tasks",
        "page",
        "authority"
      ],
      "properties": {
        "view_kind": { "const": "collection" },
        "project_definition_ref": { "$ref": "#/$defs/DefinitionRef" },
        "query": { "$ref": "#/$defs/CollectionQuery" },
        "tasks": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/TaskSummary" }
        },
        "page": { "$ref": "#/$defs/Page" },
        "authority": { "$ref": "#/$defs/AuthorityPosition" }
      }
    },
    "DependencySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_unit_ref", "state"],
      "properties": {
        "work_unit_ref": { "$ref": "#/$defs/WorkUnitRef" },
        "state": {
          "enum": [
            "requested",
            "queued",
            "running",
            "checkpointed",
            "completed",
            "cancelled"
          ]
        },
        "terminal_outcome": {
          "enum": [
            "succeeded",
            "worker_failed",
            "validation_failed",
            "resource_exhausted",
            "timed_out",
            "cancelled"
          ]
        }
      }
    },
    "SpecificationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_manifest_ref",
        "task",
        "worker",
        "inputs",
        "expected_outputs",
        "network_policy",
        "partial_result_policy",
        "cache_mode",
        "cancellation_policy",
        "checkpoint_policy"
      ],
      "properties": {
        "input_manifest_ref": { "$ref": "#/$defs/ContentRecordRef" },
        "task": {
          "$ref": "../../worker-input-manifest/1.0.0/schema.json#/$defs/TaskDescriptor"
        },
        "worker": {
          "$ref": "../../worker-input-manifest/1.0.0/schema.json#/$defs/WorkerDescriptor"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "$ref": "../../worker-input-manifest/1.0.0/schema.json#/$defs/InputBinding"
          }
        },
        "expected_outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "../../worker-input-manifest/1.0.0/schema.json#/$defs/ExpectedOutput"
          }
        },
        "network_policy": {
          "$ref": "../../worker-input-manifest/1.0.0/schema.json#/$defs/NetworkPolicy"
        },
        "partial_result_policy": {
          "enum": ["discard", "retain_declared", "retain_diagnostics"]
        },
        "cache_mode": { "enum": ["reuse_exact", "refresh", "disabled"] },
        "cancellation_policy": {
          "enum": ["cancellable", "checkpoint_then_cancel", "atomic"]
        },
        "checkpoint_policy": {
          "enum": ["disabled", "latest_valid", "all_valid"]
        },
        "deadline_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        }
      }
    },
    "MeasuredUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "output_manifest_ref", "resource_usage"],
      "properties": {
        "state": { "const": "measured" },
        "output_manifest_ref": { "$ref": "#/$defs/ContentRecordRef" },
        "resource_usage": {
          "$ref": "../../worker-output-manifest/1.0.0/schema.json#/$defs/ResourceUsage"
        }
      }
    },
    "UnavailableUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": { "const": "unavailable" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "ResourceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limits", "usage"],
      "properties": {
        "limits": {
          "$ref": "../../worker-input-manifest/1.0.0/schema.json#/$defs/ResourceLimits"
        },
        "usage": {
          "oneOf": [
            { "$ref": "#/$defs/MeasuredUsage" },
            { "$ref": "#/$defs/UnavailableUsage" }
          ]
        }
      }
    },
    "ReportedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaration",
        "report_state",
        "produced_output",
        "availability"
      ],
      "properties": {
        "declaration": {
          "$ref": "../../worker-input-manifest/1.0.0/schema.json#/$defs/ExpectedOutput"
        },
        "report_state": { "const": "reported" },
        "produced_output": {
          "$ref": "../../worker-output-manifest/1.0.0/schema.json#/$defs/ProducedOutput"
        },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "limitation"],
          "properties": {
            "state": { "const": "staged_handle_only" },
            "limitation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        }
      }
    },
    "UnreportedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaration", "report_state", "availability"],
      "properties": {
        "declaration": {
          "$ref": "../../worker-input-manifest/1.0.0/schema.json#/$defs/ExpectedOutput"
        },
        "report_state": { "const": "not_reported" },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "limitation"],
          "properties": {
            "state": { "const": "unavailable" },
            "limitation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        }
      }
    },
    "OutputSummary": {
      "oneOf": [
        { "$ref": "#/$defs/ReportedOutput" },
        { "$ref": "#/$defs/UnreportedOutput" }
      ]
    },
    "ControlSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_name",
        "policy_state",
        "operation_state",
        "reason",
        "consequence"
      ],
      "properties": {
        "control_name": { "enum": ["cancel", "retry", "resume"] },
        "policy_state": {
          "enum": ["permitted", "forbidden", "not_applicable", "unresolved"]
        },
        "operation_state": { "const": "unavailable" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "consequence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "UnavailableLinkage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": { "const": "unavailable" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "CoverageItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area", "state"],
      "properties": {
        "area": {
          "enum": [
            "identity",
            "execution",
            "inputs",
            "dependencies",
            "stages",
            "resources",
            "outputs",
            "controls",
            "inquiries",
            "review",
            "recovery"
          ]
        },
        "state": { "enum": ["complete", "partial", "unavailable"] },
        "limitation": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "DetailContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_kind",
        "project_definition_ref",
        "summary",
        "specification",
        "dependencies",
        "stage_plan",
        "resources",
        "outputs",
        "controls",
        "inquiry_linkage",
        "review",
        "semantic_location",
        "coverage",
        "authority"
      ],
      "properties": {
        "view_kind": { "const": "detail" },
        "project_definition_ref": { "$ref": "#/$defs/DefinitionRef" },
        "summary": { "$ref": "#/$defs/TaskSummary" },
        "specification": { "$ref": "#/$defs/SpecificationSummary" },
        "dependencies": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/DependencySummary" }
        },
        "stage_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reason"],
          "properties": {
            "state": { "const": "unavailable" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        },
        "resources": { "$ref": "#/$defs/ResourceSummary" },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/OutputSummary" }
        },
        "controls": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ControlSummary" }
        },
        "inquiry_linkage": { "$ref": "#/$defs/UnavailableLinkage" },
        "review": { "$ref": "#/$defs/UnavailableLinkage" },
        "semantic_location": {
          "$ref": "../../project-object-location-view/1.0.0/schema.json#/$defs/LocationContent"
        },
        "coverage": {
          "type": "array",
          "minItems": 1,
          "maxItems": 11,
          "items": { "$ref": "#/$defs/CoverageItem" }
        },
        "authority": { "$ref": "#/$defs/AuthorityPosition" }
      }
    }
  }
}
