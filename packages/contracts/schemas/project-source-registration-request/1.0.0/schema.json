{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-source-registration-request/1.0.0/schema.json",
  "title": "PetraProjectSourceRegistrationRequest",
  "description": "An exact reviewed request to register new user-supplied source bytes, immutable scholarly identity, copy-specific rights, and one Project membership. Actor, capability grant, authority identities, storage location, and record timestamps are server-owned.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "command_id",
    "idempotency_key",
    "expected",
    "source_identity",
    "material",
    "rights",
    "project_membership"
  ],
  "properties": {
    "schema_name": {
      "const": "petra.project-source-registration-request"
    },
    "schema_version": { "const": "1.0.0" },
    "command_id": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        { "type": "string", "pattern": "^command_" }
      ]
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "expected": { "$ref": "#/$defs/Expected" },
    "source_identity": { "$ref": "#/$defs/SourceIdentity" },
    "material": { "$ref": "#/$defs/Material" },
    "rights": { "$ref": "#/$defs/Rights" },
    "project_membership": { "$ref": "#/$defs/ProjectMembership" }
  },
  "$defs": {
    "ProjectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "revision", "record_hash"],
      "properties": {
        "project_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "DefinitionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_definition_id",
        "revision",
        "content_hash",
        "record_hash"
      ],
      "properties": {
        "project_definition_id": {
          "type": "string",
          "pattern": "^project_definition_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "Expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_ref", "project_definition_ref"],
      "properties": {
        "project_ref": { "$ref": "#/$defs/ProjectRef" },
        "project_definition_ref": { "$ref": "#/$defs/DefinitionRef" }
      }
    },
    "Author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "author_kind", "identity_status"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1, "maxLength": 400 },
        "author_kind": {
          "enum": ["person", "organization", "consortium"]
        },
        "identity_status": {
          "enum": ["resolved", "provisional", "disputed"]
        }
      }
    },
    "PublicationDate": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/PublicationDate"
    },
    "SourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "work_kind",
        "identity_status",
        "authors",
        "version_label",
        "publication_status",
        "metadata_source_name",
        "metadata_retrieved_at"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "work_kind": {
          "enum": [
            "journal_article",
            "conference_paper",
            "preprint",
            "thesis",
            "book",
            "chapter",
            "other"
          ]
        },
        "identity_status": {
          "enum": ["resolved", "provisional", "disputed"]
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/Author" }
        },
        "version_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "publication_status": {
          "enum": [
            "preprint",
            "peer_reviewed",
            "accepted",
            "corrected",
            "retracted",
            "unknown"
          ]
        },
        "published_date": { "$ref": "#/$defs/PublicationDate" },
        "metadata_source_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "metadata_source_record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "metadata_retrieved_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        }
      }
    },
    "Material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "content_base64",
        "expected_content_hash",
        "artifact_kind",
        "media_type",
        "original_filename"
      ],
      "properties": {
        "encoding": { "const": "base64" },
        "content_base64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 44739244,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "expected_content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "artifact_kind": {
          "enum": ["pdf", "html", "structured_text", "dataset", "code", "image"]
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9!#$&^_.+-]+/[a-zA-Z0-9!#$&^_.+-]+(?:;[ -~]+)?$",
          "maxLength": 300
        },
        "original_filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "Rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_location",
        "license_status",
        "access_basis",
        "decision_status",
        "permissions",
        "conditions",
        "required_notices",
        "rationale",
        "observed_at",
        "policy_version"
      ],
      "properties": {
        "source_location": {
          "type": "string",
          "format": "uri",
          "maxLength": 4000
        },
        "license_status": { "enum": ["known", "unknown", "restricted"] },
        "observed_license": {
          "$ref": "../../rights-decision/1.0.0/schema.json#/$defs/ObservedLicense"
        },
        "access_basis": {
          "enum": [
            "open_license",
            "public_repository",
            "subscription",
            "user_supplied",
            "permission",
            "unknown"
          ]
        },
        "decision_status": {
          "enum": [
            "verified",
            "inferred",
            "unknown",
            "conflicting",
            "restricted"
          ]
        },
        "permissions": {
          "$ref": "../../rights-decision/1.0.0/schema.json#/$defs/Permissions"
        },
        "conditions": {
          "type": "array",
          "items": {
            "enum": [
              "attribution",
              "notice",
              "noncommercial",
              "share_alike",
              "no_derivatives"
            ]
          },
          "uniqueItems": true,
          "maxItems": 5
        },
        "required_notices": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "uniqueItems": true,
          "maxItems": 100
        },
        "authorization_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "observed_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "ProjectMembership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "source_role", "reviewed_at"],
      "properties": {
        "decision": { "const": "register_and_link" },
        "source_role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._/-]{1,199}$"
        },
        "reviewed_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        }
      }
    }
  }
}
