{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-history-impact-view/1.0.0/schema.json",
  "title": "PetraProjectHistoryImpactView",
  "description": "An authorized, event-selected, read-only inventory of bounded direct dependents proven by Petra's registered immutable command, outbox, projection, and grounded-response invalidation bindings. It does not decide reversibility or compose compensation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "project_id",
    "event_id",
    "content",
    "content_hash",
    "read_at"
  ],
  "properties": {
    "schema_name": { "const": "petra.project-history-impact-view" },
    "schema_version": { "const": "1.0.0" },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "event_id": {
      "$ref": "../../domain-event/1.0.0/schema.json#/$defs/EventId"
    },
    "content": { "$ref": "#/$defs/ImpactContent" },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "read_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "EventAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_ref",
        "event_ref",
        "actor",
        "occurred_at",
        "recorded_at",
        "family",
        "targets",
        "observed_effect",
        "semantic_destination"
      ],
      "properties": {
        "command_ref": {
          "$ref": "../../project-history-view/1.0.0/schema.json#/$defs/CommandRef"
        },
        "event_ref": {
          "$ref": "../../project-history-view/1.0.0/schema.json#/$defs/EventRef"
        },
        "actor": {
          "$ref": "../../project-history-view/1.0.0/schema.json#/$defs/ActorRef"
        },
        "occurred_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        },
        "recorded_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        },
        "family": {
          "enum": [
            "change_control",
            "project_source_lifecycle",
            "project_source_replacement"
          ]
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "contains": {
            "type": "object",
            "properties": { "role": { "const": "primary" } },
            "required": ["role"]
          },
          "minContains": 1,
          "maxContains": 1,
          "items": {
            "$ref": "../../project-history-view/1.0.0/schema.json#/$defs/TargetRef"
          }
        },
        "observed_effect": {
          "$ref": "../../project-history-view/1.0.0/schema.json#/$defs/ObservedEffect"
        },
        "semantic_destination": {
          "$ref": "../../project-history-view/1.0.0/schema.json#/$defs/SemanticDestination"
        }
      }
    },
    "RecordedCausalCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_ref",
        "outcome",
        "completed_at",
        "event_state",
        "event_ref"
      ],
      "properties": {
        "command_ref": {
          "$ref": "../../project-history-view/1.0.0/schema.json#/$defs/CommandRef"
        },
        "outcome": { "enum": ["success", "failure"] },
        "completed_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        },
        "event_state": { "const": "recorded" },
        "event_ref": {
          "$ref": "../../project-history-view/1.0.0/schema.json#/$defs/EventRef"
        }
      }
    },
    "UnrecordedCausalCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_ref", "outcome", "completed_at", "event_state"],
      "properties": {
        "command_ref": {
          "$ref": "../../project-history-view/1.0.0/schema.json#/$defs/CommandRef"
        },
        "outcome": { "enum": ["success", "failure"] },
        "completed_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        },
        "event_state": { "const": "not_recorded" }
      }
    },
    "CausalCommand": {
      "oneOf": [
        { "$ref": "#/$defs/RecordedCausalCommand" },
        { "$ref": "#/$defs/UnrecordedCausalCommand" }
      ]
    },
    "OutboxRecordRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outbox_id",
        "schema_version",
        "outbox_position",
        "target",
        "target_sequence",
        "enqueued_at",
        "record_hash"
      ],
      "properties": {
        "outbox_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
        },
        "schema_version": {
          "enum": ["1.0.0", "1.1.0", "1.2.0", "1.3.0"]
        },
        "outbox_position": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "target": { "enum": ["neo4j_graph", "interface_authority"] },
        "target_sequence": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "enqueued_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "GraphProjectionRecordRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_projection_record_id",
        "revision",
        "content_hash",
        "record_hash",
        "outbox_id",
        "outbox_position",
        "target_sequence",
        "attempt",
        "outcome",
        "recorded_at"
      ],
      "properties": {
        "graph_projection_record_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
        },
        "revision": { "const": 1 },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "outbox_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
        },
        "outbox_position": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "target_sequence": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 100 },
        "outcome": { "enum": ["applied", "failed"] },
        "recorded_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        }
      }
    },
    "GroundedResponseInvalidationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grounded_response_id",
        "revision",
        "content_hash",
        "record_hash",
        "posture",
        "cache_state",
        "invalidation_position",
        "change_set_id",
        "recorded_at"
      ],
      "properties": {
        "grounded_response_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "posture": { "enum": ["current", "historical"] },
        "cache_state": { "const": "invalidated" },
        "invalidation_position": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "change_set_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
        },
        "recorded_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        }
      }
    },
    "BoundedGroupBase": {
      "type": "object",
      "required": ["total_count", "returned_count", "coverage"],
      "properties": {
        "total_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "returned_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "coverage": { "enum": ["complete", "truncated"] }
      }
    },
    "CausalCommandGroup": {
      "allOf": [
        { "$ref": "#/$defs/BoundedGroupBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relation",
            "authority_source",
            "total_count",
            "returned_count",
            "coverage",
            "refs"
          ],
          "properties": {
            "relation": { "const": "caused_by_selected_command" },
            "authority_source": {
              "const": "immutable_command_causation"
            },
            "total_count": {},
            "returned_count": {},
            "coverage": {},
            "refs": {
              "type": "array",
              "maxItems": 100,
              "items": { "$ref": "#/$defs/CausalCommand" }
            }
          }
        }
      ]
    },
    "OutboxGroup": {
      "allOf": [
        { "$ref": "#/$defs/BoundedGroupBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relation",
            "authority_source",
            "total_count",
            "returned_count",
            "coverage",
            "refs"
          ],
          "properties": {
            "relation": { "const": "carries_selected_event" },
            "authority_source": {
              "const": "immutable_event_outbox_binding"
            },
            "total_count": {},
            "returned_count": {},
            "coverage": {},
            "refs": {
              "type": "array",
              "maxItems": 100,
              "items": { "$ref": "#/$defs/OutboxRecordRef" }
            }
          }
        }
      ]
    },
    "ProjectionGroup": {
      "allOf": [
        { "$ref": "#/$defs/BoundedGroupBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relation",
            "authority_source",
            "total_count",
            "returned_count",
            "coverage",
            "refs"
          ],
          "properties": {
            "relation": { "const": "projects_selected_event" },
            "authority_source": {
              "const": "immutable_projection_event_binding"
            },
            "total_count": {},
            "returned_count": {},
            "coverage": {},
            "refs": {
              "type": "array",
              "maxItems": 100,
              "items": { "$ref": "#/$defs/GraphProjectionRecordRef" }
            }
          }
        }
      ]
    },
    "GroundedResponseGroup": {
      "allOf": [
        { "$ref": "#/$defs/BoundedGroupBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relation",
            "authority_source",
            "total_count",
            "returned_count",
            "coverage",
            "refs"
          ],
          "properties": {
            "relation": { "const": "invalidated_by_selected_event" },
            "authority_source": {
              "const": "immutable_response_invalidation_binding"
            },
            "total_count": {},
            "returned_count": {},
            "coverage": {},
            "refs": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/GroundedResponseInvalidationRef"
              }
            }
          }
        }
      ]
    },
    "AuthorityPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isolation",
        "through_event_position",
        "through_stream_revision"
      ],
      "properties": {
        "isolation": { "const": "repeatable_read" },
        "through_event_position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "through_stream_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "ImpactSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registered_group_count", "total_count", "coverage"],
      "properties": {
        "registered_group_count": { "const": 4 },
        "total_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000000
        },
        "coverage": { "enum": ["complete", "truncated"] }
      }
    },
    "Impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "summary",
        "causal_commands",
        "outbox_records",
        "graph_projection_records",
        "grounded_response_invalidations",
        "unknowns"
      ],
      "properties": {
        "scope": { "const": "registered_direct_event_and_command_dependents" },
        "summary": { "$ref": "#/$defs/ImpactSummary" },
        "causal_commands": { "$ref": "#/$defs/CausalCommandGroup" },
        "outbox_records": { "$ref": "#/$defs/OutboxGroup" },
        "graph_projection_records": { "$ref": "#/$defs/ProjectionGroup" },
        "grounded_response_invalidations": {
          "$ref": "#/$defs/GroundedResponseGroup"
        },
        "unknowns": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "unregistered_profile_specific_dependencies_may_exist",
              "transitive_dependents_may_exist",
              "external_system_dependents_are_not_observable"
            ]
          }
        }
      }
    },
    "DecisionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reversibility", "compensation", "dependent_effect"],
      "properties": {
        "reversibility": { "const": "not_assessed" },
        "compensation": { "const": "not_composed" },
        "dependent_effect": { "const": "not_inferred_from_reference" }
      }
    },
    "ImpactContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_kind",
        "selected_event",
        "authorization_scope",
        "impact",
        "decision_boundary",
        "authority",
        "omissions",
        "graph_navigation_history"
      ],
      "properties": {
        "view_kind": { "const": "dependency_impact" },
        "selected_event": { "$ref": "#/$defs/EventAnchor" },
        "authorization_scope": { "const": "authenticated_project" },
        "impact": { "$ref": "#/$defs/Impact" },
        "decision_boundary": { "$ref": "#/$defs/DecisionBoundary" },
        "authority": { "$ref": "#/$defs/AuthorityPosition" },
        "omissions": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "semantic_target_dependencies_not_composed",
              "transitive_dependency_closure_not_composed",
              "reversibility_not_assessed",
              "compensation_not_composed",
              "historical_project_definition_not_interpreted",
              "cross_family_total_order_not_asserted"
            ]
          }
        },
        "graph_navigation_history": { "const": "client_local_separate" }
      }
    }
  }
}
