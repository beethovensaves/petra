{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-thread/1.1.0/schema.json",
  "title": "PetraProjectThreadV11",
  "description": "An additive canonical ProjectThread revision retaining native conversational outcomes, including failed and cancelled deliveries, without treating them as findings or changing existing immutable version 1.0 turns.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "project_thread_id",
    "revision",
    "project_id",
    "project_definition_ref",
    "lineage",
    "content",
    "content_hash",
    "created_by",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_name": {
      "const": "petra.project-thread"
    },
    "schema_version": {
      "const": "1.1.0"
    },
    "project_thread_id": {
      "$ref": "#/$defs/ProjectThreadId"
    },
    "revision": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
    },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "project_definition_ref": {
      "$ref": "#/$defs/DefinitionRef"
    },
    "lineage": {
      "$ref": "#/$defs/RevisionLineage"
    },
    "content": {
      "$ref": "#/$defs/ThreadContent"
    },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "created_by": {
      "$ref": "#/$defs/HumanActorRef"
    },
    "created_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    },
    "updated_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "ProjectThreadId": {
      "allOf": [
        {
          "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
        },
        {
          "type": "string",
          "pattern": "^project_thread_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      ]
    },
    "ProjectTurnId": {
      "allOf": [
        {
          "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
        },
        {
          "type": "string",
          "pattern": "^project_turn_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      ]
    },
    "HumanActorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "actor_kind"],
      "properties": {
        "actor_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ActorId"
        },
        "actor_kind": {
          "const": "human"
        }
      }
    },
    "DefinitionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_definition_id",
        "revision",
        "content_hash",
        "definition_family"
      ],
      "properties": {
        "project_definition_id": {
          "type": "string",
          "pattern": "^project_definition_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "definition_family": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{2,127}$"
        }
      }
    },
    "ObjectiveRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective_id", "revision", "content_hash"],
      "properties": {
        "objective_id": {
          "type": "string",
          "pattern": "^objective_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "ThreadRevisionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_thread_id", "revision", "content_hash"],
      "properties": {
        "project_thread_id": {
          "$ref": "#/$defs/ProjectThreadId"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "RevisionLineage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["lineage_kind"],
          "properties": {
            "lineage_kind": {
              "const": "root"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["lineage_kind", "parent_revision", "parent_hash"],
          "properties": {
            "lineage_kind": {
              "const": "revision"
            },
            "parent_revision": {
              "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
            },
            "parent_hash": {
              "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
            }
          }
        }
      ]
    },
    "ThreadOrigin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["origin_kind"],
          "properties": {
            "origin_kind": {
              "const": "root"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin_kind",
            "parent_thread_ref",
            "parent_turn_id",
            "continuation_mode"
          ],
          "properties": {
            "origin_kind": {
              "const": "branch"
            },
            "parent_thread_ref": {
              "$ref": "#/$defs/ThreadRevisionRef"
            },
            "parent_turn_id": {
              "$ref": "#/$defs/ProjectTurnId"
            },
            "continuation_mode": {
              "enum": [
                "original_snapshot",
                "current_snapshot",
                "compare_then_continue"
              ]
            }
          }
        }
      ]
    },
    "ExactArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "content_hash", "byte_size", "media_type"],
      "properties": {
        "artifact_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ArtifactId"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "byte_size": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ByteSize"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "ExactTypedRecordRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_name",
        "schema_version",
        "record_id",
        "revision",
        "content_hash"
      ],
      "properties": {
        "schema_name": {
          "type": "string",
          "pattern": "^petra\\.[a-z][a-z0-9.-]{1,127}$"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "record_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "HashOnlyInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retention_state",
        "input_hash",
        "source_message_id",
        "limitation"
      ],
      "properties": {
        "retention_state": {
          "const": "hash_only"
        },
        "input_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "source_message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "limitation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "RetainedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retention_state",
        "input_hash",
        "source_message_id",
        "artifact_ref"
      ],
      "properties": {
        "retention_state": {
          "const": "retained_artifact"
        },
        "input_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "source_message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "artifact_ref": {
          "$ref": "#/$defs/ExactArtifactRef"
        }
      }
    },
    "TurnInput": {
      "oneOf": [
        {
          "$ref": "#/$defs/HashOnlyInput"
        },
        {
          "$ref": "#/$defs/RetainedInput"
        }
      ]
    },
    "ContextBinding": {
      "oneOf": [
        {
          "$ref": "#/$defs/SnapshotContextBinding"
        },
        {
          "$ref": "#/$defs/NativeConversationContextBinding"
        }
      ]
    },
    "ExecutionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interaction_run_ref", "work_unit_ref"],
      "properties": {
        "interaction_run_ref": {
          "$ref": "../../interaction-event-record/1.0.0/schema.json#/$defs/InteractionRunRef"
        },
        "work_unit_ref": {
          "$ref": "../../interaction-run/1.0.0/schema.json#/$defs/WorkUnitRef"
        }
      }
    },
    "UnavailablePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": {
          "const": "unavailable"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "AuthorityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "capability_grant_id",
        "privacy_profile_ref",
        "budget_profile_ref",
        "review_policy"
      ],
      "properties": {
        "actor": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ActorRef"
        },
        "capability_grant_id": {
          "type": "string",
          "pattern": "^capability_grant_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "privacy_profile_ref": {
          "$ref": "../../interaction-run/1.0.0/schema.json#/$defs/VersionedControlRef"
        },
        "budget_profile_ref": {
          "$ref": "../../interaction-run/1.0.0/schema.json#/$defs/VersionedControlRef"
        },
        "review_policy": {
          "$ref": "#/$defs/UnavailablePolicy"
        }
      }
    },
    "CompletedResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "result_record_ref",
        "response_artifact_ref",
        "force",
        "authority_effect"
      ],
      "properties": {
        "state": {
          "enum": ["completed", "failed", "cancelled"]
        },
        "result_record_ref": {
          "$ref": "#/$defs/ExactTypedRecordRef"
        },
        "response_artifact_ref": {
          "$ref": "#/$defs/ExactArtifactRef"
        },
        "force": {
          "enum": ["explanation_only", "work_update", "proposal"]
        },
        "authority_effect": {
          "const": "none"
        }
      },
      "description": "A retained terminal conversational result. The result owner preserves its exact native meaning; completed denotes successful delivery, not domain warrant or approved authority."
    },
    "UnmodifiedCompaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "const": "unmodified"
        }
      }
    },
    "CompactedContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "summary_artifact_ref",
        "covered_through_sequence",
        "method_ref"
      ],
      "properties": {
        "state": {
          "const": "compacted"
        },
        "summary_artifact_ref": {
          "$ref": "#/$defs/ExactArtifactRef"
        },
        "covered_through_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "method_ref": {
          "$ref": "#/$defs/ExactTypedRecordRef"
        }
      }
    },
    "Turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_turn_id",
        "sequence",
        "project_definition_ref",
        "input",
        "context",
        "execution",
        "authority_context",
        "response",
        "compaction",
        "proposal_decision_linkage",
        "presentation_context",
        "recorded_at"
      ],
      "properties": {
        "project_turn_id": {
          "$ref": "#/$defs/ProjectTurnId"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "previous_turn_id": {
          "$ref": "#/$defs/ProjectTurnId"
        },
        "project_definition_ref": {
          "$ref": "#/$defs/DefinitionRef"
        },
        "objective_ref": {
          "$ref": "#/$defs/ObjectiveRef"
        },
        "input": {
          "$ref": "#/$defs/TurnInput"
        },
        "context": {
          "$ref": "#/$defs/ContextBinding"
        },
        "execution": {
          "$ref": "#/$defs/ExecutionBinding"
        },
        "authority_context": {
          "$ref": "#/$defs/AuthorityContext"
        },
        "response": {
          "$ref": "#/$defs/CompletedResponse"
        },
        "compaction": {
          "oneOf": [
            {
              "$ref": "#/$defs/UnmodifiedCompaction"
            },
            {
              "$ref": "#/$defs/CompactedContext"
            }
          ]
        },
        "proposal_decision_linkage": {
          "$ref": "#/$defs/UnavailablePolicy"
        },
        "presentation_context": {
          "$ref": "#/$defs/UnavailablePolicy"
        },
        "recorded_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        }
      }
    },
    "Retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "limitation"],
      "properties": {
        "state": {
          "const": "retained"
        },
        "limitation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "ThreadContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "task",
        "lifecycle",
        "origin",
        "turns",
        "retention"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "lifecycle": {
          "enum": ["open", "archived"]
        },
        "origin": {
          "$ref": "#/$defs/ThreadOrigin"
        },
        "turns": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/Turn"
          }
        },
        "retention": {
          "$ref": "#/$defs/Retention"
        }
      }
    },
    "SnapshotContextBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_record_ref",
        "snapshot_ref",
        "included_object_count",
        "omission_count",
        "coverage_state",
        "coverage_statement"
      ],
      "properties": {
        "context_record_ref": {
          "$ref": "#/$defs/ExactTypedRecordRef"
        },
        "snapshot_ref": {
          "$ref": "../../context-packet/1.0.0/schema.json#/$defs/SnapshotRef"
        },
        "included_object_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "omission_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "coverage_state": {
          "enum": ["complete_for_recipe", "bounded", "partial", "unknown"]
        },
        "coverage_statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "NativeConversationContextBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_record_ref",
        "basis",
        "included_object_count",
        "omission_count",
        "coverage_state",
        "coverage_statement"
      ],
      "properties": {
        "context_record_ref": {
          "$ref": "#/$defs/ExactTypedRecordRef"
        },
        "basis": {
          "$ref": "../../copilot-context/1.0.0/schema.json#/properties/basis"
        },
        "included_object_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "omission_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            {
              "type": "null"
            }
          ],
          "description": "Unknown when the original bounded native context records limitations without an exhaustive machine-counted omission inventory."
        },
        "coverage_state": {
          "enum": ["complete_for_recipe", "bounded", "partial", "unknown"]
        },
        "coverage_statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  }
}
