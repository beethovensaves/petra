{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/model-role-certification/1.0.0/schema.json",
  "title": "PetraModelRoleCertification",
  "description": "An immutable decision about one model deployment's eligibility for one bounded Petra role under a named evaluation snapshot. Certification is routing evidence, not scientific authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "role_certification_id",
    "revision",
    "deployment",
    "role_profile",
    "scope",
    "evaluation",
    "decision",
    "content_hash",
    "certified_by",
    "certified_at"
  ],
  "properties": {
    "schema_name": { "const": "petra.model-role-certification" },
    "schema_version": { "const": "1.0.0" },
    "role_certification_id": { "$ref": "#/$defs/RoleCertificationId" },
    "revision": { "const": 1 },
    "deployment": { "$ref": "#/$defs/DeploymentSnapshot" },
    "role_profile": { "$ref": "#/$defs/RoleProfileSnapshot" },
    "scope": { "$ref": "#/$defs/CertificationScope" },
    "evaluation": { "$ref": "#/$defs/Evaluation" },
    "decision": { "$ref": "#/$defs/Decision" },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "certified_by": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ActorRef"
    },
    "certified_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "RoleCertificationId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        { "type": "string", "pattern": "^role_certification_" }
      ]
    },
    "DeploymentSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_deployment_id",
        "provider_id",
        "provider_kind",
        "provider_model",
        "observed_revision",
        "replayability",
        "execution_location",
        "structured_output",
        "max_context_tokens"
      ],
      "properties": {
        "model_deployment_id": { "$ref": "#/$defs/ModelDeploymentId" },
        "provider_id": { "$ref": "#/$defs/ProviderId" },
        "provider_kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,99}$"
        },
        "provider_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "observed_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "replayability": { "enum": ["exact", "best_effort", "unavailable"] },
        "execution_location": { "enum": ["local", "remote"] },
        "structured_output": { "type": "boolean" },
        "max_context_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "RoleProfileSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_profile_id",
        "role",
        "version",
        "input_contract",
        "output_contract",
        "required_validators"
      ],
      "properties": {
        "role_profile_id": { "$ref": "#/$defs/RoleProfileId" },
        "role": { "const": "extractor" },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "input_contract": { "$ref": "#/$defs/ContractRef" },
        "output_contract": { "$ref": "#/$defs/ContractRef" },
        "required_validators": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "CertificationScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "language", "modality", "document_class"],
      "properties": {
        "domain": { "type": "string", "minLength": 1, "maxLength": 200 },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "modality": { "const": "text" },
        "document_class": { "enum": ["peer_reviewed", "preprint", "scholarly"] }
      }
    },
    "Evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite",
        "dataset_snapshot_hash",
        "prompt_profile",
        "cases_total",
        "cases_passed",
        "metrics",
        "observed_errors"
      ],
      "properties": {
        "suite": {
          "$ref": "../../parsed-document/1.0.0/schema.json#/$defs/VersionedComponent"
        },
        "dataset_snapshot_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "prompt_profile": { "$ref": "#/$defs/PromptProfile" },
        "cases_total": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "cases_passed": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/Metric" }
        },
        "observed_errors": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/ObservedError" }
        }
      }
    },
    "PromptProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "content_hash"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "Metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "unit", "direction"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,99}$" },
        "value": { "type": "number" },
        "unit": { "enum": ["count", "ratio", "milliseconds", "usd"] },
        "direction": {
          "enum": ["higher_is_better", "lower_is_better", "descriptive"]
        }
      }
    },
    "ObservedError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "count"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
        "count": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "Decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "valid_from", "invalidation_conditions"],
      "properties": {
        "status": { "enum": ["active", "failed", "invalidated", "expired"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "valid_from": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        },
        "expires_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        },
        "invalidation_conditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "ContractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_name", "schema_version", "schema_hash"],
      "properties": {
        "schema_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,99}$"
        },
        "schema_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "schema_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "ModelDeploymentId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        { "type": "string", "pattern": "^model_deployment_" }
      ]
    },
    "ProviderId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        { "type": "string", "pattern": "^provider_" }
      ]
    },
    "RoleProfileId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        { "type": "string", "pattern": "^role_profile_" }
      ]
    }
  }
}
