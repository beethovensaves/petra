{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/interaction-interrupt/1.0.0/schema.json",
  "title": "PetraInteractionInterrupt",
  "description": "A revisioned request for researcher input and its exact linkage to a separate Petra command proposal. An interrupt response never applies authority directly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "interaction_interrupt_id",
    "revision",
    "project_id",
    "interaction_run_ref",
    "lineage",
    "content",
    "content_hash",
    "recorded_by",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_name": { "const": "petra.interaction-interrupt" },
    "schema_version": { "const": "1.0.0" },
    "interaction_interrupt_id": {
      "$ref": "#/$defs/InteractionInterruptId"
    },
    "revision": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
    },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "interaction_run_ref": { "$ref": "#/$defs/InteractionRunRef" },
    "lineage": { "$ref": "#/$defs/InterruptLineage" },
    "content": { "$ref": "#/$defs/InterruptContent" },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "recorded_by": { "$ref": "#/$defs/ServiceActorRef" },
    "created_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    },
    "updated_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "InteractionInterruptId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        {
          "type": "string",
          "pattern": "^interaction_interrupt_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      ]
    },
    "InteractionRunId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        {
          "type": "string",
          "pattern": "^interaction_run_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      ]
    },
    "InteractionEventRecordId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        {
          "type": "string",
          "pattern": "^interaction_event_record_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      ]
    },
    "InteractionRunRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interaction_run_id", "revision", "content_hash"],
      "properties": {
        "interaction_run_id": { "$ref": "#/$defs/InteractionRunId" },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "EventRecordRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interaction_event_record_id", "sequence", "content_hash"],
      "properties": {
        "interaction_event_record_id": {
          "$ref": "#/$defs/InteractionEventRecordId"
        },
        "sequence": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "ServiceActorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "actor_kind"],
      "properties": {
        "actor_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ActorId"
        },
        "actor_kind": { "const": "service" }
      }
    },
    "InterruptLineage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["lineage_kind"],
          "properties": { "lineage_kind": { "const": "root" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["lineage_kind", "parent_revision", "parent_hash"],
          "properties": {
            "lineage_kind": { "const": "revision" },
            "parent_revision": {
              "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
            },
            "parent_hash": {
              "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
            }
          }
        }
      ]
    },
    "InterruptContent": {
      "oneOf": [
        { "$ref": "#/$defs/PendingInterrupt" },
        { "$ref": "#/$defs/RespondedInterrupt" },
        { "$ref": "#/$defs/ClosedInterrupt" }
      ]
    },
    "PendingInterrupt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "interrupt_kind",
        "request_event_ref",
        "subject_refs",
        "prompt_artifact_ref",
        "response_schema_ref",
        "authority_effect"
      ],
      "properties": {
        "state": { "const": "pending" },
        "interrupt_kind": { "$ref": "#/$defs/InterruptKind" },
        "request_event_ref": { "$ref": "#/$defs/EventRecordRef" },
        "subject_refs": { "$ref": "#/$defs/SubjectRefs" },
        "prompt_artifact_ref": { "$ref": "#/$defs/PayloadArtifactRef" },
        "response_schema_ref": { "$ref": "#/$defs/SchemaRef" },
        "authority_effect": { "const": "none" }
      }
    },
    "RespondedInterrupt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "interrupt_kind",
        "request_event_ref",
        "subject_refs",
        "response_artifact_ref",
        "responded_by",
        "resulting_command_ref",
        "authority_effect"
      ],
      "properties": {
        "state": { "const": "responded" },
        "interrupt_kind": { "$ref": "#/$defs/InterruptKind" },
        "request_event_ref": { "$ref": "#/$defs/EventRecordRef" },
        "subject_refs": { "$ref": "#/$defs/SubjectRefs" },
        "response_artifact_ref": { "$ref": "#/$defs/PayloadArtifactRef" },
        "responded_by": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ActorRef"
        },
        "resulting_command_ref": { "$ref": "#/$defs/CommandRef" },
        "authority_effect": { "const": "command_input_only" }
      }
    },
    "ClosedInterrupt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "interrupt_kind",
        "request_event_ref",
        "subject_refs",
        "close_reason",
        "authority_effect"
      ],
      "properties": {
        "state": { "const": "closed_without_response" },
        "interrupt_kind": { "$ref": "#/$defs/InterruptKind" },
        "request_event_ref": { "$ref": "#/$defs/EventRecordRef" },
        "subject_refs": { "$ref": "#/$defs/SubjectRefs" },
        "close_reason": { "enum": ["expired", "withdrawn", "superseded"] },
        "authority_effect": { "const": "none" }
      }
    },
    "InterruptKind": {
      "enum": [
        "clarification",
        "review",
        "approval",
        "correction",
        "budget_escalation"
      ]
    },
    "SubjectRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
      }
    },
    "PayloadArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "content_sha256", "byte_size", "media_type"],
      "properties": {
        "artifact_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ArtifactId"
        },
        "content_sha256": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "byte_size": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ByteSize"
        },
        "media_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
        }
      }
    },
    "SchemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_name", "schema_version", "content_hash"],
      "properties": {
        "schema_name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
        },
        "schema_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,99}$"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "CommandRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "idempotency_key", "command_hash"],
      "properties": {
        "command_id": {
          "$ref": "../../command-envelope/1.0.0/schema.json#/$defs/CommandId"
        },
        "idempotency_key": {
          "$ref": "../../command-envelope/1.0.0/schema.json#/$defs/IdempotencyKey"
        },
        "command_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    }
  }
}
