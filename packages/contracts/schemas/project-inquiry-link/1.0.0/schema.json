{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-inquiry-link/1.0.0/schema.json",
  "title": "PetraProjectInquiryLink",
  "description": "An immutable exact association from a ProjectDefinition-valid inquiry anchor to Work or a result. Operational completion never changes inquiry meaning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "project_inquiry_link_id",
    "project_id",
    "content",
    "content_hash",
    "created_by",
    "created_at"
  ],
  "properties": {
    "schema_name": { "const": "petra.project-inquiry-link" },
    "schema_version": { "const": "1.0.0" },
    "project_inquiry_link_id": {
      "type": "string",
      "pattern": "^project_inquiry_link_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "project_id": { "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId" },
    "content": { "$ref": "#/$defs/LinkContent" },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "created_by": { "$ref": "../../common/1.0.0/schema.json#/$defs/ActorRef" },
    "created_at": { "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp" }
  },
  "$defs": {
    "DefinitionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_definition_id", "revision", "content_hash"],
      "properties": {
        "project_definition_id": {
          "type": "string",
          "pattern": "^project_definition_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "InquiryRoleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_inquiry_role_id",
        "revision",
        "content_hash",
        "record_hash"
      ],
      "properties": {
        "project_inquiry_role_id": {
          "type": "string",
          "pattern": "^project_inquiry_role_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "ObjectiveRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective_id", "revision", "content_hash", "record_hash"],
      "properties": {
        "objective_id": {
          "type": "string",
          "pattern": "^objective_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "InquiryAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_kind", "semantic_key", "objective_ref"],
      "properties": {
        "anchor_kind": { "const": "project_objective" },
        "semantic_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._/-]{1,199}$"
        },
        "objective_ref": { "$ref": "#/$defs/ObjectiveRef" }
      }
    },
    "WorkUnitRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_unit_id", "revision", "spec_hash", "record_hash"],
      "properties": {
        "work_unit_id": {
          "$ref": "../../worker-input-manifest/1.0.0/schema.json#/$defs/WorkUnitId"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "spec_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "TypedRecordRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_name",
        "schema_version",
        "record_id",
        "revision",
        "content_hash",
        "record_hash"
      ],
      "properties": {
        "schema_name": {
          "type": "string",
          "pattern": "^petra\\.[a-z][a-z0-9.-]{1,127}$"
        },
        "schema_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "record_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "record_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "WorkTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_kind", "relationship", "work_unit_ref"],
      "properties": {
        "target_kind": { "const": "work" },
        "relationship": { "const": "addresses" },
        "work_unit_ref": { "$ref": "#/$defs/WorkUnitRef" }
      }
    },
    "ResultTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_kind", "bearing", "result_ref"],
      "properties": {
        "target_kind": { "const": "result" },
        "bearing": {
          "enum": ["addresses", "admissible_basis", "accepted_finding"]
        },
        "result_ref": { "$ref": "#/$defs/TypedRecordRef" },
        "produced_by_work_ref": { "$ref": "#/$defs/WorkUnitRef" }
      }
    },
    "LinkContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_definition_ref",
        "inquiry_role_ref",
        "inquiry_anchor",
        "target"
      ],
      "properties": {
        "project_definition_ref": { "$ref": "#/$defs/DefinitionRef" },
        "inquiry_role_ref": { "$ref": "#/$defs/InquiryRoleRef" },
        "inquiry_anchor": { "$ref": "#/$defs/InquiryAnchor" },
        "target": {
          "oneOf": [
            { "$ref": "#/$defs/WorkTarget" },
            { "$ref": "#/$defs/ResultTarget" }
          ]
        }
      }
    }
  }
}
