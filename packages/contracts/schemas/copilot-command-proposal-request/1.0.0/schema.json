{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/copilot-command-proposal-request/1.0.0/schema.json",
  "title": "PetraCopilotCommandProposalRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "proposal_id",
    "origin_run_id",
    "expected_context_hash"
  ],
  "properties": {
    "schema_name": {
      "const": "petra.copilot-command-proposal-request"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^proposal_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "origin_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "expected_context_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    }
  }
}
