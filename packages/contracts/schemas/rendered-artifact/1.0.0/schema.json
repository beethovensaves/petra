{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/rendered-artifact/1.0.0/schema.json",
  "title": "PetraRenderedArtifact",
  "description": "An immutable record of one deterministic representation derived from an exact DraftArtifact and CitationBundle without changing scientific support.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "rendered_artifact_id",
    "revision",
    "project_id",
    "draft_ref",
    "citation_bundle_ref",
    "content",
    "content_hash",
    "rendered_by",
    "rendered_at"
  ],
  "properties": {
    "schema_name": { "const": "petra.rendered-artifact" },
    "schema_version": { "const": "1.0.0" },
    "rendered_artifact_id": { "$ref": "#/$defs/RenderedArtifactId" },
    "revision": { "const": 1 },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "draft_ref": { "$ref": "#/$defs/DraftRef" },
    "citation_bundle_ref": { "$ref": "#/$defs/CitationBundleRef" },
    "content": { "$ref": "#/$defs/RenderedContent" },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "rendered_by": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ActorRef"
    },
    "rendered_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "RenderedArtifactId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        {
          "type": "string",
          "pattern": "^rendered_artifact_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      ]
    },
    "DraftRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draft_artifact_id", "revision", "content_hash"],
      "properties": {
        "draft_artifact_id": {
          "$ref": "../../draft-artifact/1.0.0/schema.json#/$defs/DraftArtifactId"
        },
        "revision": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "CitationBundleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation_bundle_id", "revision", "content_hash"],
      "properties": {
        "citation_bundle_id": {
          "$ref": "../../draft-artifact/1.0.0/schema.json#/$defs/CitationBundleId"
        },
        "revision": { "const": 1 },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "RendererRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "content_hash"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "OutputArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "revision",
        "content_hash",
        "byte_size",
        "media_type"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ArtifactId"
        },
        "revision": { "const": 1 },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "byte_size": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ByteSize"
        },
        "media_type": { "type": "string", "minLength": 3, "maxLength": 300 }
      }
    },
    "RenderOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "line_ending",
        "citation_rendering",
        "bibliography_rendering",
        "standalone_document"
      ],
      "properties": {
        "encoding": { "const": "utf-8" },
        "line_ending": { "const": "lf" },
        "citation_rendering": { "const": "linked_span_suffix" },
        "bibliography_rendering": { "const": "canonical_metadata_only" },
        "standalone_document": { "type": "boolean" }
      }
    },
    "RenderWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "Transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "behavior", "lossy", "semantic_effect"],
      "properties": {
        "kind": {
          "enum": [
            "citation_insertion",
            "syntax_escape",
            "bibliography_projection",
            "document_wrapper"
          ]
        },
        "behavior": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "lossy": { "type": "boolean" },
        "semantic_effect": { "const": "none" }
      }
    },
    "AuthorityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rendered_artifact_is_scientific_authority",
        "renderer_may_change_support"
      ],
      "properties": {
        "rendered_artifact_is_scientific_authority": { "const": false },
        "renderer_may_change_support": { "const": false }
      }
    },
    "RenderedContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "content_scope",
        "renderer",
        "options",
        "output_artifact_ref",
        "semantic_content_hash",
        "warnings",
        "transformations",
        "authority_boundary"
      ],
      "properties": {
        "format": { "enum": ["markdown", "latex", "bibtex"] },
        "content_scope": {
          "enum": ["draft_with_citations", "citations_only"]
        },
        "renderer": { "$ref": "#/$defs/RendererRef" },
        "options": { "$ref": "#/$defs/RenderOptions" },
        "output_artifact_ref": { "$ref": "#/$defs/OutputArtifactRef" },
        "semantic_content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "warnings": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/RenderWarning" }
        },
        "transformations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/Transformation" }
        },
        "authority_boundary": { "$ref": "#/$defs/AuthorityBoundary" }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "format": { "const": "markdown" } }
          },
          "then": {
            "properties": {
              "content_scope": { "const": "draft_with_citations" },
              "output_artifact_ref": {
                "type": "object",
                "properties": {
                  "media_type": { "const": "text/markdown; charset=utf-8" }
                }
              },
              "options": {
                "type": "object",
                "properties": { "standalone_document": { "const": false } }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "format": { "const": "latex" } }
          },
          "then": {
            "properties": {
              "content_scope": { "const": "draft_with_citations" },
              "output_artifact_ref": {
                "type": "object",
                "properties": {
                  "media_type": {
                    "const": "application/x-latex; charset=utf-8"
                  }
                }
              },
              "options": {
                "type": "object",
                "properties": { "standalone_document": { "const": true } }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "format": { "const": "bibtex" } }
          },
          "then": {
            "properties": {
              "content_scope": { "const": "citations_only" },
              "output_artifact_ref": {
                "type": "object",
                "properties": {
                  "media_type": {
                    "const": "application/x-bibtex; charset=utf-8"
                  }
                }
              },
              "options": {
                "type": "object",
                "properties": { "standalone_document": { "const": false } }
              }
            }
          }
        }
      ]
    }
  }
}
