{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/interaction-feature-manifest/1.0.0/schema.json",
  "title": "PetraInteractionFeatureManifest",
  "description": "An immutable declaration of the interaction protocol features Petra can translate safely. It describes compatibility and never grants a Petra capability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "interaction_feature_manifest_id",
    "revision",
    "content",
    "content_hash",
    "compiled_by",
    "compiled_at"
  ],
  "properties": {
    "schema_name": { "const": "petra.interaction-feature-manifest" },
    "schema_version": { "const": "1.0.0" },
    "interaction_feature_manifest_id": {
      "$ref": "#/$defs/InteractionFeatureManifestId"
    },
    "revision": { "const": 1 },
    "content": { "$ref": "#/$defs/FeatureContent" },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "compiled_by": { "$ref": "#/$defs/ServiceActorRef" },
    "compiled_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "InteractionFeatureManifestId": {
      "allOf": [
        { "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId" },
        {
          "type": "string",
          "pattern": "^interaction_feature_manifest_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      ]
    },
    "ServiceActorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "actor_kind"],
      "properties": {
        "actor_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ActorId"
        },
        "actor_kind": { "const": "service" }
      }
    },
    "Version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,99}$"
    },
    "FeatureContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "transports",
        "standard_events",
        "custom_events",
        "features",
        "authority_boundary"
      ],
      "properties": {
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "sdk_version", "profile_version"],
          "properties": {
            "name": { "const": "ag-ui" },
            "sdk_version": { "$ref": "#/$defs/Version" },
            "profile_version": { "$ref": "#/$defs/Version" }
          }
        },
        "transports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["text_event_stream", "binary_stream"] }
        },
        "standard_events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/StandardEventType" }
        },
        "custom_events": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/CustomEventRegistration" }
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/FeatureSupport" }
        },
        "authority_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "grants_capabilities",
            "interaction_state_is_authoritative",
            "replay_reapplies_authority",
            "connection_abort_cancels_work"
          ],
          "properties": {
            "grants_capabilities": { "const": false },
            "interaction_state_is_authoritative": { "const": false },
            "replay_reapplies_authority": { "const": false },
            "connection_abort_cancels_work": { "const": false }
          }
        }
      }
    },
    "StandardEventType": {
      "enum": [
        "RUN_STARTED",
        "RUN_FINISHED",
        "RUN_ERROR",
        "TEXT_MESSAGE_START",
        "TEXT_MESSAGE_CONTENT",
        "TEXT_MESSAGE_END",
        "TOOL_CALL_START",
        "TOOL_CALL_ARGS",
        "TOOL_CALL_END",
        "STATE_SNAPSHOT",
        "STATE_DELTA",
        "ACTIVITY_SNAPSHOT",
        "ACTIVITY_DELTA",
        "CUSTOM"
      ]
    },
    "CustomEventRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_name",
        "payload_schema_ref",
        "stability",
        "authority_effect"
      ],
      "properties": {
        "event_name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^petra\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
        },
        "payload_schema_ref": { "$ref": "#/$defs/SchemaRef" },
        "stability": { "enum": ["stable", "experimental"] },
        "authority_effect": { "const": "none" }
      }
    },
    "SchemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_name", "schema_version", "content_hash"],
      "properties": {
        "schema_name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
        },
        "schema_version": { "$ref": "#/$defs/Version" },
        "content_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        },
        "json_pointer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^#(?:/[^/~]*(?:~[01][^/~]*)*)*$"
        }
      }
    },
    "FeatureSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature", "support"],
      "properties": {
        "feature": {
          "enum": [
            "text_streaming",
            "activity",
            "tool_proposals",
            "state_projection",
            "interrupts",
            "resumption",
            "replay",
            "explicit_work_cancellation"
          ]
        },
        "support": { "enum": ["supported", "deferred", "unsupported"] },
        "limitation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    }
  }
}
