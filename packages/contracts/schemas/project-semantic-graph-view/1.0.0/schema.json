{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-semantic-graph-view/1.0.0/schema.json",
  "title": "PetraProjectSemanticGraphView",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "project_id",
    "content",
    "content_hash",
    "read_at"
  ],
  "properties": {
    "schema_name": {
      "const": "petra.project-semantic-graph-view"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^project_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_label",
        "definition_family",
        "definition_ref",
        "authority",
        "query",
        "nodes",
        "relationships",
        "omitted_candidates",
        "omitted_relationships",
        "limitations"
      ],
      "properties": {
        "project_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "definition_family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "definition_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_id",
            "revision",
            "content_hash"
          ],
          "properties": {
            "record_id": {
              "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
            },
            "revision": {
              "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
            },
            "content_hash": {
              "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
            }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_position",
            "stream_revision"
          ],
          "properties": {
            "event_position": {
              "type": "integer",
              "minimum": 0
            },
            "stream_revision": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "query": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "max_candidates",
            "max_relationships",
            "authority_effect"
          ],
          "properties": {
            "kind": {
              "const": "current_registered_working_heads"
            },
            "max_candidates": {
              "const": 50
            },
            "max_relationships": {
              "const": 100
            },
            "authority_effect": {
              "const": "none"
            }
          }
        },
        "nodes": {
          "type": "array",
          "maxItems": 250,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "semantic_key",
              "label",
              "summary",
              "layer",
              "record_ref",
              "material_state"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "semantic_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "layer": {
                "type": "string",
                "enum": [
                  "working",
                  "reference"
                ]
              },
              "record_ref": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "record_id",
                  "revision",
                  "record_hash",
                  "schema_name",
                  "schema_version"
                ],
                "properties": {
                  "record_id": {
                    "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
                  },
                  "revision": {
                    "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
                  },
                  "record_hash": {
                    "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
                  },
                  "schema_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "schema_version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30
                  }
                }
              },
              "candidate_ref": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "record_id",
                  "revision",
                  "record_hash",
                  "schema_name",
                  "schema_version"
                ],
                "properties": {
                  "record_id": {
                    "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
                  },
                  "revision": {
                    "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
                  },
                  "record_hash": {
                    "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
                  },
                  "schema_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "schema_version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30
                  }
                }
              },
              "native_record": {
                "type": "object",
                "additionalProperties": true
              },
              "material_state": {
                "type": "string",
                "enum": [
                  "available",
                  "metadata_only",
                  "definition_stale"
                ]
              },
              "remote_context": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "permitted",
                  "reason",
                  "rights_refs"
                ],
                "properties": {
                  "permitted": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "rights_refs": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "record_id",
                        "revision",
                        "record_hash",
                        "schema_name",
                        "schema_version"
                      ],
                      "properties": {
                        "record_id": {
                          "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
                        },
                        "revision": {
                          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
                        },
                        "record_hash": {
                          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
                        },
                        "schema_name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "schema_version": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 30
                        }
                      }
                    }
                  }
                }
              },
              "source_passages": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "span",
                    "project_source_ref",
                    "rights_ref",
                    "remote_permitted"
                  ],
                  "properties": {
                    "span": {
                      "$ref": "../../source-span/1.0.0/schema.json"
                    },
                    "project_source_ref": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "record_id",
                        "revision",
                        "record_hash",
                        "schema_name",
                        "schema_version"
                      ],
                      "properties": {
                        "record_id": {
                          "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
                        },
                        "revision": {
                          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
                        },
                        "record_hash": {
                          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
                        },
                        "schema_name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "schema_version": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 30
                        }
                      }
                    },
                    "rights_ref": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "record_id",
                        "revision",
                        "record_hash",
                        "schema_name",
                        "schema_version"
                      ],
                      "properties": {
                        "record_id": {
                          "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
                        },
                        "revision": {
                          "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
                        },
                        "record_hash": {
                          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
                        },
                        "schema_name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "schema_version": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 30
                        }
                      }
                    },
                    "remote_permitted": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "relationships": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "semantic_key",
              "predicate",
              "subject_key",
              "object_key",
              "record_ref"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "semantic_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "predicate": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "subject_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "object_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "record_ref": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "record_id",
                  "revision",
                  "record_hash",
                  "schema_name",
                  "schema_version"
                ],
                "properties": {
                  "record_id": {
                    "$ref": "../../common/1.0.0/schema.json#/$defs/PetraId"
                  },
                  "revision": {
                    "$ref": "../../common/1.0.0/schema.json#/$defs/Revision"
                  },
                  "record_hash": {
                    "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
                  },
                  "schema_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "schema_version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30
                  }
                }
              }
            }
          }
        },
        "omitted_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "omitted_relationships": {
          "type": "integer",
          "minimum": 0
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "objective_ref": {
          "oneOf": [
            {
              "$ref": "../../hypothesis/1.0.0/schema.json#/properties/content/properties/target_claim_ref"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    },
    "read_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    }
  }
}
