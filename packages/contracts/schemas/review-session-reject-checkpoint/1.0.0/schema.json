{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/review-session-reject-checkpoint/1.0.0/schema.json",
  "title": "PetraReviewSessionRejectCheckpoint",
  "description": "A read-only exact human rejection preview. Rejection records a rejected Approval for the complete proposed ChangeSet; it does not apply the candidate or mutate its source records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "binding",
    "displayed_commitment_hash"
  ],
  "properties": {
    "schema_name": { "const": "petra.review-session-reject-checkpoint" },
    "schema_version": { "const": "1.0.0" },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "review_session",
        "selected_review_member",
        "atomic_member_ids",
        "change_set",
        "prepared_at",
        "authorization_basis",
        "capability_grants",
        "scope",
        "consequences"
      ],
      "properties": {
        "project_id": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
        },
        "review_session": {
          "$ref": "../../review-session/1.1.0/schema.json"
        },
        "selected_review_member": {
          "$ref": "../../review-session-apply-checkpoint/1.0.0/schema.json#/properties/binding/properties/members/items"
        },
        "atomic_member_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^review_member_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true
        },
        "change_set": {
          "$ref": "../../change-set/1.0.0/schema.json"
        },
        "prepared_at": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
        },
        "authorization_basis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "decision", "actor"],
          "properties": {
            "kind": { "const": "authenticated_human_checkpoint" },
            "decision": { "const": "reject" },
            "actor": {
              "type": "object",
              "additionalProperties": false,
              "required": ["actor_id", "actor_kind"],
              "properties": {
                "actor_id": {
                  "$ref": "../../common/1.0.0/schema.json#/$defs/ActorId"
                },
                "actor_kind": { "const": "human" }
              }
            }
          }
        },
        "capability_grants": {
          "type": "object",
          "additionalProperties": false,
          "required": ["SubmitChangeSet", "RecordApproval"],
          "properties": {
            "SubmitChangeSet": {
              "$ref": "../../command-envelope/1.0.0/schema.json#/$defs/CapabilityGrantId"
            },
            "RecordApproval": {
              "$ref": "../../command-envelope/1.0.0/schema.json#/$defs/CapabilityGrantId"
            }
          }
        },
        "scope": { "const": "one_complete_change_set" },
        "consequences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "displayed_commitment_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    }
  }
}
