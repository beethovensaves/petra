{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petra.local/schemas/project-objective-command-recovery-view/1.0.0/schema.json",
  "title": "PetraProjectObjectiveCommandRecoveryView",
  "description": "A read-only reconciliation of one exact reviewed Objective command, including its exact Brief return when confirmed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "assessment_id",
    "project_id",
    "subject",
    "effect",
    "return",
    "observed_at",
    "content_hash"
  ],
  "properties": {
    "schema_name": {
      "const": "petra.project-objective-command-recovery-view"
    },
    "schema_version": { "const": "1.0.0" },
    "assessment_id": {
      "type": "string",
      "pattern": "^project_objective_recovery_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "project_id": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
    },
    "subject": { "$ref": "#/$defs/Subject" },
    "effect": { "$ref": "#/$defs/Effect" },
    "return": { "$ref": "#/$defs/Return" },
    "observed_at": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/Timestamp"
    },
    "content_hash": {
      "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
    }
  },
  "$defs": {
    "Subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "idempotency_key", "request_hash"],
      "properties": {
        "command_id": {
          "$ref": "../../project-objective-command-request/1.0.0/schema.json#/properties/command_id"
        },
        "idempotency_key": {
          "$ref": "../../project-objective-command-request/1.0.0/schema.json#/properties/idempotency_key"
        },
        "request_hash": {
          "$ref": "../../common/1.0.0/schema.json#/$defs/ContentHash"
        }
      }
    },
    "Effect": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "receipt"],
          "properties": {
            "state": { "const": "effect_confirmed" },
            "receipt": {
              "$ref": "../../project-objective-command-receipt/1.0.0/schema.json"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reason", "retry"],
          "properties": {
            "state": { "const": "outcome_unknown" },
            "reason": { "const": "receipt_not_observed_at_cutoff" },
            "retry": {
              "type": "object",
              "additionalProperties": false,
              "required": ["method", "path", "reuse_exact_request"],
              "properties": {
                "method": { "const": "POST" },
                "path": {
                  "type": "string",
                  "pattern": "^/api/commands/projects/[^/]+/objective$"
                },
                "reuse_exact_request": { "const": true }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reason"],
          "properties": {
            "state": { "const": "unavailable_to_verify" },
            "reason": {
              "enum": [
                "command_identity_conflict",
                "command_not_owned_by_authenticated_actor"
              ]
            }
          }
        }
      ]
    },
    "Return": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "destination"],
          "properties": {
            "state": { "const": "exact" },
            "destination": {
              "$ref": "../../project-objective-command-receipt/1.0.0/schema.json#/$defs/BriefDestination"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "destination", "reason"],
          "properties": {
            "state": { "const": "safe_fallback" },
            "destination": {
              "type": "object",
              "additionalProperties": false,
              "required": ["place_role", "project_id"],
              "properties": {
                "place_role": { "const": "brief" },
                "project_id": {
                  "$ref": "../../common/1.0.0/schema.json#/$defs/ProjectId"
                }
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        }
      ]
    }
  }
}
