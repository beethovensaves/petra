{
  "name": "@petra/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.59",
    "@hono/node-server": "2.1.1",
    "@petra/adapters": "0.0.0",
    "@petra/core": "0.0.0",
    "@petra/postgres": "0.0.0",
    "@petra/s3": "0.0.0",
    "@aws-sdk/client-s3": "3.1124.0",
    "hono": "4.13.5",
    "json-canonicalize": "3.0.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@petra/contracts": "0.0.0",
    "@types/pg": "8.15.5"
  }
}
