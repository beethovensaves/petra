{
  "name": "petra",
  "version": "0.0.0",
  "private": true,
  "description": "Where hypotheses earn their edges.",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "npm ci && UV_CACHE_DIR=.cache/uv uv sync --project workers/science",
    "benchmark:retrieval:m1-floor": "npm run build:packages && node experiments/retrieval/run-m1-floor.mjs",
    "benchmark:retrieval:m1-floor:check": "npm run build:packages && node experiments/retrieval/run-m1-floor.mjs --check",
    "build": "npm run build:server && npm run build:workbench",
    "build:packages": "tsc -b",
    "build:server": "npm run build:packages",
    "build:workbench": "npm run build --workspace @petra/workbench",
    "check:prerequisites": "node scripts/check-prerequisites.mjs",
    "contracts:check-generated": "npm run generate:check --workspace @petra/contracts",
    "contracts:generate": "npm run generate --workspace @petra/contracts",
    "db:info": "docker compose --env-file .env -f infra/dev/compose.yaml --profile tools run --rm migrations info",
    "db:migrate": "docker compose --env-file .env -f infra/dev/compose.yaml --profile tools run --rm migrations migrate",
    "db:validate": "docker compose --env-file .env -f infra/dev/compose.yaml --profile tools run --rm migrations validate",
    "disc04:compare": "node experiments/disc-04/run.mjs",
    "disc04:integration": "node experiments/disc-04/run-integration.mjs",
    "dev": "npm run build:server && concurrently --kill-others --names server,workbench \"npm run dev --workspace @petra/server\" \"npm run dev --workspace @petra/workbench\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures:check-generated": "node scripts/build-full-text-fixture-records.mjs --check",
    "fixtures:generate": "node scripts/build-full-text-fixture-records.mjs",
    "lint": "eslint . && UV_CACHE_DIR=.cache/uv uv run --project workers/science ruff check workers/science && UV_CACHE_DIR=.cache/uv uv run --project workers/science ruff format --check workers/science",
    "measure:m1-boundary": "npm run build && node experiments/m1-boundary/measure.mjs",
    "models:docling": "node scripts/prepare-docling-models.mjs",
    "models:docling:check": "node scripts/prepare-docling-models.mjs --check",
    "models:certify:local": "npm run build:packages && node experiments/model-certification/run-local.mjs",
    "typecheck": "tsc -b && tsc --noEmit --project packages/contracts/test/tsconfig.json && tsc --noEmit --project packages/core/test/tsconfig.json && tsc --noEmit --project packages/adapters/test/tsconfig.json && tsc --noEmit --project packages/neo4j/test/tsconfig.json && tsc --noEmit --project packages/postgres/test/tsconfig.json && tsc --noEmit --project packages/retrieval/test/tsconfig.json && tsc --noEmit --project packages/s3/test/tsconfig.json && tsc --noEmit --project apps/server/test/tsconfig.json && tsc --noEmit --project experiments/m1-boundary/tsconfig.json && npm run typecheck --workspace @petra/workbench && UV_CACHE_DIR=.cache/uv uv run --project workers/science mypy workers/science/src workers/science/tests",
    "test": "npm run test:contracts && npm run test:core && npm run test:adapters && npm run test:retrieval && npm run test:neo4j && npm run test:s3 && npm run test:server && npm run test:workbench && npm run test:python && npm run test:wave-handoff && npm run audit:ui-operations",
    "test:adapters": "npm test --workspace @petra/adapters",
    "test:contracts": "npm test --workspace @petra/contracts",
    "test:core": "npm test --workspace @petra/core",
    "test:neo4j": "npm test --workspace @petra/neo4j",
    "test:neo4j:integration": "node scripts/test-neo4j-integration.mjs",
    "test:postgres": "npm test --workspace @petra/postgres",
    "test:postgres:integration": "node scripts/test-postgres-integration.mjs",
    "test:retrieval": "npm test --workspace @petra/retrieval",
    "test:s3": "npm test --workspace @petra/s3",
    "test:s3:integration": "node scripts/test-s3-integration.mjs",
    "test:wave-handoff": "node --test scripts/wave-handoff.test.mjs",
    "test:integration": "node experiments/disc-04/run-integration.mjs",
    "test:m1:backend": "node scripts/test-m1-backend-gates.mjs",
    "test:m1:backend:list": "node scripts/test-m1-backend-gates.mjs --list",
    "test:m1:cumulative": "node scripts/test-m1-cumulative-integration.mjs",
    "test:m1:interface-recovery": "node scripts/test-m1-interface-recovery.mjs",
    "test:m1:recovery": "node scripts/test-m1-recovery-integration.mjs",
    "test:wave3:cumulative": "npm run build:packages && node scripts/test-wave3-cumulative-integration.mjs",
    "test:wave4:cumulative": "npm run build:packages && node scripts/test-wave4-cumulative-integration.mjs",
    "test:wave4:model-identity": "npm run build:packages && PETRA_WAVE4_TRACE=conversation-model-identity node scripts/test-wave4-cumulative-integration.mjs",
    "test:docling:integration": "node scripts/test-docling-integration.mjs",
    "test:codex-app-server:integration": "npm run build:packages && node scripts/test-codex-app-server-integration.mjs",
    "test:codex-synthesist:certification": "npm run build:packages && node experiments/model-certification/run-codex-synthesist.mjs",
    "test:codex-synthesist:integration": "npm run build:packages && node scripts/test-codex-synthesist-integration.mjs",
    "test:codex-grounded-ag-ui:integration": "npm run build:packages && node --env-file-if-exists=.env scripts/test-codex-grounded-ag-ui-integration.mjs",
    "test:codex-extractor:integration": "npm run build:packages && node experiments/model-certification/run-codex.mjs",
    "test:evidence-proposals:integration": "node scripts/test-evidence-proposal-integration.mjs",
    "test:python": "UV_CACHE_DIR=.cache/uv uv run --project workers/science pytest workers/science/tests",
    "test:server": "npm test --workspace @petra/server",
    "test:workbench": "npm test --workspace @petra/workbench",
    "start": "npm run start --workspace @petra/server",
    "wave:backend": "node scripts/wave-handoff.mjs worker --role backend",
    "wave:design": "node scripts/wave-handoff.mjs worker --role design",
    "wave:doctor": "node scripts/wave-handoff.mjs doctor",
    "wave:status": "node scripts/wave-handoff.mjs status",
    "wave:stop": "node scripts/wave-handoff.mjs stop",
    "wave:resume": "node scripts/wave-handoff.mjs resume",
    "verify": "npm run contracts:check-generated && npm run fixtures:check-generated && npm run benchmark:retrieval:m1-floor:check && npm run format:check && npm run lint && npm run typecheck && npm run build:workbench && npm test",
    "services:config": "docker compose --env-file .env -f infra/dev/compose.yaml config --quiet",
    "services:up": "docker compose --env-file .env -f infra/dev/compose.yaml up --detach --wait",
    "services:health": "docker compose --env-file .env -f infra/dev/compose.yaml ps",
    "services:logs": "docker compose --env-file .env -f infra/dev/compose.yaml logs --tail=200",
    "services:down": "docker compose --env-file .env -f infra/dev/compose.yaml down --remove-orphans",
    "services:reset": "docker compose --env-file .env -f infra/dev/compose.yaml down --volumes --remove-orphans",
    "test:wave4:browser": "npm run build:packages && node apps/workbench/test/cumulative-production-browser.mjs",
    "test:wave4:item50": "npm run test:wave4:browser",
    "test:wave4:item54": "PETRA_WAVE4_EVIDENCE_OBSERVER=./apps/workbench/test/item54-evidence-observer.mjs npm run test:wave4:evidence-support",
    "test:wave4:evidence-support": "npm run build:packages && PETRA_WAVE4_TRACE=evidence-remediation-support node scripts/test-wave4-cumulative-integration.mjs",
    "test:wave5:adverse-support": "node --import tsx scripts/test-wave5-adverse-support.mjs",
    "test:wave5:adverse-browser": "npm run build:packages && node apps/workbench/test/wave5-adverse-browser.mjs",
    "test:wave5:browser": "npm run build:packages && node apps/workbench/test/wave5-cumulative-browser.mjs",
    "test:wave5:cumulative": "npm run build:packages && node scripts/test-wave5-cumulative-integration.mjs",
    "test:wave6:actual-model-ui": "npm run build:packages && PETRA_WAVE4_TRACE=wave6-actual-model-ui PETRA_WAVE4_EVIDENCE_OBSERVER=./scripts/wave6-actual-model-ui-observer.mjs PETRA_WAVE4_RESULT_OUTPUT=reports/WAVE6-ACTUAL-MODEL-UI-TRACE.json PETRA_WAVE6_ACTUAL_MODEL_BROWSER_OUTPUT=reports/WAVE6-ACTUAL-MODEL-BROWSER-OBSERVATION.json node scripts/test-wave4-cumulative-integration.mjs",
    "test:wave6:graph-ui": "npm run build:packages && PETRA_WAVE4_TRACE=wave5-cumulative PETRA_WAVE4_EVIDENCE_OBSERVER=./apps/workbench/test/wave6-graph-expansion-observer.mjs PETRA_WAVE4_RESULT_OUTPUT=/tmp/petra-wave6-graph-expansion-backend.json PETRA_WAVE6_GRAPH_EXPANSION_OUTPUT=reports/WAVE6-GRAPH-EXPANSION-BROWSER.json node scripts/test-wave4-cumulative-integration.mjs",
    "test:wave6:project-resume-ui": "npm run build:packages && node --import tsx apps/workbench/test/project-resume-browser.mjs",
    "test:wave6:project-import-ui": "npm run build:packages && node --import tsx apps/workbench/test/project-import-browser.mjs",
    "test:wave6:objective-ui": "npm run build:packages && node apps/workbench/test/run-project-brief-browser.mjs",
    "test:wave6:source-reuse-ui": "npm run build:packages && node apps/workbench/test/run-source-reuse-browser.mjs",
    "test:wave6:source-processing-ui": "npm run build:packages && node apps/workbench/test/run-source-processing-browser.mjs",
    "test:wave6:source-revision-ui": "npm run build:packages && node apps/workbench/test/run-source-revision-browser.mjs",
    "test:wave6:source-link-removal-ui": "npm run build:packages && node apps/workbench/test/run-source-link-removal-browser.mjs",
    "test:wave6:source-local-copy-deletion-ui": "npm run build:packages && node apps/workbench/test/run-source-local-copy-deletion-browser.mjs",
    "test:wave6:work": "PETRA_WAVE6_WORK_EVIDENCE_OUTPUT=reports/WAVE6-WORK-PRODUCTION-COMMANDS.json node scripts/test-postgres-integration.mjs",
    "test:wave6:work-ui": "npm run build:packages && PETRA_WAVE4_TRACE=wave5-cumulative PETRA_WAVE4_EVIDENCE_OBSERVER=./apps/workbench/test/wave6-work-browser-observer.mjs PETRA_WAVE4_RESULT_OUTPUT=reports/WAVE6-WORK-CUMULATIVE-TRACE.json PETRA_WAVE6_WORK_BROWSER_OUTPUT=reports/WAVE6-WORK-BROWSER-OBSERVATION.json node scripts/test-wave4-cumulative-integration.mjs",
    "inspect:wave5": "npm run build:packages && PETRA_WAVE4_TRACE=wave5-cumulative PETRA_WAVE4_EVIDENCE_OBSERVER=./apps/workbench/test/wave5-cumulative-evidence-observer.mjs PETRA_WAVE5_BROWSER_OBSERVER_OUTPUT=/tmp/petra-wave5-inspection.json PETRA_WAVE5_INSPECT=1 node scripts/test-wave4-cumulative-integration.mjs",
    "inspect:wave6": "npm run build:packages && PETRA_WAVE4_TRACE=wave5-cumulative PETRA_WAVE4_EVIDENCE_OBSERVER=./apps/workbench/test/wave6-checkpoint-observer.mjs PETRA_WAVE5_INSPECT=1 node scripts/test-wave4-cumulative-integration.mjs",
    "audit:wave6:operation-control": "node scripts/audit-wave6-operation-control.mjs",
    "audit:wave5:evidence": "node scripts/audit-wave5-evidence.mjs",
    "audit:ui-operations": "node scripts/audit-ui-operation-coverage.mjs",
    "gate:wave6:user-testable": "node scripts/audit-ui-operation-coverage.mjs --require-wave 6",
    "gate:wave7:composition": "node scripts/audit-ui-operation-coverage.mjs --require-wave 7",
    "gate:wave8:application": "node scripts/audit-ui-operation-coverage.mjs --require-wave 8",
    "wave:accept": "node scripts/wave-handoff.mjs accept"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1124.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "concurrently": "10.0.5",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "json-canonicalize": "3.0.0",
    "neo4j-driver": "6.2.0",
    "json-schema-to-typescript": "16.0.0",
    "node-pg-migrate": "9.0.0",
    "pg": "8.16.3",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "tsx": "4.23.12",
    "vitest": "4.1.11"
  }
}
